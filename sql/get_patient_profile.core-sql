-- Private implementation
CREATE OR REPLACE FUNCTION private.get_patient_profile(
  p_caller_auth_uid uuid,
  p_patient_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_patient record;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_is_doctor boolean := false;
  v_meds jsonb;
  v_allergies jsonb;
  v_chronic jsonb;
  v_pets jsonb;
  v_visit_count bigint;
  v_last_visit_date timestamptz;
  v_last_visit_summary text;
BEGIN
  -- Get patient
  SELECT p.id, p.org_id, p.first_name, p.last_name, p.birthday, p.sex, p.phone
  INTO v_patient
  FROM public.patients p
  WHERE p.id = p_patient_id;

  IF v_patient IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Patient not found');
  END IF;

  -- Get caller staff id
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.org_id = v_patient.org_id
    AND su.is_active = true
    AND su.is_deleted = false;

  -- Authorization: owner or doctor at org
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_patient.org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL;
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'doctor'
        AND sr.location_id IN (
          SELECT v.location_id FROM public.visits v
          WHERE v.patient_id = p_patient_id
        )
    ) INTO v_is_doctor;

    IF NOT v_is_doctor THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Medications
  SELECT COALESCE(jsonb_agg(jsonb_build_object(
    'name', pm.name
  )), '[]'::jsonb)
  INTO v_meds
  FROM public.patient_medications pm
  WHERE pm.patient_id = p_patient_id AND pm.active = true;

  -- Allergies
  SELECT COALESCE(jsonb_agg(jsonb_build_object(
    'name', pa.name
  )), '[]'::jsonb)
  INTO v_allergies
  FROM public.patient_allergies pa
  WHERE pa.patient_id = p_patient_id AND pa.active = true;

  -- Chronic conditions
  SELECT COALESCE(jsonb_agg(jsonb_build_object(
    'name', pc.name
  )), '[]'::jsonb)
  INTO v_chronic
  FROM public.patient_chronic_conditions pc
  WHERE pc.patient_id = p_patient_id AND pc.active = true;

  -- Pets
  SELECT COALESCE(jsonb_agg(jsonb_build_object(
    'name', pp.name
  )), '[]'::jsonb)
  INTO v_pets
  FROM public.patient_pets pp
  WHERE pp.patient_id = p_patient_id AND pp.active = true;

  -- Visit stats
  SELECT count(*), max(completed_at)
  INTO v_visit_count, v_last_visit_date
  FROM public.visits
  WHERE patient_id = p_patient_id AND status = 'completed';

  -- Last visit summary
  SELECT left(ai_summary, 200)
  INTO v_last_visit_summary
  FROM public.visits
  WHERE patient_id = p_patient_id AND status = 'completed'
  ORDER BY completed_at DESC
  LIMIT 1;

  RETURN jsonb_build_object(
    'success', true,
    'patient', jsonb_build_object(
      'id', v_patient.id,
      'first_name', v_patient.first_name,
      'last_name', v_patient.last_name,
      'birthday', v_patient.birthday,
      'sex', v_patient.sex,
      'phone_masked', CASE WHEN v_patient.phone IS NOT NULL THEN '***-***-' || right(v_patient.phone, 4) ELSE NULL END,
      'medications', v_meds,
      'allergies', v_allergies,
      'chronic_conditions', v_chronic,
      'pets', v_pets,
      'visit_count', v_visit_count,
      'last_visit_date', v_last_visit_date,
      'last_visit_summary', v_last_visit_summary
    )
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_patient_profile(
  p_patient_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.get_patient_profile(v_auth_uid, p_patient_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.get_patient_profile(uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.get_patient_profile(uuid) TO authenticated;
