-- Private implementation
CREATE OR REPLACE FUNCTION private.get_queue(
  p_caller_auth_uid uuid,
  p_location_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_is_doctor boolean := false;
  v_result jsonb;
BEGIN
  -- Get location org
  SELECT l.org_id INTO v_org_id
  FROM public.locations l
  WHERE l.id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Get caller staff id
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.org_id = v_org_id
    AND su.is_active = true
    AND su.is_deleted = false;

  -- Authorization: owner or doctor at location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can view
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'doctor'
        AND sr.location_id = p_location_id
    ) INTO v_is_doctor;

    IF NOT v_is_doctor THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Get queue
  SELECT COALESCE(jsonb_agg(row_to_json(q) ORDER BY q.priority DESC, q.created_at ASC), '[]'::jsonb)
  INTO v_result
  FROM (
    SELECT
      v.id AS visit_id,
      p.first_name,
      p.last_name,
      v.priority,
      COALESCE(extract(epoch FROM now() - v.entered_queue_at)::int, 0) AS wait_seconds,
      v.is_sensitive,
      v.timeout_flagged,
      v.has_previous_visits,
      v.entered_queue_at AS created_at
    FROM public.visits v
    JOIN public.patients p ON p.id = v.patient_id
    WHERE v.location_id = p_location_id
      AND v.status = 'waiting_doctor_claim'
  ) q;

  RETURN jsonb_build_object('success', true, 'queue', v_result);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_queue(
  p_location_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.get_queue(v_auth_uid, p_location_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.get_queue(uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.get_queue(uuid) TO authenticated;
