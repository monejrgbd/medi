-- Private implementation
CREATE OR REPLACE FUNCTION private.move_to_queue_on_error(
  p_visit_id uuid,
  p_session_token uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_new_status text;
  v_new_entered_queue_at timestamptz;
  v_edge_url text;
  v_edge_secret text;
  v_anon_key text;
BEGIN
  -- Verify session token
  SELECT id, status, session_token, org_id, checkin_mode, entered_queue_at
  INTO v_visit
  FROM public.visits
  WHERE id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  IF v_visit.session_token <> p_session_token THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid session');
  END IF;

  IF v_visit.status <> 'still_answering_ai' THEN
    -- Already moved past AI state (completed, left, queued by another path).
    -- Caller's intent (get this visit out of AI state) is already satisfied.
    RETURN jsonb_build_object('success', true, 'already_moved', true);
  END IF;

  -- Route timeout target based on check-in mode:
  --   approve_to_start -> queue directly (current behavior)
  --   approve_on_arrival / self_service_on_arrival -> arrival gate so patient
  --     still has to confirm physical arrival before being seen
  IF v_visit.checkin_mode = 'approve_to_start' THEN
    v_new_status := 'waiting_doctor_claim';
    v_new_entered_queue_at := now();
  ELSE
    v_new_status := 'awaiting_arrival';
    v_new_entered_queue_at := v_visit.entered_queue_at;
  END IF;

  -- CRITICAL: flip status first. Everything below is best-effort and must not
  -- be allowed to abort the transaction (vault access, pg_net, audit inserts).
  UPDATE public.visits
  SET status = v_new_status,
      timeout_flagged = true,
      entered_queue_at = v_new_entered_queue_at,
      updated_at = now()
  WHERE id = p_visit_id;

  -- Best-effort audit trail.
  BEGIN
    INSERT INTO public.audit_trail (org_id, actor_id, actor_type, action, details)
    VALUES (v_visit.org_id, NULL, 'system', 'ai_error',
      jsonb_build_object('visit_id', p_visit_id, 'target_status', v_new_status));
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;

  -- Best-effort realtime broadcast. Vault or pg_net failures would otherwise
  -- surface to the caller as HTTP 400 and mask the successful UPDATE above.
  BEGIN
    SELECT decrypted_secret INTO v_edge_url FROM vault.decrypted_secrets WHERE name = 'edge_function_url';
    SELECT decrypted_secret INTO v_edge_secret FROM vault.decrypted_secrets WHERE name = 'internal_edge_secret';
    SELECT decrypted_secret INTO v_anon_key FROM vault.decrypted_secrets WHERE name = 'supabase_anon_key';

    IF v_edge_url IS NOT NULL AND v_edge_secret IS NOT NULL AND v_anon_key IS NOT NULL THEN
      PERFORM net.http_post(
        url := v_edge_url || '/broadcast-visit-update',
        headers := jsonb_build_object(
          'Content-Type', 'application/json',
          'Authorization', 'Bearer ' || v_anon_key,
          'x-internal-secret', v_edge_secret
        ),
        body := jsonb_build_object(
          'visit_id', p_visit_id,
          'session_token', p_session_token,
          'old_status', 'still_answering_ai',
          'new_status', v_new_status,
          'timeout_flagged', true
        )
      );
    END IF;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper (anon-callable, session token auth)
CREATE OR REPLACE FUNCTION public.move_to_queue_on_error(
  p_visit_id uuid,
  p_session_token uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  RETURN private.move_to_queue_on_error(p_visit_id, p_session_token);
END;
$$;
