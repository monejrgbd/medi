-- Private implementation
CREATE OR REPLACE FUNCTION private.get_location_detail(
  p_caller_auth_uid uuid,
  p_location_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_caller_org_id uuid;
  v_is_owner boolean;
  v_has_role boolean;
  v_result jsonb;
BEGIN
  -- Get location's org
  SELECT org_id INTO v_org_id
  FROM public.locations
  WHERE id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Check if caller is owner of this org
  SELECT EXISTS(
    SELECT 1 FROM public.organizations
    WHERE id = v_org_id AND owner_id = p_caller_auth_uid
  ) INTO v_is_owner;

  IF NOT v_is_owner THEN
    -- Check if caller has a role at this location
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      JOIN public.staff_users su ON su.id = sr.staff_user_id
      WHERE su.auth_uid = p_caller_auth_uid
        AND su.org_id = v_org_id
        AND sr.location_id = p_location_id
        AND su.is_active = true
        AND su.is_deleted = false
    ) INTO v_has_role;

    IF NOT v_has_role THEN
      RETURN jsonb_build_object('success', false, 'error', 'Access denied');
    END IF;
  END IF;

  SELECT jsonb_build_object(
    'success', true,
    'location', jsonb_build_object(
      'id', l.id,
      'org_id', l.org_id,
      'name', l.name,
      'address', l.address,
      'operating_hours', l.operating_hours,
      'specialty', l.specialty,
      'logo_url', l.logo_url,
      'qr_code_url', l.qr_code_url,
      'ai_model', l.ai_model,
      'display_format', l.display_format,
      'referral_email', l.referral_email,
      'tablet_count', l.tablet_count,
      'timezone', l.timezone,
      'nurse_enabled', l.nurse_enabled,
      'vitals_enabled', l.vitals_enabled,
      'vaccines_enabled', l.vaccines_enabled,
      'skip_ai', l.skip_ai,
      'ai_custom_instructions', l.ai_custom_instructions,
      'ai_message_limit', l.ai_message_limit,
      'review_sms_enabled', l.review_sms_enabled,
      'diagnostic_enabled', l.diagnostic_enabled,
      'queue_type', l.queue_type,
      'raven_api_key', l.raven_api_key,
      'ask_referral_source', l.ask_referral_source,
      'ask_discovery_source', l.ask_discovery_source,
      'queue_display_enabled', l.queue_display_enabled,
      'checkin_mode', l.checkin_mode,
      'show_doctor_room_to_patients', l.show_doctor_room_to_patients,
      'preset_rooms', l.preset_rooms,
      'tv_display_mode', l.tv_display_mode,
      'tv_overlay_position', l.tv_overlay_position,
      'tv_overlay_visible', l.tv_overlay_visible,
      'tv_queue_duration_seconds', l.tv_queue_duration_seconds,
      'tv_audio_muted', l.tv_audio_muted,
      'created_at', l.created_at,
      'prescreening_config', l.prescreening_config
    )
  )
  INTO v_result
  FROM public.locations l
  WHERE l.id = p_location_id;

  RETURN COALESCE(v_result, jsonb_build_object('success', false, 'error', 'Location not found'));
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_location_detail(p_location_id uuid)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.get_location_detail(v_auth_uid, p_location_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.get_location_detail(uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.get_location_detail(uuid) TO authenticated;
