-- Service-role-only helper so edge functions can read Vault secrets via RPC.
-- Used by the Vertex AI adapter to fetch the service account JSON.
-- NOT exposed to anon/authenticated.
CREATE OR REPLACE FUNCTION private.get_vault_secret(p_name text)
RETURNS text
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_secret text;
BEGIN
  SELECT decrypted_secret INTO v_secret
  FROM vault.decrypted_secrets
  WHERE name = p_name;

  RETURN v_secret;
END;
$$;

-- Public wrapper: service-role only (called by edge functions)
CREATE OR REPLACE FUNCTION public.private_get_vault_secret(p_name text)
RETURNS text
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  IF auth.role() <> 'service_role' THEN
    RETURN NULL;
  END IF;
  RETURN private.get_vault_secret(p_name);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.private_get_vault_secret(text) FROM anon;
REVOKE EXECUTE ON FUNCTION public.private_get_vault_secret(text) FROM authenticated;
