-- save_scribe_turns: persist a doctor's correction to the AI scribe transcript.
-- The transcript is stored as structured turns on clinical_documents.scribe_turns;
-- the flat clinical_documents.scribe_transcript (SOAP input + display fallback)
-- is re-derived from the turns by the caller and passed in. Both are written
-- together. Mutations to clinical_documents go only through SECURITY DEFINER,
-- mirroring the rest of the scribe pipeline.

-- Private implementation
CREATE OR REPLACE FUNCTION private.save_scribe_turns(
  p_caller_auth_uid uuid,
  p_document_id uuid,
  p_turns jsonb,
  p_transcript text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_caller_staff_id uuid;
  v_caller_org_id uuid;
  v_owner_id uuid;
  v_doc record;
  v_has_role boolean := false;
BEGIN
  IF jsonb_typeof(p_turns) <> 'array' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid turns');
  END IF;

  SELECT su.id, su.org_id
  INTO v_caller_staff_id, v_caller_org_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_caller_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff account not found');
  END IF;

  SELECT id, org_id, location_id
  INTO v_doc
  FROM public.clinical_documents
  WHERE id = p_document_id;

  IF v_doc.id IS NULL OR v_doc.org_id <> v_caller_org_id THEN
    RETURN jsonb_build_object('success', false, 'error', 'Document not found');
  END IF;

  -- Authorization: owner OR doctor/nurse at the document's location.
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_caller_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL;
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.location_id = v_doc.location_id
        AND sr.role IN ('doctor', 'nurse')
    ) INTO v_has_role;

    IF NOT v_has_role THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  UPDATE public.clinical_documents
  SET scribe_turns = p_turns,
      scribe_transcript = p_transcript,
      updated_at = now()
  WHERE id = p_document_id;

  INSERT INTO public.audit_trail (org_id, location_id, entity_type, entity_id, actor_id, actor_type, action, details)
  VALUES (
    v_caller_org_id, v_doc.location_id, 'clinical_document', p_document_id,
    v_caller_staff_id,
    CASE WHEN v_owner_id = p_caller_auth_uid THEN 'owner' ELSE 'doctor' END,
    'scribe_turns_edited',
    jsonb_build_object('turns', jsonb_array_length(p_turns))
  );

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.save_scribe_turns(
  p_document_id uuid,
  p_turns jsonb,
  p_transcript text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.save_scribe_turns(v_auth_uid, p_document_id, p_turns, p_transcript);
END;
$$;

REVOKE ALL ON FUNCTION public.save_scribe_turns(uuid, jsonb, text) FROM PUBLIC;
REVOKE EXECUTE ON FUNCTION public.save_scribe_turns(uuid, jsonb, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.save_scribe_turns(uuid, jsonb, text) TO authenticated;
