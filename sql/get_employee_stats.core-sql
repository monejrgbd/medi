-- get_employee_stats: employee performance metrics for a location on a given date
-- Private implementation
CREATE OR REPLACE FUNCTION private.get_employee_stats(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_date date,
  p_staff_user_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_employees jsonb;
  v_checkin_log jsonb;
  v_time_slots jsonb;
BEGIN
  -- Get org info for location
  SELECT l.org_id, o.owner_id INTO v_org_id, v_owner_id
  FROM public.locations l
  JOIN public.organizations o ON o.id = l.org_id
  WHERE l.id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Auth: owner or manager at location
  IF p_caller_auth_uid = v_owner_id THEN
    NULL; -- Owner authorized
  ELSE
    SELECT id INTO v_caller_staff_id
    FROM public.staff_users
    WHERE auth_uid = p_caller_auth_uid
      AND org_id = v_org_id
      AND is_active = true
      AND is_deleted = false;

    IF v_caller_staff_id IS NULL OR NOT EXISTS (
      SELECT 1 FROM public.staff_roles
      WHERE staff_user_id = v_caller_staff_id
        AND role = 'manager'
        AND location_id = p_location_id
    ) THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Build employee stats
  SELECT COALESCE(jsonb_agg(row_data ORDER BY row_data->>'full_name'), '[]'::jsonb)
  INTO v_employees
  FROM (
    SELECT jsonb_build_object(
      'staff_user_id', sc.staff_user_id,
      'full_name', su.full_name,
      'role', sc.role,
      'shift_hours', round(EXTRACT(EPOCH FROM
        sum(
          LEAST(COALESCE(sc.checked_out_at, now()), (p_date + 1)::timestamptz)
          - GREATEST(sc.checked_in_at, p_date::timestamptz)
        )
      ) / 3600.0, 2),
      'utilization', CASE
        WHEN sr.working_hours IS NOT NULL AND sr.working_hours > 0 THEN
          round(
            (EXTRACT(EPOCH FROM sum(
              LEAST(COALESCE(sc.checked_out_at, now()), (p_date + 1)::timestamptz)
              - GREATEST(sc.checked_in_at, p_date::timestamptz)
            )) / 3600.0) / sr.working_hours * 100, 1
          )
        ELSE NULL
      END,
      'patients_handled', COALESCE(vs.patients_handled, 0),
      'throughput', CASE
        WHEN EXTRACT(EPOCH FROM sum(
          LEAST(COALESCE(sc.checked_out_at, now()), (p_date + 1)::timestamptz)
          - GREATEST(sc.checked_in_at, p_date::timestamptz)
        )) > 0 THEN
          round(
            COALESCE(vs.patients_handled, 0)::numeric
            / NULLIF(EXTRACT(EPOCH FROM sum(
              LEAST(COALESCE(sc.checked_out_at, now()), (p_date + 1)::timestamptz)
              - GREATEST(sc.checked_in_at, p_date::timestamptz)
            )) / 3600.0, 0), 1
          )
        ELSE NULL
      END,
      'avg_handling_minutes', CASE
        WHEN sc.role = 'doctor' THEN vs.avg_handling_minutes
        ELSE NULL
      END,
      'idle_hours', CASE
        WHEN sc.role = 'doctor' THEN
          round(GREATEST(
            EXTRACT(EPOCH FROM sum(
              LEAST(COALESCE(sc.checked_out_at, now()), (p_date + 1)::timestamptz)
              - GREATEST(sc.checked_in_at, p_date::timestamptz)
            )) / 3600.0 - COALESCE(vs.total_active_hours, 0),
            0
          ), 2)
        ELSE NULL
      END
    ) AS row_data
    FROM public.staff_checkins sc
    JOIN public.staff_users su ON su.id = sc.staff_user_id
    LEFT JOIN public.staff_roles sr ON sr.staff_user_id = sc.staff_user_id
      AND sr.role = sc.role
      AND sr.location_id = p_location_id
    LEFT JOIN LATERAL (
      SELECT
        count(*) AS patients_handled,
        round(avg(EXTRACT(EPOCH FROM (v.completed_at - v.claimed_at)) / 60.0), 1) AS avg_handling_minutes,
        round(sum(EXTRACT(EPOCH FROM (v.completed_at - v.claimed_at))) / 3600.0, 2) AS total_active_hours
      FROM public.visits v
      WHERE v.claimed_by = sc.staff_user_id
        AND v.location_id = p_location_id
        AND v.status = 'completed'
        AND v.completed_at IS NOT NULL
        AND v.claimed_at IS NOT NULL
        AND v.created_at >= p_date::timestamptz
        AND v.created_at < (p_date + 1)::timestamptz
    ) vs ON true
    WHERE sc.location_id = p_location_id
      AND sc.checked_in_at < (p_date + 1)::timestamptz
      AND (sc.checked_out_at IS NULL OR sc.checked_out_at >= p_date::timestamptz)
      AND (p_staff_user_id IS NULL OR sc.staff_user_id = p_staff_user_id)
    GROUP BY sc.staff_user_id, su.full_name, sc.role, sr.working_hours,
             vs.patients_handled, vs.avg_handling_minutes, vs.total_active_hours
  ) sub;

  -- Build checkin log
  SELECT COALESCE(jsonb_agg(jsonb_build_object(
    'staff_user_id', sc.staff_user_id,
    'full_name', su.full_name,
    'checked_in_at', sc.checked_in_at,
    'checked_out_at', sc.checked_out_at
  ) ORDER BY sc.checked_in_at), '[]'::jsonb)
  INTO v_checkin_log
  FROM public.staff_checkins sc
  JOIN public.staff_users su ON su.id = sc.staff_user_id
  WHERE sc.location_id = p_location_id
    AND sc.checked_in_at < (p_date + 1)::timestamptz
    AND (sc.checked_out_at IS NULL OR sc.checked_out_at >= p_date::timestamptz)
    AND (p_staff_user_id IS NULL OR sc.staff_user_id = p_staff_user_id);

  -- Build time slots (doctor visits)
  SELECT COALESCE(jsonb_agg(jsonb_build_object(
    'staff_user_id', v.claimed_by,
    'visit_id', v.id,
    'patient_name', p.first_name || ' ' || p.last_name,
    'entered_queue_at', v.entered_queue_at,
    'claimed_at', v.claimed_at,
    'completed_at', v.completed_at
  ) ORDER BY v.claimed_at), '[]'::jsonb)
  INTO v_time_slots
  FROM public.visits v
  JOIN public.patients p ON p.id = v.patient_id
  WHERE v.location_id = p_location_id
    AND v.status = 'completed'
    AND v.completed_at IS NOT NULL
    AND v.created_at >= p_date::timestamptz
    AND v.created_at < (p_date + 1)::timestamptz
    AND (p_staff_user_id IS NULL OR v.claimed_by = p_staff_user_id);

  RETURN jsonb_build_object(
    'success', true,
    'employees', v_employees,
    'checkin_log', v_checkin_log,
    'time_slots', v_time_slots
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_employee_stats(
  p_location_id uuid,
  p_date date DEFAULT CURRENT_DATE,
  p_staff_user_id uuid DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.get_employee_stats(v_auth_uid, p_location_id, p_date, p_staff_user_id);
END;
$$;

REVOKE ALL ON FUNCTION public.get_employee_stats(uuid, date, uuid) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.get_employee_stats(uuid, date, uuid) TO authenticated;

-- Index for completed visit analytics by doctor
CREATE INDEX IF NOT EXISTS idx_visits_claimed_completed
  ON public.visits (claimed_by, created_at) WHERE status = 'completed';
