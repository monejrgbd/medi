-- Private implementation
CREATE OR REPLACE FUNCTION private.update_organization(
  p_caller_auth_uid uuid,
  p_name text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_trimmed_name text;
BEGIN
  v_trimmed_name := trim(p_name);

  IF v_trimmed_name = '' OR v_trimmed_name IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Organization name is required');
  END IF;

  SELECT id INTO v_org_id
  FROM public.organizations
  WHERE owner_id = p_caller_auth_uid;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Only the organization owner can update settings');
  END IF;

  UPDATE public.organizations
  SET name = v_trimmed_name
  WHERE id = v_org_id;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.update_organization(p_name text)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.update_organization(v_auth_uid, p_name);
END;
$$;
