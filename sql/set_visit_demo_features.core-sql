-- Private implementation
CREATE OR REPLACE FUNCTION private.set_visit_demo_features(
  p_caller_auth_uid uuid,
  p_visit_id uuid,
  p_features jsonb
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_caller_staff_id uuid;
BEGIN
  -- Get visit
  SELECT v.id, v.org_id INTO v_visit
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  -- Get caller staff_id (must be active staff in visit's org)
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.org_id = v_visit.org_id
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_caller_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Update visit with demo features
  UPDATE public.visits
  SET demo_features = p_features
  WHERE id = p_visit_id;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.set_visit_demo_features(
  p_visit_id uuid,
  p_features jsonb
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.set_visit_demo_features(v_auth_uid, p_visit_id, p_features);
END;
$$;

REVOKE ALL ON FUNCTION public.set_visit_demo_features(uuid, jsonb) FROM PUBLIC;
REVOKE ALL ON FUNCTION public.set_visit_demo_features(uuid, jsonb) FROM anon;
GRANT EXECUTE ON FUNCTION public.set_visit_demo_features(uuid, jsonb) TO authenticated;
