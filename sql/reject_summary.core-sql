-- Private implementation
CREATE OR REPLACE FUNCTION private.reject_summary(
  p_visit_id uuid,
  p_session_token uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
BEGIN
  -- Look up visit
  SELECT v.id, v.status, v.session_token, v.created_at
  INTO v_visit
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  IF v_visit.session_token <> p_session_token THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid session');
  END IF;

  IF v_visit.status <> 'still_answering_ai' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit is not in AI conversation state');
  END IF;

  -- 24-hour session expiry
  IF v_visit.created_at < now() - interval '24 hours' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Session expired');
  END IF;

  -- Clear stale summary data so session recovery shows chat, not summary
  UPDATE public.visits
  SET ai_summary = NULL,
      ai_structured_card = NULL,
      ai_diagnostic = NULL,
      ai_completed_at = NULL,
      updated_at = now()
  WHERE id = p_visit_id;

  -- Insert a system message so the AI knows to continue asking
  INSERT INTO public.visit_messages (visit_id, role, content)
  VALUES (p_visit_id, 'system', 'The patient indicated the summary was inaccurate. Please ask what was missing or incorrect, then continue gathering information.');

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper (anon-callable)
CREATE OR REPLACE FUNCTION public.reject_summary(
  p_visit_id uuid,
  p_session_token uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  RETURN private.reject_summary(p_visit_id, p_session_token);
END;
$$;
