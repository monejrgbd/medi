-- Private implementation
CREATE OR REPLACE FUNCTION private.nurse_release_to_doctor(
  p_caller_auth_uid uuid,
  p_visit_id uuid,
  p_nurse_notes text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_nurse_enabled boolean;
  v_clean_notes text;
  v_edge_url text;
  v_edge_secret text;
  v_anon_key text;
BEGIN
  -- Get visit details
  SELECT v.id, v.status, v.claimed_by, v.location_id, v.org_id, v.nurse_reviewed, v.entered_queue_at
  INTO v_visit
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  IF v_visit.status <> 'claimed_by_doctor' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit is not claimed');
  END IF;

  -- Get caller staff id
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.org_id = v_visit.org_id
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_caller_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff account required');
  END IF;

  -- Verify claimed_by = caller
  IF v_visit.claimed_by <> v_caller_staff_id THEN
    RETURN jsonb_build_object(
      'success', false,
      'error', 'This visit was claimed by another staff member',
      'code', 'visit_not_yours'
    );
  END IF;

  -- Verify caller has nurse role at visit location
  IF NOT EXISTS(
    SELECT 1 FROM public.staff_roles sr
    WHERE sr.staff_user_id = v_caller_staff_id
      AND sr.role = 'nurse'
      AND sr.location_id = v_visit.location_id
  ) THEN
    RETURN jsonb_build_object(
      'success', false,
      'error', 'You no longer have nurse role at this location',
      'code', 'role_revoked'
    );
  END IF;

  -- Verify location has nurse_enabled
  SELECT l.nurse_enabled INTO v_nurse_enabled
  FROM public.locations l WHERE l.id = v_visit.location_id;

  IF v_nurse_enabled IS NOT TRUE THEN
    RETURN jsonb_build_object('success', false, 'error', 'Nurse workflow not enabled at this location');
  END IF;

  -- Sanitize nurse notes
  v_clean_notes := regexp_replace(trim(COALESCE(p_nurse_notes, '')), '<[^>]*>', '', 'g');

  IF length(v_clean_notes) > 10000 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Nurse notes exceed maximum length');
  END IF;

  -- Set audit context
  PERFORM set_config('app.audit_actor_id', v_caller_staff_id::text, true);
  PERFORM set_config('app.audit_actor_type', 'nurse', true);
  PERFORM set_config('app.audit_action', 'nurse_released', true);

  -- Release to doctor queue: keep entered_queue_at unchanged for fair re-entry.
  -- Clear staff_room so the nurse's room does not linger once the patient
  -- is back in the unclaimed queue waiting for a doctor.
  UPDATE public.visits
  SET status = 'waiting_doctor_claim',
      claimed_by = NULL,
      claimed_at = NULL,
      staff_room = NULL,
      nurse_reviewed = true,
      nurse_notes = v_clean_notes
  WHERE id = p_visit_id;

  -- Trigger AI diagnostic regeneration with nurse data folded in. The summary itself was
  -- generated earlier (on AI complete) without nurse data — that is by design (summary =
  -- "what the patient said"). The diagnostic, by contrast, needs the full picture, so we
  -- (re)generate it now that nurse_reviewed = true and nurse_notes is set. Fire-and-forget
  -- with EXCEPTION wrapper so a failed diagnostic trigger never blocks the release.
  BEGIN
    SELECT decrypted_secret INTO v_edge_url FROM vault.decrypted_secrets WHERE name = 'edge_function_url';
    SELECT decrypted_secret INTO v_edge_secret FROM vault.decrypted_secrets WHERE name = 'internal_edge_secret';
    SELECT decrypted_secret INTO v_anon_key FROM vault.decrypted_secrets WHERE name = 'supabase_anon_key';

    IF v_edge_url IS NOT NULL AND v_edge_secret IS NOT NULL AND v_anon_key IS NOT NULL THEN
      PERFORM net.http_post(
        url := v_edge_url || '/generate-summary',
        headers := jsonb_build_object(
          'Content-Type', 'application/json',
          'Authorization', 'Bearer ' || v_anon_key,
          'x-internal-secret', v_edge_secret
        ),
        body := jsonb_build_object('visit_id', p_visit_id, 'mode', 'diagnostic_only')
      );
    END IF;
  EXCEPTION WHEN OTHERS THEN
    RAISE WARNING 'generate-summary diagnostic_only trigger failed in nurse_release_to_doctor: %', SQLERRM;
  END;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.nurse_release_to_doctor(
  p_visit_id uuid,
  p_nurse_notes text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.nurse_release_to_doctor(v_auth_uid, p_visit_id, p_nurse_notes);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.nurse_release_to_doctor(uuid, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.nurse_release_to_doctor(uuid, text) TO authenticated;
