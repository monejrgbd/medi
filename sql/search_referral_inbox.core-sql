-- Private implementation
CREATE OR REPLACE FUNCTION private.search_referral_inbox(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_query text
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_is_authorized boolean := false;
  v_clean_query text;
  v_result jsonb;
BEGIN
  -- Input validation
  v_clean_query := trim(COALESCE(p_query, ''));

  IF length(v_clean_query) < 3 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Query must be at least 3 characters');
  END IF;

  IF length(v_clean_query) > 200 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Query must not exceed 200 characters');
  END IF;

  -- Get location org
  SELECT l.org_id INTO v_org_id
  FROM public.locations l
  WHERE l.id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Get caller staff id
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.org_id = v_org_id
    AND su.is_active = true
    AND su.is_deleted = false;

  -- Authorization: owner or receptionist/manager at this location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    v_is_authorized := true;
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role IN ('receptionist', 'manager')
        AND sr.location_id = p_location_id
    ) INTO v_is_authorized;
  END IF;

  IF NOT v_is_authorized THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Search referrals
  SELECT jsonb_build_object(
    'success', true,
    'referrals', COALESCE(jsonb_agg(row_data), '[]'::jsonb)
  ) INTO v_result
  FROM (
    SELECT jsonb_build_object(
      'id', r.id,
      'patient_name', r.patient_name,
      'specialty', r.specialty,
      'status', r.status,
      'from_org_name', o.name,
      'from_doctor_name', su.full_name,
      'created_at', r.created_at
    ) AS row_data
    FROM public.referrals r
    JOIN public.organizations o ON o.id = r.from_org_id
    JOIN public.staff_users su ON su.id = r.from_doctor_id
    WHERE r.to_location_id = p_location_id
      AND r.patient_name ILIKE '%' || replace(replace(v_clean_query, '%', '\%'), '_', '\_') || '%'
    ORDER BY r.created_at DESC
    LIMIT 25
  ) sub;

  RETURN v_result;
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.search_referral_inbox(
  p_location_id uuid,
  p_query text
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.search_referral_inbox(v_auth_uid, p_location_id, p_query);
END;
$$;

REVOKE ALL ON FUNCTION public.search_referral_inbox(uuid, text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.search_referral_inbox(uuid, text) TO authenticated;
