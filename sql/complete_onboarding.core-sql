-- Private implementation
CREATE OR REPLACE FUNCTION private.complete_onboarding(p_caller_auth_uid uuid)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
BEGIN
  -- Verify caller is org owner
  SELECT id INTO v_org_id
  FROM public.organizations
  WHERE owner_id = p_caller_auth_uid;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not an organization owner');
  END IF;

  UPDATE public.organizations
  SET onboarding_completed_at = now()
  WHERE id = v_org_id
    AND onboarding_completed_at IS NULL;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.complete_onboarding()
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.complete_onboarding(v_auth_uid);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.complete_onboarding() FROM anon;
GRANT EXECUTE ON FUNCTION public.complete_onboarding() TO authenticated;
