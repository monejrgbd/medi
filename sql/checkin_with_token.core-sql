-- Anon-callable: patient submitting form via pre-checkin link
CREATE OR REPLACE FUNCTION public.checkin_with_token(
  p_token uuid,
  p_first_name text,
  p_last_name text,
  p_birthday date,
  p_sex text DEFAULT NULL,
  p_phone text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_tok record;
  v_org_id uuid;
  v_location_id uuid;
  v_clean_first text;
  v_clean_last text;
  v_clean_phone text;
  v_skip_ai boolean;
  v_patient record;
  v_new_patient_id uuid;
  v_has_previous boolean;
  v_active_visit record;
  v_new_visit record;
  v_name_sim real;
BEGIN
  -- Validate inputs
  IF p_token IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Token is required');
  END IF;

  -- Sanitize name inputs
  v_clean_first := substring(trim(regexp_replace(COALESCE(p_first_name, ''), '<[^>]*>', '', 'g')), 1, 100);
  v_clean_last := substring(trim(regexp_replace(COALESCE(p_last_name, ''), '<[^>]*>', '', 'g')), 1, 100);

  IF length(v_clean_first) = 0 OR length(v_clean_last) = 0 THEN
    RETURN jsonb_build_object('success', false, 'error', 'First and last name are required');
  END IF;

  -- Validate birthday
  IF p_birthday IS NULL OR p_birthday >= CURRENT_DATE OR p_birthday < '1900-01-01'::date THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid date of birth');
  END IF;

  -- Validate sex
  IF p_sex IS NOT NULL AND p_sex NOT IN ('male', 'female', 'other') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid sex value');
  END IF;

  -- Validate phone (E.164)
  IF p_phone IS NOT NULL AND p_phone <> '' THEN
    v_clean_phone := trim(p_phone);
    IF v_clean_phone !~ '^\+[1-9]\d{1,14}$' THEN
      RETURN jsonb_build_object('success', false, 'error', 'Invalid phone format');
    END IF;
  ELSE
    v_clean_phone := NULL;
  END IF;

  -- =====================================================
  -- LOCK AND VALIDATE TOKEN
  -- =====================================================
  SELECT t.*, l.org_id AS loc_org_id
  INTO v_tok
  FROM public.pre_checkin_tokens t
  JOIN public.locations l ON l.id = t.location_id
  WHERE t.token = p_token
  FOR UPDATE OF t;

  IF v_tok IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid token');
  END IF;

  IF v_tok.expires_at < now() THEN
    RETURN jsonb_build_object('success', false, 'error', 'Token has expired');
  END IF;

  v_org_id := v_tok.loc_org_id;
  v_location_id := v_tok.location_id;

  -- Token already used: return session recovery if visit is active
  IF v_tok.used AND v_tok.visit_id IS NOT NULL THEN
    SELECT v.* INTO v_active_visit
    FROM public.visits v
    WHERE v.id = v_tok.visit_id
      AND v.status NOT IN ('completed', 'left');

    IF v_active_visit IS NOT NULL THEN
      RETURN jsonb_build_object(
        'success', true,
        'match_type', 'active_session',
        'session_token', v_active_visit.session_token,
        'visit_id', v_active_visit.id,
        'queue_number', v_active_visit.queue_number
      );
    ELSE
      RETURN jsonb_build_object('success', false, 'error', 'This link has already been used');
    END IF;
  END IF;

  -- =====================================================
  -- SUBSCRIPTION CHECK
  -- =====================================================
  IF EXISTS (
    SELECT 1 FROM public.organizations o
    WHERE o.id = v_org_id
      AND o.subscription_plan IN ('expired', 'suspended', 'read_only')
  ) THEN
    RETURN jsonb_build_object('success', false, 'error', 'subscription_inactive');
  END IF;

  -- Location existence is guaranteed by the token FK.
  -- We intentionally skip the "receptionist checked in" check because
  -- pre-checkin links are designed for patients filling out from home
  -- before arriving at the clinic.

  -- =====================================================
  -- FUZZY NAME MATCH (pg_trgm) — only when name matching is enabled
  -- =====================================================
  IF v_tok.name_match_mode = 'name' THEN
    v_name_sim := (
      public.similarity(lower(v_clean_first), lower(v_tok.first_name)) +
      public.similarity(lower(v_clean_last), lower(v_tok.last_name))
    ) / 2.0;

    IF v_name_sim < 0.4 THEN
      RETURN jsonb_build_object('success', false, 'error', 'Name does not match the invitation');
    END IF;
  END IF;

  -- =====================================================
  -- FIND OR CREATE PATIENT
  -- =====================================================
  -- Try exact match first (org, name, birthday)
  SELECT p.* INTO v_patient
  FROM public.patients p
  WHERE p.org_id = v_org_id
    AND lower(p.first_name) = lower(v_clean_first)
    AND lower(p.last_name) = lower(v_clean_last)
    AND p.birthday = p_birthday
    AND NOT p.is_orphaned
  ORDER BY p.created_at ASC
  LIMIT 1;

  IF v_patient IS NOT NULL THEN
    -- Check for active visit
    SELECT v.* INTO v_active_visit
    FROM public.visits v
    WHERE v.patient_id = v_patient.id
      AND v.location_id = v_location_id
      AND v.status NOT IN ('completed', 'left')
    ORDER BY v.created_at DESC
    LIMIT 1;

    IF v_active_visit IS NOT NULL THEN
      -- Mark token used with existing visit
      UPDATE public.pre_checkin_tokens
      SET used = true, visit_id = v_active_visit.id, session_token = v_active_visit.session_token
      WHERE id = v_tok.id;

      RETURN jsonb_build_object(
        'success', true,
        'match_type', 'active_session',
        'session_token', v_active_visit.session_token,
        'visit_id', v_active_visit.id,
        'queue_number', v_active_visit.queue_number
      );
    END IF;

    -- Check for prior completed visits
    SELECT EXISTS(
      SELECT 1 FROM public.visits v
      WHERE v.patient_id = v_patient.id AND v.status = 'completed'
    ) INTO v_has_previous;

    -- Update phone/sex if provided and not set
    IF v_clean_phone IS NOT NULL AND v_patient.phone IS NULL THEN
      UPDATE public.patients SET phone = v_clean_phone WHERE id = v_patient.id;
    END IF;
    IF p_sex IS NOT NULL AND v_patient.sex IS NULL THEN
      UPDATE public.patients SET sex = p_sex WHERE id = v_patient.id;
    END IF;
  ELSE
    -- New patient
    v_has_previous := false;

    BEGIN
      INSERT INTO public.patients (org_id, first_name, last_name, birthday, phone, phone_verified, sex)
      VALUES (v_org_id, v_clean_first, v_clean_last, p_birthday, v_clean_phone, false, p_sex)
      RETURNING * INTO v_patient;
    EXCEPTION WHEN unique_violation THEN
      SELECT p.* INTO v_patient
      FROM public.patients p
      WHERE p.org_id = v_org_id
        AND lower(p.first_name) = lower(v_clean_first)
        AND lower(p.last_name) = lower(v_clean_last)
        AND p.birthday = p_birthday
        AND NOT p.is_orphaned
      LIMIT 1;

      IF v_patient IS NULL THEN
        RETURN jsonb_build_object('success', false, 'error', 'Unable to create patient record');
      END IF;
    END;
  END IF;

  -- =====================================================
  -- RESOLVE AI CONFIG (skip_ai + model override + fallback) + CHECKIN MODE
  -- =====================================================
  DECLARE
    v_loc_skip_ai boolean;
    v_resolved_skip boolean := false;
    v_resolved_model text := NULL;
    v_ai_fallback boolean := false;
    v_loc_mode text;
    v_effective_mode text;
    v_initial_status text;
    v_initial_ai_started_at timestamptz;
    v_initial_entered_queue_at timestamptz;
  BEGIN
    SELECT COALESCE(l.skip_ai, false), l.checkin_mode INTO v_loc_skip_ai, v_loc_mode
    FROM public.locations l WHERE l.id = v_location_id;

    -- Per-link override wins over location default
    v_effective_mode := COALESCE(v_tok.checkin_mode_override, v_loc_mode);

    -- Skip AI resolution (same priority as approve_patient)
    IF v_loc_skip_ai THEN
      v_resolved_skip := true;  -- Location always wins
    ELSIF COALESCE(v_tok.skip_ai, false) THEN
      v_resolved_skip := true;  -- Token skip is additive
    END IF;

    -- Premium AI fallback: re-check budget at use time
    IF NOT v_resolved_skip AND v_tok.ai_model_override = 'premium' THEN
      DECLARE
        v_org_budget record;
        v_cap numeric;
        v_cost numeric;
        v_net_usage numeric;
        v_topup_remaining numeric;
        v_budget_ok boolean := false;
      BEGIN
        SELECT subscription_plan, billing_cycle_start, credits_total, credits_used
        INTO v_org_budget
        FROM public.organizations WHERE id = v_org_id;

        IF v_org_budget.subscription_plan IN ('pay_as_you_go', 'standard_trial', 'premium_trial') THEN
          v_cost := 4;
          v_budget_ok := (v_org_budget.credits_total - v_org_budget.credits_used) >= v_cost;
        ELSE
          CASE v_org_budget.subscription_plan
            WHEN 'starter' THEN v_cap := 3.5; v_cost := 3.5;
            WHEN 'professional' THEN v_cap := 15; v_cost := 3;
            WHEN 'business' THEN v_cap := 62.5; v_cost := 2.5;
            WHEN 'enterprise' THEN v_cap := 10000; v_cost := 2.5;
            ELSE v_cap := 0; v_cost := 4;
          END CASE;

          SELECT GREATEST(COALESCE(-SUM(credits_amount), 0), 0) INTO v_net_usage
          FROM public.credits_log
          WHERE org_id = v_org_id AND credit_type = 'premium_ai'
            AND created_at >= COALESCE(v_org_budget.billing_cycle_start, now() - interval '30 days');

          IF v_net_usage + v_cost <= v_cap THEN
            v_budget_ok := true;
          ELSE
            SELECT COALESCE(SUM(credits - used), 0) INTO v_topup_remaining
            FROM public.budget_topups
            WHERE org_id = v_org_id AND feature IN ('premium_ai', 'general') AND credits - used > 0;
            v_budget_ok := v_topup_remaining >= v_cost;
          END IF;
        END IF;

        IF v_budget_ok THEN
          v_resolved_model := 'premium';
        ELSE
          v_resolved_model := NULL; -- Silent fallback to the location default
          v_ai_fallback := true;
        END IF;
      END;
    ELSIF NOT v_resolved_skip AND v_tok.ai_model_override IS NOT NULL THEN
      v_resolved_model := v_tok.ai_model_override;
    END IF;

    -- Resolve initial visit state based on effective check-in mode + skip_ai:
    --   approve_to_start: receptionist must approve before anything happens
    --   approve_on_arrival / self_service_on_arrival + skip_ai: straight to arrival gate
    --   approve_on_arrival / self_service_on_arrival + !skip_ai: start chat immediately
    IF v_effective_mode = 'approve_to_start' THEN
      v_initial_status := 'pending_approval';
      v_initial_ai_started_at := NULL;
      v_initial_entered_queue_at := NULL;
    ELSIF v_resolved_skip THEN
      v_initial_status := 'awaiting_arrival';
      v_initial_ai_started_at := NULL;
      v_initial_entered_queue_at := NULL;
    ELSE
      v_initial_status := 'still_answering_ai';
      v_initial_ai_started_at := now();
      v_initial_entered_queue_at := NULL;
    END IF;

    INSERT INTO public.visits (
      org_id, location_id, patient_id, has_previous_visits,
      phone_verification_pending, is_return_visit,
      status, ai_skipped, ai_started_at, entered_queue_at,
      ai_model_override, ai_session_instructions,
      checkin_mode
    )
    VALUES (
      v_org_id, v_location_id, v_patient.id, v_has_previous,
      false, v_has_previous,
      v_initial_status, v_resolved_skip, v_initial_ai_started_at, v_initial_entered_queue_at,
      CASE WHEN v_resolved_skip THEN NULL ELSE v_resolved_model END,
      v_tok.ai_session_instructions,
      v_effective_mode
    )
    RETURNING * INTO v_new_visit;

    -- Mark token used + audit
    UPDATE public.pre_checkin_tokens
    SET used = true, visit_id = v_new_visit.id, session_token = v_new_visit.session_token
    WHERE id = v_tok.id;

    INSERT INTO public.audit_trail (org_id, entity_type, entity_id, actor_id, actor_type, action, details)
    VALUES (
      v_org_id, 'visit', v_new_visit.id,
      v_tok.created_by, 'receptionist', 'pre_checkin_used',
      jsonb_build_object(
        'token_id', v_tok.id,
        'patient_name', v_clean_first || ' ' || v_clean_last,
        'name_similarity', round(v_name_sim::numeric, 2),
        'ai_skipped', v_resolved_skip,
        'ai_model_override', v_resolved_model,
        'ai_model_fallback', v_ai_fallback,
        'name_match_mode', v_tok.name_match_mode,
        'checkin_mode', v_effective_mode
      )
    );

    RETURN jsonb_build_object(
      'success', true,
      'match_type', 'pre_approved',
      'session_token', v_new_visit.session_token,
      'visit_id', v_new_visit.id,
      'queue_number', v_new_visit.queue_number,
      'has_previous_visits', v_has_previous,
      'phone_verified', false,
      'ai_skipped', v_resolved_skip,
      'status', v_initial_status,
      'checkin_mode', v_effective_mode
    );
  END;
END;
$$;

REVOKE ALL ON FUNCTION public.checkin_with_token(uuid, text, text, date, text, text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.checkin_with_token(uuid, text, text, date, text, text) TO anon, authenticated;
