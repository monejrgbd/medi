-- get_followup_compliance: follow-up funnel and compliance metrics
-- Private implementation
CREATE OR REPLACE FUNCTION private.get_followup_compliance(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_start_date date,
  p_end_date date
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_funnel jsonb;
  v_per_doctor jsonb;
BEGIN
  -- Get org info for location
  SELECT l.org_id, o.owner_id
  INTO v_org_id, v_owner_id
  FROM public.locations l
  JOIN public.organizations o ON o.id = l.org_id
  WHERE l.id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Auth: owner or manager at location
  IF p_caller_auth_uid = v_owner_id THEN
    NULL;
  ELSE
    SELECT id INTO v_caller_staff_id
    FROM public.staff_users
    WHERE auth_uid = p_caller_auth_uid
      AND org_id = v_org_id
      AND is_active = true
      AND is_deleted = false;

    IF v_caller_staff_id IS NULL OR NOT EXISTS (
      SELECT 1 FROM public.staff_roles
      WHERE staff_user_id = v_caller_staff_id
        AND role = 'manager'
        AND location_id = p_location_id
    ) THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Date range guard
  IF p_end_date < p_start_date THEN
    RETURN jsonb_build_object('success', false, 'error', 'End date must be after start date');
  END IF;

  IF (p_end_date - p_start_date) > 90 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Date range cannot exceed 90 days');
  END IF;

  -- Funnel stats (follow-ups are always available, no addon gate)
  SELECT jsonb_build_object(
    'tagged', count(*),
    'returned', count(*) FILTER (WHERE f.status = 'completed'),
    'overdue', count(*) FILTER (WHERE f.due_at < now() AND f.status = 'active'),
    'reminded', count(*) FILTER (WHERE f.reminders_sent > 0),
    'returned_after_reminder', count(*) FILTER (WHERE f.status = 'completed' AND f.reminders_sent > 0),
    'expired', count(*) FILTER (WHERE f.status = 'expired')
  ) INTO v_funnel
  FROM public.follow_ups f
  WHERE f.location_id = p_location_id
    AND f.created_at >= p_start_date::timestamptz
    AND f.created_at < (p_end_date + 1)::timestamptz;

  -- Per-doctor breakdown
  SELECT COALESCE(jsonb_agg(jsonb_build_object(
    'staff_user_id', f.doctor_id,
    'full_name', su.full_name,
    'tagged', count(*),
    'returned', count(*) FILTER (WHERE f.status = 'completed'),
    'compliance_rate', CASE
      WHEN count(*) > 0 THEN round(count(*) FILTER (WHERE f.status = 'completed')::numeric / count(*)::numeric * 100, 1)
      ELSE 0
    END
  ) ORDER BY count(*) DESC), '[]'::jsonb)
  INTO v_per_doctor
  FROM public.follow_ups f
  JOIN public.staff_users su ON su.id = f.doctor_id
  WHERE f.location_id = p_location_id
    AND f.created_at >= p_start_date::timestamptz
    AND f.created_at < (p_end_date + 1)::timestamptz
  GROUP BY f.doctor_id, su.full_name;

  RETURN jsonb_build_object(
    'success', true,
    'addon_enabled', true,
    'funnel', v_funnel,
    'per_doctor', v_per_doctor
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_followup_compliance(
  p_location_id uuid,
  p_start_date date,
  p_end_date date
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.get_followup_compliance(v_auth_uid, p_location_id, p_start_date, p_end_date);
END;
$$;

REVOKE ALL ON FUNCTION public.get_followup_compliance(uuid, date, date) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.get_followup_compliance(uuid, date, date) TO authenticated;

-- Index for follow-up analytics
CREATE INDEX IF NOT EXISTS idx_follow_ups_analytics
  ON public.follow_ups (location_id, created_at);
