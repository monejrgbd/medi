-- Private implementation
CREATE OR REPLACE FUNCTION private.set_staff_room(
  p_caller_auth_uid uuid,
  p_room text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_staff_user_id uuid;
  v_checkin_id uuid;
  v_location_id uuid;
  v_room text;
  v_presets text[];
BEGIN
  -- Resolve staff user
  SELECT su.id INTO v_staff_user_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_staff_user_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user not found');
  END IF;

  -- Validate + trim room input
  v_room := btrim(COALESCE(p_room, ''));
  IF v_room = '' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Room name is required');
  END IF;
  IF length(v_room) > 60 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Room name must be 60 characters or fewer');
  END IF;

  -- Find active doctor/nurse checkin and lock it so concurrent claim_patient waits
  SELECT id, location_id INTO v_checkin_id, v_location_id
  FROM public.staff_checkins
  WHERE staff_user_id = v_staff_user_id
    AND role IN ('doctor', 'nurse')
    AND checked_out_at IS NULL
  ORDER BY checked_in_at DESC
  LIMIT 1
  FOR UPDATE;

  IF v_checkin_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'No active doctor or nurse check-in found');
  END IF;

  -- Enforce preset list if location has one
  SELECT preset_rooms INTO v_presets FROM public.locations WHERE id = v_location_id;
  IF v_presets IS NOT NULL AND array_length(v_presets, 1) > 0 THEN
    IF NOT (v_room = ANY(v_presets)) THEN
      RETURN jsonb_build_object('success', false, 'error', 'Room must be one of the preset rooms for this location');
    END IF;
  END IF;

  -- Update the checkin
  UPDATE public.staff_checkins
  SET current_room = v_room
  WHERE id = v_checkin_id;

  -- Cascade to all currently claimed visits by this staff member so
  -- patient/TV/receptionist surfaces see the new room via realtime
  UPDATE public.visits
  SET staff_room = v_room
  WHERE claimed_by = v_staff_user_id
    AND status = 'claimed_by_doctor';

  RETURN jsonb_build_object('success', true, 'room', v_room);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.set_staff_room(
  p_room text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.set_staff_room(v_auth_uid, p_room);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.set_staff_room(text) FROM anon;
GRANT EXECUTE ON FUNCTION public.set_staff_room(text) TO authenticated;
