-- Private implementation
CREATE OR REPLACE FUNCTION private.remove_role(
  p_caller_auth_uid uuid,
  p_staff_user_id uuid,
  p_location_id uuid,
  p_role text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_is_manager boolean := false;
BEGIN
  SELECT su.org_id INTO v_org_id
  FROM public.staff_users su
  WHERE su.id = p_staff_user_id AND su.is_deleted = false;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user not found');
  END IF;

  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;

  IF v_owner_id <> p_caller_auth_uid THEN
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      JOIN public.staff_users su ON su.id = sr.staff_user_id
      WHERE su.auth_uid = p_caller_auth_uid
        AND sr.location_id = p_location_id
        AND sr.role = 'manager'
        AND su.is_active = true AND su.is_deleted = false
    ) INTO v_is_manager;

    IF NOT v_is_manager THEN
      RETURN jsonb_build_object('success', false, 'error', 'Only owner or manager can remove roles');
    END IF;
  END IF;

  DELETE FROM public.staff_roles
  WHERE staff_user_id = p_staff_user_id
    AND location_id = p_location_id
    AND role = p_role;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.remove_role(
  p_staff_user_id uuid,
  p_location_id uuid,
  p_role text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.remove_role(v_auth_uid, p_staff_user_id, p_location_id, p_role);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.remove_role(uuid, uuid, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.remove_role(uuid, uuid, text) TO authenticated;
