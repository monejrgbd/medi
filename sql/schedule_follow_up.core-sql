-- private.schedule_follow_up
-- Receptionist sets the due date on an unscheduled follow-up
-- Called by: public.schedule_follow_up (wrapper)

CREATE OR REPLACE FUNCTION private.schedule_follow_up(
  p_caller_auth_uid uuid,
  p_follow_up_id uuid,
  p_due_at timestamptz
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_follow_up record;
  v_caller_staff_id uuid;
  v_owner_id uuid;
  v_location_followup_enabled boolean;
  v_org record;
  v_remaining numeric;
  v_sms_charged boolean := false;
  v_timeframe_days int;
BEGIN
  -- Validate due_at is today or later
  IF p_due_at::date < current_date THEN
    RETURN jsonb_build_object('success', false, 'error', 'Due date must be today or later');
  END IF;

  -- Get follow-up
  SELECT f.*, v.completed_at
  INTO v_follow_up
  FROM public.follow_ups f
  JOIN public.visits v ON v.id = f.visit_id
  WHERE f.id = p_follow_up_id;

  IF v_follow_up.id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Follow-up not found');
  END IF;

  IF v_follow_up.status <> 'active' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Follow-up is not active');
  END IF;

  IF v_follow_up.due_at IS NOT NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Follow-up already has a scheduled date');
  END IF;

  -- Get caller staff id
  SELECT id INTO v_caller_staff_id
  FROM public.staff_users
  WHERE auth_uid = p_caller_auth_uid
    AND org_id = v_follow_up.org_id
    AND is_active = true
    AND is_deleted = false;

  -- Get org owner
  SELECT owner_id INTO v_owner_id
  FROM public.organizations
  WHERE id = v_follow_up.org_id;

  -- Auth: must be owner or receptionist at location
  IF v_owner_id = p_caller_auth_uid THEN
    NULL;
  ELSIF v_caller_staff_id IS NOT NULL THEN
    IF NOT EXISTS (
      SELECT 1 FROM public.staff_roles
      WHERE staff_user_id = v_caller_staff_id
        AND location_id = v_follow_up.location_id
        AND role = 'receptionist'
    ) THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  ELSE
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Compute timeframe_days for record keeping
  v_timeframe_days := GREATEST(1, (EXTRACT(EPOCH FROM p_due_at - v_follow_up.completed_at) / 86400)::int);

  -- Check if location has followup SMS enabled and charge credits
  SELECT followup_sms_enabled INTO v_location_followup_enabled
  FROM public.locations
  WHERE id = v_follow_up.location_id;

  IF v_location_followup_enabled THEN
    SELECT o.credits_total, o.credits_used, o.subscription_plan
    INTO v_org
    FROM public.organizations o
    WHERE o.id = v_follow_up.org_id
    FOR UPDATE;

    IF v_org.subscription_plan NOT IN ('expired', 'suspended', 'read_only') THEN
      v_remaining := v_org.credits_total - v_org.credits_used;
      IF v_remaining >= 0.1 THEN
        UPDATE public.organizations
        SET credits_used = credits_used + 0.1
        WHERE id = v_follow_up.org_id;

        INSERT INTO public.credits_log (org_id, credits_amount, description)
        VALUES (v_follow_up.org_id, -0.1, 'Follow-up SMS scheduled — follow-up ' || p_follow_up_id::text);

        v_sms_charged := true;
      END IF;
    END IF;
  END IF;

  -- Update follow-up
  UPDATE public.follow_ups
  SET due_at = p_due_at,
      timeframe_days = v_timeframe_days,
      sms_charged = v_sms_charged
  WHERE id = p_follow_up_id;

  -- Audit trail
  INSERT INTO public.audit_trail (
    org_id, entity_type, entity_id, actor_id, actor_type, action, details
  ) VALUES (
    v_follow_up.org_id,
    'follow_up',
    p_follow_up_id,
    COALESCE(v_caller_staff_id, p_caller_auth_uid),
    CASE WHEN v_owner_id = p_caller_auth_uid THEN 'owner' ELSE 'receptionist' END,
    'scheduled',
    jsonb_build_object(
      'due_at', p_due_at,
      'timeframe_days', v_timeframe_days,
      'sms_charged', v_sms_charged
    )
  );

  RETURN jsonb_build_object('success', true, 'sms_charged', v_sms_charged);
END;
$$;

-- public.schedule_follow_up (wrapper)
CREATE OR REPLACE FUNCTION public.schedule_follow_up(
  p_follow_up_id uuid,
  p_due_at timestamptz
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid;
BEGIN
  v_auth_uid := auth.uid();
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;

  RETURN private.schedule_follow_up(v_auth_uid, p_follow_up_id, p_due_at);
END;
$$;

REVOKE ALL ON FUNCTION public.schedule_follow_up(uuid, timestamptz) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.schedule_follow_up(uuid, timestamptz) TO authenticated;
