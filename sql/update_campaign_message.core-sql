-- Private implementation
CREATE OR REPLACE FUNCTION private.update_campaign_message(
  p_caller_auth_uid uuid,
  p_campaign_id uuid,
  p_message_body text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_campaign record;
BEGIN
  -- Try owner
  SELECT id INTO v_org_id FROM public.organizations WHERE owner_id = p_caller_auth_uid;
  -- If not owner, try marketer
  IF v_org_id IS NULL THEN
    SELECT su.org_id INTO v_org_id
    FROM public.staff_users su
    JOIN public.staff_roles sr ON sr.staff_user_id = su.id
    WHERE su.auth_uid = p_caller_auth_uid
      AND su.is_active AND NOT su.is_deleted
      AND sr.role = 'marketer';
  END IF;
  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Load campaign
  SELECT id, status
  INTO v_campaign
  FROM public.sms_campaigns
  WHERE id = p_campaign_id
    AND org_id = v_org_id;

  IF v_campaign IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Campaign not found');
  END IF;

  -- Guard: must be in ready status
  IF v_campaign.status <> 'ready' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Campaign must be in ready status to update message');
  END IF;

  -- Validate message length
  IF length(p_message_body) < 1 OR length(p_message_body) > 480 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Message must be between 1 and 480 characters');
  END IF;

  -- Update message
  UPDATE public.sms_campaigns
  SET message_body = p_message_body
  WHERE id = p_campaign_id;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.update_campaign_message(
  p_campaign_id uuid,
  p_message_body text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid uuid;
BEGIN
  v_uid := auth.uid();
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;

  RETURN private.update_campaign_message(v_uid, p_campaign_id, p_message_body);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.update_campaign_message(uuid, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.update_campaign_message(uuid, text) TO authenticated;
