-- Private implementation
CREATE OR REPLACE FUNCTION private.decline_phone_verification(
  p_visit_id uuid,
  p_session_token uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
BEGIN
  -- Look up visit
  SELECT v.id, v.session_token, v.phone_verification_pending, v.org_id, v.location_id
  INTO v_visit
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  -- Validate session token
  IF v_visit.session_token <> p_session_token THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid session');
  END IF;

  -- Must have pending verification
  IF NOT v_visit.phone_verification_pending THEN
    RETURN jsonb_build_object('success', false, 'error', 'No pending phone verification');
  END IF;

  -- Clear pending flag (re-enables receptionist buttons via Postgres Changes)
  UPDATE public.visits
  SET phone_verification_pending = false
  WHERE id = p_visit_id;

  -- Audit trail
  INSERT INTO public.audit_trail (org_id, location_id, actor_type, action, entity_type, entity_id, details)
  VALUES (
    v_visit.org_id,
    v_visit.location_id,
    'patient',
    'phone_verification_declined',
    'visit',
    p_visit_id,
    jsonb_build_object('reason', 'no_phone')
  );

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper (anon-callable)
CREATE OR REPLACE FUNCTION public.decline_phone_verification(
  p_visit_id uuid,
  p_session_token uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  RETURN private.decline_phone_verification(p_visit_id, p_session_token);
END;
$$;
