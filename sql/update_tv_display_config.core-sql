-- update_tv_display_config: owner updates the 5 TV display scalar settings on a location.

CREATE OR REPLACE FUNCTION private.update_tv_display_config(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_mode text,
  p_position text,
  p_overlay_visible boolean,
  p_queue_duration_seconds int,
  p_audio_muted boolean
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
BEGIN
  IF p_mode NOT IN ('none','alternating','batched') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid display mode.');
  END IF;
  IF p_position NOT IN ('top-left','top-right') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid overlay position.');
  END IF;
  IF p_queue_duration_seconds IS NULL OR p_queue_duration_seconds < 3 OR p_queue_duration_seconds > 60 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Queue duration must be between 3 and 60 seconds.');
  END IF;

  SELECT l.org_id INTO v_org_id FROM public.locations l WHERE l.id = p_location_id;
  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found.');
  END IF;

  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;
  IF p_caller_auth_uid IS NULL OR p_caller_auth_uid <> v_owner_id THEN
    RETURN jsonb_build_object('success', false, 'error', 'Only the owner can manage TV display settings.');
  END IF;

  UPDATE public.locations
     SET tv_display_mode = p_mode,
         tv_overlay_position = p_position,
         tv_overlay_visible = p_overlay_visible,
         tv_queue_duration_seconds = p_queue_duration_seconds,
         tv_audio_muted = p_audio_muted
   WHERE id = p_location_id;

  RETURN jsonb_build_object('success', true);
END;
$$;

CREATE OR REPLACE FUNCTION public.update_tv_display_config(
  p_location_id uuid,
  p_mode text,
  p_position text,
  p_overlay_visible boolean,
  p_queue_duration_seconds int,
  p_audio_muted boolean
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid;
BEGIN
  v_auth_uid := auth.uid();
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.update_tv_display_config(
    v_auth_uid, p_location_id, p_mode, p_position, p_overlay_visible, p_queue_duration_seconds, p_audio_muted
  );
END;
$$;

REVOKE ALL ON FUNCTION public.update_tv_display_config(uuid, text, text, boolean, int, boolean) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.update_tv_display_config(uuid, text, text, boolean, int, boolean) TO authenticated;
