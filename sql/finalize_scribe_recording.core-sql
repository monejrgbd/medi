-- finalize_scribe_recording: doctor pressed Stop. Creates the SOAP clinical
-- document (reusing private.create_document) only now that real audio exists,
-- flips the recording to 'transcribing', and fires the transcribe-encounter
-- edge function (fire-and-forget, mirrors draft_document_content). If no audio
-- was captured, no document is created (no orphan).

-- Private implementation
CREATE OR REPLACE FUNCTION private.finalize_scribe_recording(
  p_caller_auth_uid uuid,
  p_recording_id uuid,
  p_segment_count int,
  p_duration_ms int
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_caller_staff_id uuid;
  v_caller_org_id uuid;
  v_owner_id uuid;
  v_rec record;
  v_has_role boolean := false;
  v_doc_result jsonb;
  v_document_id uuid;
  v_edge_url text;
  v_edge_secret text;
  v_anon_key text;
BEGIN
  SELECT su.id, su.org_id
  INTO v_caller_staff_id, v_caller_org_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_caller_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff account not found');
  END IF;

  SELECT id, org_id, location_id, visit_id, patient_id, created_by, status
  INTO v_rec
  FROM public.scribe_recordings
  WHERE id = p_recording_id;

  IF v_rec.id IS NULL OR v_rec.org_id <> v_caller_org_id THEN
    RETURN jsonb_build_object('success', false, 'error', 'Recording not found');
  END IF;

  IF v_rec.status NOT IN ('consented', 'recording') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Recording already finalized');
  END IF;

  -- Authorization: creator OR owner OR doctor/nurse at the location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_caller_org_id;

  IF v_owner_id = p_caller_auth_uid OR v_rec.created_by = v_caller_staff_id THEN
    NULL;
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.location_id = v_rec.location_id
        AND sr.role IN ('doctor', 'nurse')
    ) INTO v_has_role;

    IF NOT v_has_role THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- No audio: no document, terminal failure
  IF COALESCE(p_segment_count, 0) <= 0 THEN
    UPDATE public.scribe_recordings
    SET status = 'failed', error = 'no_audio', segment_count = 0, updated_at = now()
    WHERE id = p_recording_id;

    INSERT INTO public.audit_trail (org_id, location_id, entity_type, entity_id, actor_id, actor_type, action, details)
    VALUES (v_caller_org_id, v_rec.location_id, 'scribe_recording', p_recording_id,
            v_caller_staff_id, 'doctor', 'scribe_failed',
            jsonb_build_object('reason', 'no_audio'));

    RETURN jsonb_build_object('success', false, 'error', 'no_audio');
  END IF;

  -- Create the SOAP document now (reuse the existing pipeline)
  v_doc_result := private.create_document(
    p_caller_auth_uid, v_rec.visit_id, v_rec.patient_id, v_rec.location_id,
    'clinical_note_soap', '{}'::jsonb
  );

  IF NOT COALESCE((v_doc_result->>'success')::boolean, false) THEN
    UPDATE public.scribe_recordings
    SET status = 'failed',
        error = COALESCE(v_doc_result->>'error', 'document_create_failed'),
        segment_count = p_segment_count,
        updated_at = now()
    WHERE id = p_recording_id;
    RETURN jsonb_build_object('success', false,
      'error', COALESCE(v_doc_result->>'error', 'document_create_failed'));
  END IF;

  v_document_id := (v_doc_result->>'document_id')::uuid;

  -- Vault secrets (same three draft_document_content reads)
  SELECT decrypted_secret INTO v_edge_url FROM vault.decrypted_secrets WHERE name = 'edge_function_url';
  SELECT decrypted_secret INTO v_edge_secret FROM vault.decrypted_secrets WHERE name = 'internal_edge_secret';
  SELECT decrypted_secret INTO v_anon_key FROM vault.decrypted_secrets WHERE name = 'supabase_anon_key';

  IF v_edge_url IS NULL OR v_edge_secret IS NULL OR v_anon_key IS NULL THEN
    UPDATE public.scribe_recordings
    SET status = 'failed', error = 'configuration_missing',
        document_id = v_document_id, segment_count = p_segment_count, updated_at = now()
    WHERE id = p_recording_id;
    RETURN jsonb_build_object('success', false, 'error', 'Configuration missing');
  END IF;

  UPDATE public.scribe_recordings
  SET document_id = v_document_id,
      status = 'transcribing',
      segment_count = p_segment_count,
      duration_ms = p_duration_ms,
      updated_at = now()
  WHERE id = p_recording_id;

  -- Fire-and-forget transcription (mirrors draft_document_content)
  PERFORM net.http_post(
    url := v_edge_url || '/transcribe-encounter',
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
      'Authorization', 'Bearer ' || v_anon_key,
      'x-internal-secret', v_edge_secret
    ),
    body := jsonb_build_object('recording_id', p_recording_id)
  );

  INSERT INTO public.audit_trail (org_id, location_id, entity_type, entity_id, actor_id, actor_type, action, details)
  VALUES (v_caller_org_id, v_rec.location_id, 'scribe_recording', p_recording_id,
          v_caller_staff_id, 'doctor', 'scribe_transcription_requested',
          jsonb_build_object('document_id', v_document_id, 'segment_count', p_segment_count));

  RETURN jsonb_build_object('success', true, 'document_id', v_document_id);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.finalize_scribe_recording(
  p_recording_id uuid,
  p_segment_count int,
  p_duration_ms int
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.finalize_scribe_recording(v_auth_uid, p_recording_id, p_segment_count, p_duration_ms);
END;
$$;

REVOKE ALL ON FUNCTION public.finalize_scribe_recording(uuid, int, int) FROM PUBLIC;
REVOKE EXECUTE ON FUNCTION public.finalize_scribe_recording(uuid, int, int) FROM anon;
GRANT EXECUTE ON FUNCTION public.finalize_scribe_recording(uuid, int, int) TO authenticated;
