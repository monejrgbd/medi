-- private.get_visit_status
-- Simple status lookup for a visit, used by demo to restore step on reload
CREATE OR REPLACE FUNCTION private.get_visit_status(
  p_caller_auth_uid uuid,
  p_visit_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_status text;
  v_org_id uuid;
  v_nurse_reviewed boolean;
BEGIN
  SELECT v.status, v.org_id, v.nurse_reviewed INTO v_status, v_org_id, v_nurse_reviewed
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_status IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  -- Verify caller belongs to same org
  IF NOT EXISTS (
    SELECT 1 FROM public.staff_users su
    WHERE su.auth_uid = p_caller_auth_uid
      AND su.org_id = v_org_id
      AND su.is_active = true
      AND su.is_deleted = false
  ) AND NOT EXISTS (
    SELECT 1 FROM public.organizations o
    WHERE o.id = v_org_id AND o.owner_id = p_caller_auth_uid
  ) THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  RETURN jsonb_build_object('success', true, 'status', v_status, 'nurse_reviewed', COALESCE(v_nurse_reviewed, false));
END;
$$;

-- public.get_visit_status (wrapper)
CREATE OR REPLACE FUNCTION public.get_visit_status(p_visit_id uuid)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid uuid;
BEGIN
  v_uid := auth.uid();
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.get_visit_status(v_uid, p_visit_id);
END;
$$;

REVOKE ALL ON FUNCTION public.get_visit_status(uuid) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.get_visit_status(uuid) TO authenticated;
