-- Private implementation: returns up to 3 most recently used distinct rooms for the caller
CREATE OR REPLACE FUNCTION private.get_recent_staff_rooms(
  p_caller_auth_uid uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_staff_user_id uuid;
  v_rooms jsonb;
BEGIN
  SELECT su.id INTO v_staff_user_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_staff_user_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user not found');
  END IF;

  SELECT COALESCE(jsonb_agg(current_room ORDER BY last_used DESC), '[]'::jsonb) INTO v_rooms
  FROM (
    SELECT current_room, last_used FROM (
      SELECT DISTINCT ON (current_room) current_room, checked_in_at AS last_used
      FROM public.staff_checkins
      WHERE staff_user_id = v_staff_user_id
        AND current_room IS NOT NULL
        AND btrim(current_room) <> ''
      ORDER BY current_room, checked_in_at DESC
    ) distinct_rooms
    ORDER BY last_used DESC
    LIMIT 3
  ) top_three;

  RETURN jsonb_build_object('success', true, 'rooms', v_rooms);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_recent_staff_rooms()
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.get_recent_staff_rooms(v_auth_uid);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.get_recent_staff_rooms() FROM anon;
GRANT EXECUTE ON FUNCTION public.get_recent_staff_rooms() TO authenticated;
