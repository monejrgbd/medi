-- Trigger function: sends async HTTP call to broadcast edge function on visit status change
CREATE OR REPLACE FUNCTION private.notify_visit_status_change()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_edge_url text;
  v_secret text;
  v_anon_key text;
BEGIN
  -- Read from Supabase Vault
  SELECT decrypted_secret INTO v_edge_url
  FROM vault.decrypted_secrets WHERE name = 'edge_function_url';

  SELECT decrypted_secret INTO v_secret
  FROM vault.decrypted_secrets WHERE name = 'internal_edge_secret';

  SELECT decrypted_secret INTO v_anon_key
  FROM vault.decrypted_secrets WHERE name = 'supabase_anon_key';

  -- Only fire if edge function is configured
  IF v_edge_url IS NOT NULL AND v_edge_url <> '' AND v_secret IS NOT NULL AND v_secret <> '' AND v_anon_key IS NOT NULL THEN
    PERFORM net.http_post(
      url := v_edge_url || '/broadcast-visit-update',
      headers := jsonb_build_object(
        'Content-Type', 'application/json',
        'Authorization', 'Bearer ' || v_anon_key,
        'x-internal-secret', v_secret
      ),
      body := jsonb_build_object(
        'visit_id', NEW.id,
        'session_token', NEW.session_token,
        'old_status', OLD.status,
        'new_status', NEW.status,
        'location_id', NEW.location_id,
        'timeout_flagged', NEW.timeout_flagged,
        'staff_room', NEW.staff_room
      )
    );
  END IF;

  RETURN NEW;
END;
$$;

-- Trigger: fires when status OR staff_room changes so the patient claimed
-- screen gets the room in the same broadcast that transitions state, and
-- mid-shift room edits propagate without waiting for the 5s poll fallback.
DROP TRIGGER IF EXISTS trg_visit_broadcast ON public.visits;
CREATE TRIGGER trg_visit_broadcast
  AFTER UPDATE OF status, staff_room ON public.visits
  FOR EACH ROW
  WHEN (
    OLD.status IS DISTINCT FROM NEW.status
    OR OLD.staff_room IS DISTINCT FROM NEW.staff_room
  )
  EXECUTE FUNCTION private.notify_visit_status_change();
