-- Private implementation
CREATE OR REPLACE FUNCTION private.toggle_location_addon(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_addon_type text,
  p_enabled boolean
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_org record;
  v_is_owner boolean := false;
  v_is_manager boolean := false;
BEGIN
  -- Validate addon type
  IF p_addon_type NOT IN ('review_sms', 'followup_sms') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid addon type');
  END IF;

  -- Get location's org
  SELECT org_id INTO v_org_id
  FROM public.locations
  WHERE id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Check if caller is owner
  SELECT id, subscription_plan
  INTO v_org
  FROM public.organizations
  WHERE id = v_org_id AND owner_id = p_caller_auth_uid;

  IF v_org IS NOT NULL THEN
    v_is_owner := true;
  ELSE
    -- Check if caller is manager at this location
    SELECT o.id, o.subscription_plan
    INTO v_org
    FROM public.organizations o
    WHERE o.id = v_org_id;

    IF EXISTS (
      SELECT 1
      FROM public.staff_roles sr
      JOIN public.staff_users su ON su.id = sr.staff_user_id
      WHERE sr.location_id = p_location_id
        AND sr.role = 'manager'
        AND su.auth_uid = p_caller_auth_uid
        AND su.is_active = true
        AND su.is_deleted = false
    ) THEN
      v_is_manager := true;
    END IF;
  END IF;

  IF NOT v_is_owner AND NOT v_is_manager THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Guard: blocked plans
  IF v_org.subscription_plan IN ('expired', 'suspended', 'read_only') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Cannot modify addons while account is ' || v_org.subscription_plan);
  END IF;

  -- Toggle the addon on the location
  IF p_addon_type = 'review_sms' THEN
    UPDATE public.locations SET review_sms_enabled = p_enabled WHERE id = p_location_id;
  ELSIF p_addon_type = 'followup_sms' THEN
    UPDATE public.locations SET followup_sms_enabled = p_enabled WHERE id = p_location_id;

    -- If enabling followup_sms and no config exists, insert default
    IF p_enabled AND NOT EXISTS (
      SELECT 1 FROM public.followup_sms_config WHERE org_id = v_org_id
    ) THEN
      INSERT INTO public.followup_sms_config (org_id, max_reminders, first_reminder_days, second_reminder_days)
      VALUES (v_org_id, 2, 3, 7)
      ON CONFLICT (org_id) DO NOTHING;
    END IF;
  END IF;

  INSERT INTO public.audit_trail (org_id, actor_id, actor_type, action, entity_type, entity_id, details)
  VALUES (v_org_id, p_caller_auth_uid,
    CASE WHEN v_is_owner THEN 'owner' ELSE 'manager' END,
    'toggle_location_addon', 'location', p_location_id,
    jsonb_build_object('addon', p_addon_type, 'enabled', p_enabled));

  RETURN jsonb_build_object('success', true, 'addon', p_addon_type, 'enabled', p_enabled);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.toggle_location_addon(
  p_location_id uuid,
  p_addon_type text,
  p_enabled boolean
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid uuid;
BEGIN
  v_uid := auth.uid();
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;

  RETURN private.toggle_location_addon(v_uid, p_location_id, p_addon_type, p_enabled);
END;
$$;

REVOKE ALL ON FUNCTION public.toggle_location_addon(uuid, text, boolean) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.toggle_location_addon(uuid, text, boolean) TO authenticated;
