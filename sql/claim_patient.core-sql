-- Private implementation
CREATE OR REPLACE FUNCTION private.claim_patient(
  p_caller_auth_uid uuid,
  p_visit_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_org_id uuid;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_can_access boolean := false;
  v_nurse_enabled boolean;
  v_nurse_first boolean;
  v_locked record;
  v_edge_url text;
  v_edge_secret text;
  v_staff_room text;
  -- v_claimer_name removed (m10: don't leak doctor names)
BEGIN
  -- Get visit details
  SELECT v.id, v.status, v.claimed_by, v.location_id, v.org_id, v.nurse_reviewed, v.ai_completed_at, v.ai_summary, v.ai_diagnostic
  INTO v_visit
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  -- Get caller staff id
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.org_id = v_visit.org_id
    AND su.is_active = true
    AND su.is_deleted = false;

  -- Authorization: owner or doctor/nurse at visit location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_visit.org_id;

  -- Fetch nurse settings from location
  SELECT l.nurse_enabled, l.nurse_first_workflow
    INTO v_nurse_enabled, v_nurse_first
  FROM public.locations l WHERE l.id = v_visit.location_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can claim
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.location_id = v_visit.location_id
        AND (sr.role = 'doctor' OR (sr.role = 'nurse' AND v_nurse_enabled = true))
    ) INTO v_can_access;

    IF NOT v_can_access THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Nurse double-review guard: if caller is nurse and visit already nurse_reviewed, block
  IF v_visit.nurse_reviewed = true AND v_owner_id <> p_caller_auth_uid THEN
    IF EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'nurse'
        AND sr.location_id = v_visit.location_id
      AND NOT EXISTS(
        SELECT 1 FROM public.staff_roles sr2
        WHERE sr2.staff_user_id = v_caller_staff_id
          AND sr2.role = 'doctor'
          AND sr2.location_id = v_visit.location_id
      )
    ) THEN
      RETURN jsonb_build_object('success', false, 'error', 'Already reviewed by nurse');
    END IF;
  END IF;

  -- Nurse-first guard: at locations with nurse_first_workflow=true, doctors
  -- (without nurse role at the location) cannot claim patients who have not
  -- been nurse-reviewed yet. Owners are exempt.
  IF v_nurse_first IS TRUE
    AND v_visit.nurse_reviewed = false
    AND v_owner_id <> p_caller_auth_uid
  THEN
    IF NOT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'nurse'
        AND sr.location_id = v_visit.location_id
    ) THEN
      RETURN jsonb_build_object(
        'success', false,
        'error', 'This location requires nurse review before a doctor can claim',
        'code', 'nurse_first_required'
      );
    END IF;
  END IF;

  -- Staff record required to claim (prevents NULL claimed_by)
  IF v_caller_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff account required to claim patients');
  END IF;

  -- Try to lock the visit row (SKIP LOCKED = non-blocking)
  SELECT id, status, claimed_by
  INTO v_locked
  FROM public.visits
  WHERE id = p_visit_id
  FOR UPDATE SKIP LOCKED;

  -- If lock not acquired, someone else has it
  IF v_locked IS NULL THEN
    RETURN jsonb_build_object(
      'success', false,
      'already_claimed', true,
      'claimed_by_name', 'Another doctor'
    );
  END IF;

  -- Validate status
  IF v_locked.status <> 'waiting_doctor_claim' THEN
    IF v_locked.claimed_by IS NOT NULL THEN
      RETURN jsonb_build_object(
        'success', false,
        'already_claimed', true,
        'claimed_by_name', 'Another doctor'
      );
    END IF;
    RETURN jsonb_build_object('success', false, 'error', 'Visit is not in queue');
  END IF;

  -- Set audit context
  PERFORM set_config('app.audit_actor_id', COALESCE(v_caller_staff_id::text, p_caller_auth_uid::text), true);
  PERFORM set_config('app.audit_actor_type',
    CASE
      WHEN v_owner_id = p_caller_auth_uid THEN 'owner'
      WHEN EXISTS(SELECT 1 FROM public.staff_roles WHERE staff_user_id = v_caller_staff_id AND role = 'nurse' AND location_id = v_visit.location_id) THEN 'nurse'
      ELSE 'doctor'
    END, true);
  PERFORM set_config('app.audit_action', 'claimed', true);

  -- Snapshot caller's current room (FOR UPDATE serializes against set_staff_room so
  -- the cache on visits.staff_room stays consistent under concurrent edits)
  SELECT current_room INTO v_staff_room
  FROM public.staff_checkins
  WHERE staff_user_id = v_caller_staff_id
    AND role IN ('doctor', 'nurse')
    AND checked_out_at IS NULL
  ORDER BY checked_in_at DESC
  LIMIT 1
  FOR UPDATE;

  -- Claim the visit
  UPDATE public.visits
  SET status = 'claimed_by_doctor',
      claimed_by = v_caller_staff_id,
      claimed_at = now(),
      staff_room = v_staff_room
  WHERE id = p_visit_id;

  -- Two possible recovery triggers, gated independently:
  --   1. Backwards-compat fallback: if a previous generate-summary call failed and
  --      ai_summary is still NULL, retry on claim with the default "full" mode. With the
  --      new ai-conversation flow this should be rare (summary fires on AI complete) but
  --      keeps the system self-healing.
  --   2. Doctor-direct diagnostic (Rule C): if a doctor (with no nurse role at this
  --      location) claims a nurse-enabled visit before any nurse touched it, the diagnostic
  --      was deliberately deferred at AI-complete time. Fire it now in diagnostic_only mode
  --      so the doctor isn't stuck without a diagnostic suggestion.
  DECLARE
    v_anon_key text;
    v_caller_is_nurse_only boolean := false;
    v_caller_has_nurse_role boolean := false;
  BEGIN
    SELECT decrypted_secret INTO v_edge_url FROM vault.decrypted_secrets WHERE name = 'edge_function_url';
    SELECT decrypted_secret INTO v_edge_secret FROM vault.decrypted_secrets WHERE name = 'internal_edge_secret';
    SELECT decrypted_secret INTO v_anon_key FROM vault.decrypted_secrets WHERE name = 'supabase_anon_key';

    -- Trigger 1: backwards-compat full-mode summary if missing
    IF v_visit.ai_completed_at IS NOT NULL AND v_visit.ai_summary IS NULL THEN
      IF v_edge_url IS NOT NULL AND v_edge_secret IS NOT NULL AND v_anon_key IS NOT NULL THEN
        BEGIN
          PERFORM net.http_post(
            url := v_edge_url || '/generate-summary',
            headers := jsonb_build_object(
              'Content-Type', 'application/json',
              'Authorization', 'Bearer ' || v_anon_key,
              'x-internal-secret', v_edge_secret
            ),
            body := jsonb_build_object('visit_id', p_visit_id, 'mode', 'full')
          );
        EXCEPTION WHEN OTHERS THEN
          RAISE WARNING 'generate-summary fallback trigger failed: %', SQLERRM;
        END;
      END IF;
    END IF;

    -- Trigger 2: doctor-direct diagnostic for nurse-enabled visit (Rule C).
    -- Caller is "doctor only" if they have a doctor role at the location AND no nurse role
    -- there. Owners (no staff_roles row) are also treated as doctor (matches audit logic).
    IF v_visit.ai_diagnostic IS NULL AND v_visit.ai_summary IS NOT NULL AND v_nurse_enabled = true THEN
      SELECT EXISTS(
        SELECT 1 FROM public.staff_roles
        WHERE staff_user_id = v_caller_staff_id
          AND role = 'nurse'
          AND location_id = v_visit.location_id
      ) INTO v_caller_has_nurse_role;

      v_caller_is_nurse_only := v_caller_has_nurse_role;
      -- Owner with no staff record: definitely not a nurse claim
      IF v_caller_staff_id IS NULL THEN
        v_caller_is_nurse_only := false;
      END IF;

      IF NOT v_caller_is_nurse_only AND v_edge_url IS NOT NULL AND v_edge_secret IS NOT NULL AND v_anon_key IS NOT NULL THEN
        BEGIN
          PERFORM net.http_post(
            url := v_edge_url || '/generate-summary',
            headers := jsonb_build_object(
              'Content-Type', 'application/json',
              'Authorization', 'Bearer ' || v_anon_key,
              'x-internal-secret', v_edge_secret
            ),
            body := jsonb_build_object('visit_id', p_visit_id, 'mode', 'diagnostic_only')
          );
        EXCEPTION WHEN OTHERS THEN
          RAISE WARNING 'generate-summary diagnostic_only trigger failed in claim_patient: %', SQLERRM;
        END;
      END IF;
    END IF;
  END;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.claim_patient(
  p_visit_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.claim_patient(v_auth_uid, p_visit_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.claim_patient(uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.claim_patient(uuid) TO authenticated;
