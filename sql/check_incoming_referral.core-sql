-- Private implementation
CREATE OR REPLACE FUNCTION private.check_incoming_referral(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_first_name text,
  p_last_name text,
  p_birthday date
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_is_authorized boolean := false;
  v_referral record;
BEGIN
  -- Get location org
  SELECT l.org_id INTO v_org_id
  FROM public.locations l
  WHERE l.id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Get caller staff id
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.org_id = v_org_id
    AND su.is_active = true
    AND su.is_deleted = false;

  -- Authorization: owner or receptionist/manager at this location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    v_is_authorized := true;
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role IN ('receptionist', 'manager')
        AND sr.location_id = p_location_id
    ) INTO v_is_authorized;
  END IF;

  IF NOT v_is_authorized THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Match referral
  SELECT r.id, r.specialty, org.name AS from_org_name, su.full_name AS from_doctor_name
  INTO v_referral
  FROM public.referrals r
  JOIN public.organizations org ON org.id = r.from_org_id
  JOIN public.staff_users su ON su.id = r.from_doctor_id
  WHERE lower(r.patient_name) = lower(p_first_name || ' ' || p_last_name)
    AND r.patient_birthday = p_birthday
    AND r.to_location_id = p_location_id
    AND r.status IN ('sent', 'viewed')
  ORDER BY r.created_at DESC
  LIMIT 1;

  IF v_referral IS NULL THEN
    RETURN jsonb_build_object('success', true, 'has_match', false);
  END IF;

  RETURN jsonb_build_object(
    'success', true,
    'has_match', true,
    'referral_id', v_referral.id,
    'specialty', v_referral.specialty,
    'from_org_name', v_referral.from_org_name,
    'from_doctor_name', v_referral.from_doctor_name
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.check_incoming_referral(
  p_location_id uuid,
  p_first_name text,
  p_last_name text,
  p_birthday date
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.check_incoming_referral(v_auth_uid, p_location_id, p_first_name, p_last_name, p_birthday);
END;
$$;

REVOKE ALL ON FUNCTION public.check_incoming_referral(uuid, text, text, date) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.check_incoming_referral(uuid, text, text, date) TO authenticated;
