-- Links an organization to the partner who introduced it (one row per clinic, first-touch).
-- partner_id + org_id pairing is permanent once attributed.
CREATE TABLE public.partner_referrals (
  id                  uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  partner_id          uuid NOT NULL REFERENCES public.partners(id),
  org_id              uuid NOT NULL UNIQUE REFERENCES public.organizations(id),
  code_used           text NOT NULL,
  code_type           text NOT NULL CHECK (code_type IN ('affiliate','premium_trial')),
  affiliate_code_id   uuid REFERENCES public.affiliate_codes(id),
  approval_code_id    uuid REFERENCES public.approval_codes(id),
  attributed_at       timestamptz NOT NULL DEFAULT now(),
  first_payment_at    timestamptz,
  signup_ip_hash      text
);

ALTER TABLE public.partner_referrals ENABLE ROW LEVEL SECURITY;

CREATE POLICY "partner_self_read_referrals" ON public.partner_referrals FOR SELECT
  USING (partner_id IN (SELECT id FROM public.partners WHERE auth_uid = auth.uid()));

CREATE INDEX idx_partner_referrals_partner ON public.partner_referrals (partner_id, attributed_at DESC);
CREATE INDEX idx_partner_referrals_partner_code ON public.partner_referrals (partner_id, code_used);
