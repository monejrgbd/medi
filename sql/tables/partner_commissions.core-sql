-- Per-payment commission ledger. Negative amounts are clawback offsets that net out at payout time.
-- Idempotency keyed on payment_event_id (synthesized for clawbacks: '<sale_id>:refund:<refund_id>').
CREATE TABLE public.partner_commissions (
  id                       uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  partner_id               uuid NOT NULL REFERENCES public.partners(id),
  referral_id              uuid NOT NULL REFERENCES public.partner_referrals(id),
  org_id                   uuid NOT NULL REFERENCES public.organizations(id),
  payment_amount_cents     bigint NOT NULL,
  commission_amount_cents  bigint NOT NULL,
  commission_rate          numeric(5,4) NOT NULL,
  payment_event_id         text NOT NULL UNIQUE,
  parent_commission_id     uuid REFERENCES public.partner_commissions(id),
  payment_date             timestamptz NOT NULL,
  eligible_for_payout_at   timestamptz NOT NULL,
  status                   text NOT NULL DEFAULT 'pending'
                           CHECK (status IN ('pending','paid','clawed_back')),
  payout_id                uuid,
  created_at               timestamptz NOT NULL DEFAULT now()
);

ALTER TABLE public.partner_commissions ENABLE ROW LEVEL SECURITY;

CREATE POLICY "partner_self_read_commissions" ON public.partner_commissions FOR SELECT
  USING (partner_id IN (SELECT id FROM public.partners WHERE auth_uid = auth.uid()));

CREATE INDEX idx_partner_commissions_partner_pending
  ON public.partner_commissions (partner_id, eligible_for_payout_at)
  WHERE status = 'pending';
CREATE INDEX idx_partner_commissions_org_status
  ON public.partner_commissions (org_id, status);
CREATE INDEX idx_partner_commissions_partner_created
  ON public.partner_commissions (partner_id, created_at DESC);
