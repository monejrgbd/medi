CREATE TABLE public.locations (
  id                    uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  org_id                uuid NOT NULL REFERENCES public.organizations(id),
  name                  text NOT NULL,
  address               text,
  operating_hours       jsonb,
  specialty             text,
  logo_url              text,
  qr_code_url           text,
  ai_model              text DEFAULT 'standard'
    CHECK (ai_model = ANY (ARRAY['standard', 'advanced', 'precision', 'premium'])),
  display_format        text DEFAULT 'summary'
    CHECK (display_format = ANY (ARRAY['summary', 'structured_card'])),
  referral_email        text,
  tablet_count          int DEFAULT 0,
  timezone              text DEFAULT 'America/Toronto',
  estimated_wait_minutes numeric DEFAULT NULL,
  review_sms_enabled    boolean DEFAULT true,
  diagnostic_enabled    boolean DEFAULT true,
  nurse_enabled         boolean DEFAULT false,
  nurse_first_workflow  boolean DEFAULT false,
  vaccines_enabled      boolean DEFAULT true,
  vitals_enabled        boolean DEFAULT true,
  ai_custom_instructions text DEFAULT NULL,
  ai_message_limit      integer DEFAULT NULL
    CHECK (ai_message_limit IS NULL OR (ai_message_limit >= 10 AND ai_message_limit <= 50)),
  skip_ai               boolean DEFAULT false,
  ask_referral_source   boolean DEFAULT false,
  ask_discovery_source  boolean DEFAULT false,
  queue_display_enabled boolean DEFAULT false,
  show_doctor_room_to_patients boolean NOT NULL DEFAULT true,
  preset_rooms          text[] NOT NULL DEFAULT '{}',
  queue_type            text NOT NULL DEFAULT 'fifo'
    CHECK (queue_type IN ('fifo', 'priority', 'appointment_priority', 'appointment_fifo', 'critical_appointment_fifo')),
  checkin_mode          text NOT NULL DEFAULT 'approve_to_start'
    CHECK (checkin_mode IN ('approve_to_start', 'approve_on_arrival', 'self_service_on_arrival')),
  raven_api_key         text DEFAULT NULL,
  created_at            timestamptz DEFAULT now()
);

-- TV display columns (lobby video playlist feature)
ALTER TABLE public.locations
  ADD COLUMN IF NOT EXISTS tv_display_mode text NOT NULL DEFAULT 'none'
    CHECK (tv_display_mode IN ('none','alternating','batched')),
  ADD COLUMN IF NOT EXISTS tv_overlay_position text NOT NULL DEFAULT 'top-left'
    CHECK (tv_overlay_position IN ('top-left','top-right')),
  ADD COLUMN IF NOT EXISTS tv_overlay_visible boolean NOT NULL DEFAULT true,
  ADD COLUMN IF NOT EXISTS tv_queue_duration_seconds int NOT NULL DEFAULT 10
    CHECK (tv_queue_duration_seconds BETWEEN 3 AND 60),
  ADD COLUMN IF NOT EXISTS tv_audio_muted boolean NOT NULL DEFAULT true,
  ADD COLUMN IF NOT EXISTS always_accepting_checkins boolean DEFAULT false;

ALTER TABLE public.locations ENABLE ROW LEVEL SECURITY;

CREATE POLICY "org_staff_read_locations" ON public.locations FOR SELECT
  USING (org_id = requesting_org_id());
