CREATE TABLE public.document_access_log (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  document_id     uuid NOT NULL REFERENCES public.clinical_documents(id),
  accessed_at     timestamptz NOT NULL DEFAULT now(),
  ip_hash         text,
  user_agent      text,
  pin_verified    boolean NOT NULL DEFAULT false,
  result          text NOT NULL
    CHECK (result IN ('ok', 'expired', 'revoked', 'pin_required', 'pin_wrong', 'rate_limited', 'not_found'))
);

ALTER TABLE public.document_access_log ENABLE ROW LEVEL SECURITY;

CREATE POLICY "org_member_read" ON public.document_access_log FOR SELECT
  USING (
    document_id IN (
      SELECT id FROM public.clinical_documents WHERE org_id = requesting_org_id()
    )
  );

CREATE INDEX idx_doc_access_document ON public.document_access_log (document_id, accessed_at DESC);
CREATE INDEX idx_doc_access_rate_limit ON public.document_access_log (document_id, ip_hash, accessed_at)
  WHERE result = 'ok';
