-- Per-plan AI config for org-level tasks (document generation, marketing scan).
-- Separate from ai_model_config (per-tier, per-visit tasks).
-- 7 rows, one per subscription plan. Edited by platform super admin.
CREATE TABLE IF NOT EXISTS public.ai_plan_config (
  plan text PRIMARY KEY,

  -- Document generation (SOAP notes, letters, clinical docs)
  document_provider text NOT NULL DEFAULT 'anthropic'
    CHECK (document_provider IN ('anthropic', 'google_vertex', 'openai')),
  document_model text NOT NULL DEFAULT 'claude-haiku-4-5-20251001',
  document_model_display text NOT NULL DEFAULT 'Claude Haiku 4.5',
  document_max_tokens int NOT NULL DEFAULT 2000,
  document_temperature numeric NOT NULL DEFAULT 0.3,

  -- Marketing scan (AI patient targeting)
  scan_provider text NOT NULL DEFAULT 'anthropic'
    CHECK (scan_provider IN ('anthropic', 'google_vertex', 'openai')),
  scan_model text NOT NULL DEFAULT 'claude-haiku-4-5-20251001',
  scan_model_display text NOT NULL DEFAULT 'Claude Haiku 4.5',
  scan_max_tokens int NOT NULL DEFAULT 2048,
  scan_temperature numeric NOT NULL DEFAULT 0.3,

  updated_at timestamptz DEFAULT now(),
  updated_by uuid REFERENCES auth.users(id)
);

ALTER TABLE public.ai_plan_config ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "ai_plan_config_read" ON public.ai_plan_config;
CREATE POLICY "ai_plan_config_read" ON public.ai_plan_config
  FOR SELECT TO authenticated USING (true);

DROP POLICY IF EXISTS "ai_plan_config_write" ON public.ai_plan_config;
CREATE POLICY "ai_plan_config_write" ON public.ai_plan_config
  FOR ALL TO authenticated
  USING ((auth.jwt()->'app_metadata'->>'is_platform_admin')::boolean = true)
  WITH CHECK ((auth.jwt()->'app_metadata'->>'is_platform_admin')::boolean = true);

