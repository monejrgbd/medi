-- Server-side Google Ads offline conversion queue.
--
-- Mirrors pending_emails: written only by SECURITY DEFINER functions, drained
-- by the process-ad-conversions edge function (pg_cron). No client access.
--
-- UNIQUE(org_id): a Purchase conversion is uploaded at most ONCE per org (the
-- first real payment). This enforces "first payment only" and also makes the
-- enqueue idempotent against PayPal webhook redelivery and renewals.
CREATE TABLE public.pending_ad_conversions (
  id                uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  org_id            uuid NOT NULL UNIQUE REFERENCES public.organizations(id) ON DELETE CASCADE,
  gclid             text,
  gbraid            text,
  wbraid            text,
  conversion_action text NOT NULL,            -- logical key (e.g. 'purchase'); uploader maps to the Google Ads resource name
  value             numeric,
  currency          text,
  conversion_time   timestamptz NOT NULL DEFAULT now(),
  order_id          text,                     -- PayPal sale id that triggered it (traceability)
  user_data         jsonb,                    -- { email } for enhanced conversions for leads
  created_at        timestamptz NOT NULL DEFAULT now(),
  last_attempt_at   timestamptz,
  attempt_count     int NOT NULL DEFAULT 0,
  status            text NOT NULL DEFAULT 'pending'
    CHECK (status IN ('pending', 'sent', 'failed')),
  error_message     text,
  metadata          jsonb
);

CREATE INDEX idx_pending_ad_conversions_pending
  ON public.pending_ad_conversions (created_at)
  WHERE status = 'pending';

-- Server-only: RLS enabled with no policies (deny all clients), exactly like
-- pending_emails. All access is via SECURITY DEFINER functions.
ALTER TABLE public.pending_ad_conversions ENABLE ROW LEVEL SECURITY;
