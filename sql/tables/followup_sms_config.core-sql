CREATE TABLE IF NOT EXISTS public.followup_sms_config (
  org_id              uuid PRIMARY KEY REFERENCES public.organizations(id),
  reminder_template   text DEFAULT 'Hi {name}, you have a follow-up appointment due at {clinic}. Please call us to schedule.',
  max_reminders       int DEFAULT 2,
  first_reminder_days int DEFAULT 3,
  second_reminder_days int DEFAULT 7,
  created_at          timestamptz DEFAULT now()
);

ALTER TABLE public.followup_sms_config ENABLE ROW LEVEL SECURITY;

CREATE POLICY "owner_read_followup_sms_config" ON public.followup_sms_config FOR SELECT
  USING (org_id IN (SELECT id FROM public.organizations WHERE owner_id = auth.uid()));
