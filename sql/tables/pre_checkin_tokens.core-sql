CREATE TABLE IF NOT EXISTS public.pre_checkin_tokens (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  org_id          uuid NOT NULL REFERENCES public.organizations(id),
  location_id     uuid NOT NULL REFERENCES public.locations(id),
  first_name      text NOT NULL,
  last_name       text NOT NULL,
  created_by      uuid NOT NULL REFERENCES public.staff_users(id),
  token           uuid NOT NULL UNIQUE DEFAULT gen_random_uuid(),
  used            boolean NOT NULL DEFAULT false,
  visit_id        uuid REFERENCES public.visits(id),
  session_token   uuid,
  created_at      timestamptz NOT NULL DEFAULT now(),
  expires_at      timestamptz NOT NULL DEFAULT now() + interval '48 hours'
);

ALTER TABLE public.pre_checkin_tokens ENABLE ROW LEVEL SECURITY;

-- No direct access policies — all access via SECURITY DEFINER functions

CREATE INDEX IF NOT EXISTS idx_pre_checkin_tokens_token ON public.pre_checkin_tokens (token);
CREATE INDEX IF NOT EXISTS idx_pre_checkin_tokens_location ON public.pre_checkin_tokens (location_id, created_at DESC);
CREATE INDEX IF NOT EXISTS idx_pre_checkin_tokens_expires ON public.pre_checkin_tokens (expires_at) WHERE used = false;
