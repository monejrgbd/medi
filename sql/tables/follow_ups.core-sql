CREATE TABLE IF NOT EXISTS public.follow_ups (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  visit_id        uuid NOT NULL REFERENCES public.visits(id),
  patient_id      uuid NOT NULL REFERENCES public.patients(id),
  doctor_id       uuid NOT NULL REFERENCES public.staff_users(id),
  org_id          uuid NOT NULL REFERENCES public.organizations(id),
  location_id     uuid NOT NULL REFERENCES public.locations(id),
  timeframe_days  int CHECK (timeframe_days IS NULL OR (timeframe_days BETWEEN 1 AND 365)),
  due_at          timestamptz,
  ai_instructions text CHECK (length(ai_instructions) <= 2000),
  status          text NOT NULL DEFAULT 'active'
    CHECK (status IN ('active', 'completed', 'expired')),
  reminders_sent  int DEFAULT 0,
  sms_charged     boolean DEFAULT false,
  created_at      timestamptz DEFAULT now()
);

ALTER TABLE public.follow_ups ENABLE ROW LEVEL SECURITY;

CREATE POLICY "org_staff_read_follow_ups" ON public.follow_ups FOR SELECT
  USING (org_id = requesting_org_id());

CREATE INDEX idx_follow_ups_patient ON public.follow_ups (patient_id, status);
CREATE INDEX idx_follow_ups_due ON public.follow_ups (due_at, status) WHERE status = 'active';
CREATE INDEX idx_follow_ups_visit ON public.follow_ups (visit_id);
