CREATE TABLE IF NOT EXISTS public.doctor_note_preferences (
  doctor_id       uuid NOT NULL REFERENCES public.staff_users(id),
  patient_id      uuid NOT NULL REFERENCES public.patients(id),
  default_private boolean DEFAULT false,
  PRIMARY KEY (doctor_id, patient_id)
);

ALTER TABLE public.doctor_note_preferences ENABLE ROW LEVEL SECURITY;

CREATE POLICY "doctor_read_own_preferences" ON public.doctor_note_preferences FOR SELECT
  USING (doctor_id IN (SELECT su.id FROM public.staff_users su WHERE su.auth_uid = auth.uid()));
