CREATE TABLE IF NOT EXISTS public.email_captures (
  id                    uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
  email                 text        NOT NULL,
  source                text        NOT NULL DEFAULT 'homepage',
  nurture_email_sent_at timestamptz,
  created_at            timestamptz NOT NULL DEFAULT now()
);

-- Idempotent addition for environments where the table already exists
ALTER TABLE public.email_captures ADD COLUMN IF NOT EXISTS nurture_email_sent_at timestamptz;

CREATE INDEX IF NOT EXISTS idx_email_captures_email ON public.email_captures (email);

ALTER TABLE public.email_captures ENABLE ROW LEVEL SECURITY;
