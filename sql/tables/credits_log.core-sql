CREATE TABLE public.credits_log (
  id                    uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  org_id                uuid NOT NULL REFERENCES public.organizations(id),
  visit_id              uuid REFERENCES public.visits(id),
  credits_amount        numeric NOT NULL,
  ai_model              text,
  description           text,
  created_at            timestamptz DEFAULT now()
);

ALTER TABLE public.credits_log ENABLE ROW LEVEL SECURITY;

-- Owner-only SELECT (not all staff)
CREATE POLICY "owner_read_credits" ON public.credits_log FOR SELECT
  USING (org_id IN (SELECT o.id FROM public.organizations o WHERE o.owner_id = auth.uid()));

-- No INSERT/UPDATE/DELETE policies — mutations via SECURITY DEFINER only

CREATE INDEX idx_credits_log_org ON public.credits_log (org_id, created_at DESC);
CREATE UNIQUE INDEX idx_credits_log_visit_unique ON public.credits_log (visit_id) WHERE visit_id IS NOT NULL;
CREATE INDEX idx_credits_log_visit ON public.credits_log (visit_id);
