CREATE TABLE public.organizations (
  id                    uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  name                  text NOT NULL,
  slug                  text NOT NULL UNIQUE,
  owner_id              uuid NOT NULL REFERENCES auth.users(id),
  subscription_plan     text DEFAULT 'standard_trial'
    CHECK (subscription_plan = ANY (ARRAY[
      'standard_trial', 'premium_trial', 'starter', 'standard', 'plus',
      'enterprise', 'pay_as_you_go', 'expired', 'read_only', 'suspended'
    ])),
  credits_total         int DEFAULT 20,
  credits_used          numeric DEFAULT 0,
  trial_end_date        timestamptz,
  billing_cycle_start   timestamptz,
  paypal_subscription_id text,
  review_sms_addon      boolean DEFAULT false,
  followup_sms_addon    boolean DEFAULT false,
  last_credit_alert_at  timestamptz,
  trial_alert_sent      boolean DEFAULT false,
  payment_failure_count int DEFAULT 0,
  payment_first_failed_at timestamptz,
  cancelled_at          timestamptz,
  data_retention_until  timestamptz,
  created_at            timestamptz DEFAULT now()
);

ALTER TABLE public.organizations ENABLE ROW LEVEL SECURITY;

CREATE POLICY "org_member_read" ON public.organizations FOR SELECT
  USING (id = requesting_org_id());
