CREATE TABLE IF NOT EXISTS public.review_rotation (
  id                  uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  location_id         uuid NOT NULL REFERENCES public.locations(id) UNIQUE,
  org_id              uuid NOT NULL REFERENCES public.organizations(id),
  cycle_days          int DEFAULT 7 CHECK (cycle_days BETWEEN 1 AND 90),
  current_platform_id uuid REFERENCES public.review_platforms(id),
  last_rotated_at     timestamptz DEFAULT now(),
  created_at          timestamptz DEFAULT now()
);

ALTER TABLE public.review_rotation ENABLE ROW LEVEL SECURITY;

CREATE POLICY "org_staff_read_review_rotation" ON public.review_rotation FOR SELECT
  USING (org_id = requesting_org_id());
