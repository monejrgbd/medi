-- Private implementation
CREATE OR REPLACE FUNCTION private.get_referral_history(
  p_caller_auth_uid uuid,
  p_doctor_id uuid,
  p_limit int DEFAULT 20,
  p_cursor timestamptz DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_doctor record;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_limit int;
  v_rows jsonb;
  v_has_more boolean := false;
  v_row_count int;
BEGIN
  -- Get target doctor info
  SELECT su.id, su.auth_uid, su.org_id
  INTO v_doctor
  FROM public.staff_users su
  WHERE su.id = p_doctor_id
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_doctor IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Doctor not found');
  END IF;

  -- Get org owner
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_doctor.org_id;

  -- Authorization: the doctor themselves or org owner
  IF p_caller_auth_uid = v_doctor.auth_uid THEN
    NULL; -- Doctor viewing own history
  ELSIF p_caller_auth_uid = v_owner_id THEN
    NULL; -- Owner can view
  ELSE
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Clamp limit
  v_limit := LEAST(COALESCE(p_limit, 20), 100);

  -- Query referral history
  SELECT COALESCE(jsonb_agg(row_data), '[]'::jsonb)
  INTO v_rows
  FROM (
    SELECT jsonb_build_object(
      'id', r.id,
      'patient_name', r.patient_name,
      'specialty', r.specialty,
      'status', r.status,
      'destination', COALESCE(o.name, r.to_email),
      'created_at', r.created_at
    ) AS row_data
    FROM public.referrals r
    LEFT JOIN public.organizations o ON o.id = r.to_org_id
    WHERE r.from_doctor_id = p_doctor_id
      AND (p_cursor IS NULL OR r.created_at < p_cursor)
    ORDER BY r.created_at DESC
    LIMIT v_limit + 1
  ) sub;

  -- has_more detection
  v_row_count := jsonb_array_length(v_rows);

  IF v_row_count > v_limit THEN
    v_has_more := true;
    v_rows := v_rows - v_limit; -- Remove the extra element
  END IF;

  RETURN jsonb_build_object(
    'success', true,
    'referrals', v_rows,
    'has_more', v_has_more,
    'next_cursor', CASE
      WHEN v_has_more THEN (v_rows -> (jsonb_array_length(v_rows) - 1) ->> 'created_at')::text
      ELSE NULL
    END
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_referral_history(
  p_doctor_id uuid,
  p_limit int DEFAULT 20,
  p_cursor timestamptz DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.get_referral_history(v_auth_uid, p_doctor_id, p_limit, p_cursor);
END;
$$;

REVOKE ALL ON FUNCTION public.get_referral_history(uuid, int, timestamptz) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.get_referral_history(uuid, int, timestamptz) TO authenticated;
