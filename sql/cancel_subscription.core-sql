-- Private implementation
CREATE OR REPLACE FUNCTION private.cancel_subscription(
  p_caller_auth_uid uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org record;
  v_owner_email text;
  v_end_date timestamptz;
BEGIN
  -- Lock org and verify ownership
  SELECT id, subscription_plan, name, owner_id, billing_cycle_start, cancel_at_period_end, current_period_end
  INTO v_org
  FROM public.organizations
  WHERE owner_id = p_caller_auth_uid
  FOR UPDATE;

  IF v_org IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Guard: already cancelled/suspended/expired
  IF v_org.subscription_plan IN ('expired', 'suspended') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Subscription is already ' || v_org.subscription_plan);
  END IF;

  -- Guard: already pending cancel
  IF v_org.cancel_at_period_end IS NOT NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Cancellation already scheduled');
  END IF;

  -- Calculate period end date (use current_period_end for correct annual handling)
  v_end_date := COALESCE(v_org.current_period_end, v_org.billing_cycle_start + interval '30 days', now());

  -- Set cancel flag — keep plan active until period ends
  UPDATE public.organizations
  SET cancel_at_period_end = v_end_date
  WHERE id = v_org.id;

  -- Send confirmation email
  SELECT email INTO v_owner_email FROM auth.users WHERE id = v_org.owner_id;

  IF v_owner_email IS NOT NULL THEN
    INSERT INTO public.pending_emails (to_email, subject, html_body, priority, metadata)
    VALUES (
      v_owner_email,
      'Subscription Cancellation Scheduled — ' || v_org.name,
      '<h2>Subscription Cancellation Scheduled</h2>' ||
        '<p>Your subscription for <strong>' || replace(replace(v_org.name, '&', '&amp;'), '<', '&lt;') || '</strong> will end on <strong>' || to_char(v_end_date, 'Month DD, YYYY') || '</strong>.</p>' ||
        '<p>You have full access until then. Your dashboard will remain accessible after that date, but AI features will be unavailable without credits.</p>' ||
        '<p>You can resubscribe anytime from the billing page.</p>',
      2,
      jsonb_build_object('type', 'subscription_cancel_scheduled', 'org_id', v_org.id, 'end_date', v_end_date)
    );
  END IF;

  INSERT INTO public.audit_trail (org_id, actor_id, actor_type, action, entity_type, entity_id, details)
  VALUES (v_org.id, p_caller_auth_uid, 'owner', 'subscription_cancel_scheduled', 'organization', v_org.id,
    jsonb_build_object('plan', v_org.subscription_plan, 'cancel_at_period_end', v_end_date));

  RETURN jsonb_build_object('success', true, 'cancel_at_period_end', v_end_date);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.cancel_subscription()
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid uuid;
BEGIN
  v_uid := auth.uid();
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;

  RETURN private.cancel_subscription(v_uid);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.cancel_subscription() FROM anon;
GRANT EXECUTE ON FUNCTION public.cancel_subscription() TO authenticated;
