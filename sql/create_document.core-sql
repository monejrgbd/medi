-- Private implementation
CREATE OR REPLACE FUNCTION private.create_document(
  p_caller_auth_uid uuid,
  p_visit_id uuid,
  p_patient_id uuid,
  p_location_id uuid,
  p_template_key text,
  p_input_fields jsonb DEFAULT '{}'::jsonb
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_caller_staff_id uuid;
  v_caller_org_id uuid;
  v_owner_id uuid;
  v_has_role boolean := false;
  v_template record;
  v_org_verified boolean;
  v_daily_count int;
  v_document_id uuid;
BEGIN
  -- Get caller staff info
  SELECT su.id, su.org_id
  INTO v_caller_staff_id, v_caller_org_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_caller_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff account not found');
  END IF;

  -- Authorization: must be owner or have any role at the location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_caller_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can create documents
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.location_id = p_location_id
        AND sr.role IN ('doctor', 'receptionist', 'nurse', 'manager')
    ) INTO v_has_role;

    IF NOT v_has_role THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Validate patient belongs to caller's org
  PERFORM 1 FROM public.patients p
  WHERE p.id = p_patient_id
    AND p.org_id = v_caller_org_id;

  IF NOT FOUND THEN
    RETURN jsonb_build_object('success', false, 'error', 'Patient not found');
  END IF;

  -- Validate location belongs to caller's org
  PERFORM 1 FROM public.locations l
  WHERE l.id = p_location_id
    AND l.org_id = v_caller_org_id;

  IF NOT FOUND THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- If visit_id provided, validate visit belongs to caller's org
  IF p_visit_id IS NOT NULL THEN
    PERFORM 1 FROM public.visits v
    WHERE v.id = p_visit_id
      AND v.org_id = v_caller_org_id;

    IF NOT FOUND THEN
      RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
    END IF;
  END IF;

  -- Load template
  SELECT dt.key, dt.document_category, dt.requires_verified_org,
         dt.default_requires_pin
  INTO v_template
  FROM public.document_templates dt
  WHERE dt.key = p_template_key
    AND dt.active = true;

  IF v_template IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Template not found or inactive');
  END IF;

  -- If template requires verified org, check
  IF v_template.requires_verified_org = true THEN
    SELECT o.verified INTO v_org_verified
    FROM public.organizations o
    WHERE o.id = v_caller_org_id;

    IF v_org_verified IS NOT true THEN
      RETURN jsonb_build_object('success', false, 'error', 'Organization not verified for this document type');
    END IF;
  END IF;

  -- Enforce per-visit daily cap (only when visit_id provided)
  IF p_visit_id IS NOT NULL THEN
    SELECT count(*) INTO v_daily_count
    FROM public.clinical_documents cd
    WHERE cd.visit_id = p_visit_id
      AND cd.created_at > now() - interval '1 day';

    IF v_daily_count >= 20 THEN
      RETURN jsonb_build_object('success', false, 'error', 'Daily document limit reached for this visit');
    END IF;
  END IF;

  -- Insert clinical document
  INSERT INTO public.clinical_documents (
    org_id, location_id, visit_id, patient_id,
    document_type, document_category, template_key,
    input_fields, status, requires_pin, created_by
  ) VALUES (
    v_caller_org_id, p_location_id, p_visit_id, p_patient_id,
    p_template_key, v_template.document_category, p_template_key,
    p_input_fields, 'draft', v_template.default_requires_pin, v_caller_staff_id
  )
  RETURNING id INTO v_document_id;

  -- Audit trail
  INSERT INTO public.audit_trail (org_id, location_id, entity_type, entity_id, actor_id, actor_type, action, details)
  VALUES (
    v_caller_org_id,
    p_location_id,
    'clinical_document',
    v_document_id,
    v_caller_staff_id,
    CASE WHEN v_owner_id = p_caller_auth_uid THEN 'owner' ELSE 'staff' END,
    'document_created',
    jsonb_build_object(
      'template_key', p_template_key,
      'document_category', v_template.document_category,
      'patient_id', p_patient_id,
      'visit_id', p_visit_id
    )
  );

  RETURN jsonb_build_object('success', true, 'document_id', v_document_id);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.create_document(
  p_visit_id uuid,
  p_patient_id uuid,
  p_location_id uuid,
  p_template_key text,
  p_input_fields jsonb DEFAULT '{}'::jsonb
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.create_document(
    v_auth_uid, p_visit_id, p_patient_id, p_location_id,
    p_template_key, p_input_fields
  );
END;
$$;

REVOKE EXECUTE ON FUNCTION public.create_document(uuid, uuid, uuid, text, jsonb) FROM anon;
GRANT EXECUTE ON FUNCTION public.create_document(uuid, uuid, uuid, text, jsonb) TO authenticated;

REVOKE ALL ON FUNCTION public.create_document(uuid, uuid, uuid, text, jsonb) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.create_document(uuid, uuid, uuid, text, jsonb) TO authenticated;
