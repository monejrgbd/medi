-- Private implementation
CREATE OR REPLACE FUNCTION private.set_visit_ai_override(
  p_caller_auth_uid uuid,
  p_visit_id uuid,
  p_ai_model text  -- 'premium' for Opus override, NULL to remove override
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_org record;
  v_budget_result jsonb;
BEGIN
  -- Validate
  IF p_ai_model IS NOT NULL AND p_ai_model NOT IN ('standard', 'advanced', 'precision', 'premium') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid AI model');
  END IF;

  -- Load visit
  SELECT id, org_id, status
  INTO v_visit
  FROM public.visits
  WHERE id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  -- Must be before AI conversation starts
  IF v_visit.status NOT IN ('pending_approval', 'approved', 'still_answering_ai') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Cannot change AI model after conversation is complete');
  END IF;

  -- Verify caller is staff at this org (owner, receptionist, or manager)
  SELECT o.id, o.subscription_plan
  INTO v_org
  FROM public.organizations o
  WHERE o.id = v_visit.org_id
    AND (o.owner_id = p_caller_auth_uid
      OR EXISTS (
        SELECT 1 FROM public.staff_users su
        JOIN public.staff_roles sr ON sr.staff_user_id = su.id
        WHERE su.auth_uid = p_caller_auth_uid AND su.org_id = o.id
          AND su.is_active AND NOT su.is_deleted
          AND sr.role IN ('receptionist', 'manager', 'doctor', 'nurse')
      ));

  IF v_org IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- If setting to premium (Opus), check budget availability
  IF p_ai_model = 'premium' THEN
    -- Quick budget check: compute remaining Premium AI capacity
    DECLARE
      v_cap numeric;
      v_used numeric;
      v_topup_remaining numeric;
      v_billing_start timestamptz;
    BEGIN
      SELECT billing_cycle_start INTO v_billing_start FROM public.organizations WHERE id = v_org.id;

      -- Get cap for this plan
      CASE v_org.subscription_plan
        WHEN 'starter' THEN v_cap := 4;
        WHEN 'professional' THEN v_cap := 20;
        WHEN 'business' THEN v_cap := 100;
        WHEN 'enterprise' THEN v_cap := 10000;
        ELSE v_cap := 0;
      END CASE;

      -- Count net usage
      SELECT GREATEST(COALESCE(-SUM(credits_amount), 0), 0) INTO v_used
      FROM public.credits_log
      WHERE org_id = v_org.id AND credit_type = 'premium_ai'
        AND created_at >= COALESCE(v_billing_start, now() - interval '30 days');

      -- Count top-up remaining
      SELECT COALESCE(SUM(credits - used), 0) INTO v_topup_remaining
      FROM public.budget_topups
      WHERE org_id = v_org.id AND feature IN ('premium_ai', 'general') AND credits - used > 0;

      IF v_used >= v_cap AND v_topup_remaining < 4 THEN
        RETURN jsonb_build_object('success', false, 'error', 'No Premium AI budget remaining. Top up from the billing page.');
      END IF;
    END;
  END IF;

  -- Set the override
  UPDATE public.visits
  SET ai_model_override = p_ai_model
  WHERE id = p_visit_id;

  RETURN jsonb_build_object('success', true, 'ai_model_override', p_ai_model);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.set_visit_ai_override(
  p_visit_id uuid,
  p_ai_model text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid uuid;
BEGIN
  v_uid := auth.uid();
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;

  RETURN private.set_visit_ai_override(v_uid, p_visit_id, p_ai_model);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.set_visit_ai_override(uuid, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.set_visit_ai_override(uuid, text) TO authenticated;
