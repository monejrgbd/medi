-- Private implementation
CREATE OR REPLACE FUNCTION private.get_campaign_patient_count(
  p_caller_auth_uid uuid,
  p_structured_filters jsonb DEFAULT NULL,
  p_location_id uuid DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_patient_count int;
BEGIN
  -- Try owner
  SELECT id INTO v_org_id FROM public.organizations WHERE owner_id = p_caller_auth_uid;
  -- If not owner, try marketer
  IF v_org_id IS NULL THEN
    SELECT su.org_id INTO v_org_id
    FROM public.staff_users su
    JOIN public.staff_roles sr ON sr.staff_user_id = su.id
    WHERE su.auth_uid = p_caller_auth_uid
      AND su.is_active AND NOT su.is_deleted
      AND sr.role = 'marketer';
  END IF;
  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  SELECT count(*) INTO v_patient_count
  FROM public.patients p
  LEFT JOIN LATERAL (
    SELECT
      count(*) AS visit_count,
      max(v.created_at) AS last_visit_date
    FROM public.visits v
    WHERE v.patient_id = p.id
      AND v.org_id = v_org_id
      AND v.status = 'completed'
      AND (p_location_id IS NULL OR v.location_id = p_location_id)
  ) vs ON true
  WHERE p.org_id = v_org_id
    AND p.phone IS NOT NULL
    AND p.phone_verified
    AND p.consent_given
    AND NOT p.marketing_sms_opted_out
    -- Location filter
    AND (p_location_id IS NULL OR vs.visit_count > 0)
    -- Age filters
    AND (
      p_structured_filters IS NULL
      OR p_structured_filters->>'min_age' IS NULL
      OR EXTRACT(YEAR FROM age(p.birthday)) >= (p_structured_filters->>'min_age')::int
    )
    AND (
      p_structured_filters IS NULL
      OR p_structured_filters->>'max_age' IS NULL
      OR EXTRACT(YEAR FROM age(p.birthday)) <= (p_structured_filters->>'max_age')::int
    )
    -- Sex filter
    AND (
      p_structured_filters IS NULL
      OR p_structured_filters->>'sex' IS NULL
      OR p.sex = p_structured_filters->>'sex'
    )
    -- Last visit after
    AND (
      p_structured_filters IS NULL
      OR p_structured_filters->>'last_visit_after' IS NULL
      OR vs.last_visit_date >= (p_structured_filters->>'last_visit_after')::timestamptz
    )
    -- Last visit before
    AND (
      p_structured_filters IS NULL
      OR p_structured_filters->>'last_visit_before' IS NULL
      OR vs.last_visit_date <= (p_structured_filters->>'last_visit_before')::timestamptz
    )
    -- Min visits
    AND (
      p_structured_filters IS NULL
      OR p_structured_filters->>'min_visits' IS NULL
      OR vs.visit_count >= (p_structured_filters->>'min_visits')::int
    )
    -- Max visits
    AND (
      p_structured_filters IS NULL
      OR p_structured_filters->>'max_visits' IS NULL
      OR vs.visit_count <= (p_structured_filters->>'max_visits')::int
    );

  RETURN jsonb_build_object(
    'success', true,
    'count', v_patient_count,
    'scan_credits', GREATEST(1, CEIL(v_patient_count / 1000.0))
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_campaign_patient_count(
  p_structured_filters jsonb DEFAULT NULL,
  p_location_id uuid DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid uuid;
BEGIN
  v_uid := auth.uid();
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;

  RETURN private.get_campaign_patient_count(v_uid, p_structured_filters, p_location_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.get_campaign_patient_count(jsonb, uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.get_campaign_patient_count(jsonb, uuid) TO authenticated;
