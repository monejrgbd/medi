-- Drop stale function signatures to prevent "not unique" errors
DROP FUNCTION IF EXISTS private.check_and_deduct_feature_budget(uuid, text, numeric);
DROP FUNCTION IF EXISTS private.check_and_deduct_feature_budget(uuid, text, numeric, text);
DROP FUNCTION IF EXISTS private.check_and_deduct_feature_budget(uuid, text, numeric, text, uuid);
DROP FUNCTION IF EXISTS public.check_and_deduct_feature_budget(uuid, text, numeric);
DROP FUNCTION IF EXISTS public.check_and_deduct_feature_budget(uuid, text, numeric, text);
DROP FUNCTION IF EXISTS public.check_and_deduct_feature_budget(uuid, text, numeric, text, uuid);

-- Private implementation
CREATE OR REPLACE FUNCTION private.check_and_deduct_feature_budget(
  p_org_id uuid,
  p_feature text,
  p_amount numeric,
  p_description text DEFAULT NULL,
  p_visit_id uuid DEFAULT NULL,
  p_document_id uuid DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org record;
  v_cap numeric;
  v_net_usage numeric;
  v_topup record;
BEGIN
  -- Fail fast: visit-scoped and document-scoped idempotency are mutually
  -- exclusive domains. A caller passing both is a programming error; refuse
  -- before taking the org row lock. (The deduct_document_credits wrapper only
  -- ever passes p_document_id; scribe/marketing only ever pass p_visit_id.)
  IF p_document_id IS NOT NULL AND p_visit_id IS NOT NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'cannot_key_on_both_visit_and_document');
  END IF;

  -- Lock org row (serializes ALL feature deductions for this org)
  SELECT subscription_plan, billing_cycle_start
  INTO v_org
  FROM public.organizations
  WHERE id = p_org_id
  FOR UPDATE;

  IF v_org IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Organization not found');
  END IF;

  -- PAyG and trials: use existing credits_total/credits_used system.
  -- Idempotent when visit-scoped via the credits_log (visit_id, credit_type)
  -- partial unique index: a retry for the same visit+feature never double
  -- charges. Calls with NULL visit_id (e.g. marketing campaigns) behave exactly
  -- as before — the idempotency key does not apply.
  IF v_org.subscription_plan IN ('pay_as_you_go', 'standard_trial', 'premium_trial') THEN
    DECLARE
      v_remaining numeric;
      v_rows int;
    BEGIN
      -- Document-scoped idempotency (AI paperwork). A visit yields many
      -- documents, so key on the document id and force visit_id = NULL so the
      -- row is governed solely by idx_credits_log_document_type_unique and can
      -- never collide with the visit partial unique index. Per-visit paperwork
      -- spend is still derivable via join on clinical_documents.visit_id.
      IF p_document_id IS NOT NULL THEN
        IF EXISTS (
          SELECT 1 FROM public.credits_log
          WHERE document_id = p_document_id AND credit_type = p_feature
        ) THEN
          RETURN jsonb_build_object('success', true, 'source', 'credits', 'already_deducted', true);
        END IF;

        SELECT credits_total - credits_used INTO v_remaining
        FROM public.organizations WHERE id = p_org_id;

        IF v_remaining < p_amount THEN
          RETURN jsonb_build_object('success', false, 'error', 'no_credits');
        END IF;

        INSERT INTO public.credits_log (org_id, visit_id, document_id, credits_amount, credit_type, description)
        VALUES (p_org_id, NULL, p_document_id, -p_amount, p_feature, COALESCE(p_description, p_feature))
        ON CONFLICT (document_id, credit_type) WHERE document_id IS NOT NULL DO NOTHING;

        GET DIAGNOSTICS v_rows = ROW_COUNT;
        IF v_rows = 0 THEN
          RETURN jsonb_build_object('success', true, 'source', 'credits', 'already_deducted', true);
        END IF;

        UPDATE public.organizations
        SET credits_used = credits_used + p_amount
        WHERE id = p_org_id;

        RETURN jsonb_build_object('success', true, 'source', 'credits');
      END IF;

      -- Visit-scoped idempotency (scribe / conversation) — unchanged.
      IF p_visit_id IS NOT NULL AND EXISTS (
        SELECT 1 FROM public.credits_log
        WHERE visit_id = p_visit_id AND credit_type = p_feature
      ) THEN
        RETURN jsonb_build_object('success', true, 'source', 'credits', 'already_deducted', true);
      END IF;

      SELECT credits_total - credits_used INTO v_remaining
      FROM public.organizations WHERE id = p_org_id;

      IF v_remaining < p_amount THEN
        RETURN jsonb_build_object('success', false, 'error', 'no_credits');
      END IF;

      INSERT INTO public.credits_log (org_id, visit_id, credits_amount, credit_type, description)
      VALUES (p_org_id, p_visit_id, -p_amount, p_feature, COALESCE(p_description, p_feature))
      ON CONFLICT (visit_id, credit_type) WHERE visit_id IS NOT NULL DO NOTHING;

      GET DIAGNOSTICS v_rows = ROW_COUNT;
      IF v_rows = 0 THEN
        RETURN jsonb_build_object('success', true, 'source', 'credits', 'already_deducted', true);
      END IF;

      UPDATE public.organizations
      SET credits_used = credits_used + p_amount
      WHERE id = p_org_id;

      RETURN jsonb_build_object('success', true, 'source', 'credits');
    END;
  END IF;

  -- Subscription plans: per-feature budget check

  -- Compute included cap for this feature based on plan
  CASE v_org.subscription_plan
    WHEN 'starter' THEN
      CASE p_feature
        WHEN 'marketing_sms' THEN v_cap := 10;
        WHEN 'marketing_scan' THEN v_cap := 10;
        WHEN 'premium_ai' THEN v_cap := 3.5;  -- 1 conversation at $3.50
        ELSE v_cap := 0;
      END CASE;
    WHEN 'professional' THEN
      CASE p_feature
        WHEN 'marketing_sms' THEN v_cap := 50;
        WHEN 'marketing_scan' THEN v_cap := 50;
        WHEN 'premium_ai' THEN v_cap := 15;  -- 5 conversations at $3.00
        ELSE v_cap := 0;
      END CASE;
    WHEN 'business' THEN
      CASE p_feature
        WHEN 'marketing_sms' THEN v_cap := 100;
        WHEN 'marketing_scan' THEN v_cap := 100;
        WHEN 'premium_ai' THEN v_cap := 62.5;  -- 25 conversations at $2.50
        ELSE v_cap := 0;
      END CASE;
    WHEN 'enterprise' THEN
      -- Enterprise: generous caps (admin-managed)
      v_cap := 10000;
    ELSE
      v_cap := 0;
  END CASE;

  -- Adjust Premium AI cost per plan (subscription plans get discounted rates)
  IF p_feature = 'premium_ai' THEN
    CASE v_org.subscription_plan
      WHEN 'starter' THEN p_amount := 3.5;
      WHEN 'professional' THEN p_amount := 3;
      WHEN 'business' THEN p_amount := 2.5;
      ELSE NULL; -- PAyG/trial/enterprise: keep original amount (4)
    END CASE;
  END IF;

  -- Count net feature usage this cycle (deductions - refunds)
  SELECT GREATEST(COALESCE(-SUM(credits_amount), 0), 0)
  INTO v_net_usage
  FROM public.credits_log
  WHERE org_id = p_org_id
    AND credit_type = p_feature
    AND created_at >= COALESCE(v_org.billing_cycle_start, now() - interval '30 days');

  -- Check 1: included budget
  IF v_net_usage + p_amount <= v_cap THEN
    INSERT INTO public.credits_log (org_id, visit_id, credits_amount, credit_type, description)
    VALUES (p_org_id, p_visit_id, -p_amount, p_feature, COALESCE(p_description, p_feature));

    RETURN jsonb_build_object('success', true, 'source', 'included');
  END IF;

  -- Check 2: feature-specific top-ups, then general (FIFO, oldest first)
  SELECT id, credits - used AS remaining
  INTO v_topup
  FROM public.budget_topups
  WHERE org_id = p_org_id
    AND feature IN (p_feature, 'general')
    AND credits - used >= p_amount
  ORDER BY CASE WHEN feature = p_feature THEN 0 ELSE 1 END, created_at
  LIMIT 1;

  IF v_topup IS NOT NULL THEN
    UPDATE public.budget_topups
    SET used = used + p_amount
    WHERE id = v_topup.id;

    INSERT INTO public.credits_log (org_id, visit_id, credits_amount, credit_type, description)
    VALUES (p_org_id, p_visit_id, -p_amount, p_feature, COALESCE(p_description, p_feature) || ' (top up)');

    RETURN jsonb_build_object('success', true, 'source', 'topup');
  END IF;

  -- All exhausted
  RETURN jsonb_build_object('success', false, 'error', 'budget_exhausted');
END;
$$;

-- Public wrapper (service_role only)
CREATE OR REPLACE FUNCTION public.check_and_deduct_feature_budget(
  p_org_id uuid,
  p_feature text,
  p_amount numeric,
  p_description text DEFAULT NULL,
  p_visit_id uuid DEFAULT NULL,
  p_document_id uuid DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  IF auth.role() <> 'service_role' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  RETURN private.check_and_deduct_feature_budget(p_org_id, p_feature, p_amount, p_description, p_visit_id, p_document_id);
END;
$$;
