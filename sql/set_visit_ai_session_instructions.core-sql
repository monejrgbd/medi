-- Private implementation
CREATE OR REPLACE FUNCTION private.set_visit_ai_session_instructions(
  p_caller_auth_uid uuid,
  p_visit_id uuid,
  p_instructions text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_org record;
  v_clean text;
BEGIN
  -- Sanitize
  v_clean := left(trim(regexp_replace(COALESCE(p_instructions, ''), '<[^>]*>', '', 'g')), 2000);

  -- Load visit
  SELECT id, org_id, status
  INTO v_visit
  FROM public.visits
  WHERE id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  IF v_visit.status NOT IN ('pending_approval', 'still_answering_ai') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Cannot set instructions after conversation is complete');
  END IF;

  -- Verify caller is staff at this org
  SELECT o.id
  INTO v_org
  FROM public.organizations o
  WHERE o.id = v_visit.org_id
    AND (o.owner_id = p_caller_auth_uid
      OR EXISTS (
        SELECT 1 FROM public.staff_users su
        JOIN public.staff_roles sr ON sr.staff_user_id = su.id
        WHERE su.auth_uid = p_caller_auth_uid AND su.org_id = o.id
          AND su.is_active AND NOT su.is_deleted
          AND sr.role IN ('receptionist', 'manager', 'doctor', 'nurse')
      ));

  IF v_org IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Set instructions (empty string clears)
  UPDATE public.visits
  SET ai_session_instructions = NULLIF(v_clean, '')
  WHERE id = p_visit_id;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.set_visit_ai_session_instructions(
  p_visit_id uuid,
  p_instructions text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid uuid;
BEGIN
  v_uid := auth.uid();
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;

  RETURN private.set_visit_ai_session_instructions(v_uid, p_visit_id, p_instructions);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.set_visit_ai_session_instructions(uuid, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.set_visit_ai_session_instructions(uuid, text) TO authenticated;
