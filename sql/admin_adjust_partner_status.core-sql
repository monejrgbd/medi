-- Platform-admin-only. Adjusts a partner's status. Banning flips all pending commission rows
-- to clawed_back (no payout owed) and decrements total_earned_cents by the wiped amount.
CREATE OR REPLACE FUNCTION private.admin_adjust_partner_status(
  p_caller_auth_uid uuid,
  p_partner_id      uuid,
  p_status          text,
  p_reason          text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_old_status text;
  v_wiped bigint := 0;
BEGIN
  IF NOT COALESCE(
    (SELECT (raw_app_meta_data->>'is_platform_admin')::boolean FROM auth.users WHERE id = p_caller_auth_uid),
    false
  ) THEN
    RAISE EXCEPTION 'Not authorized';
  END IF;

  IF p_status NOT IN ('active','suspended','banned') THEN
    RETURN jsonb_build_object('success', false, 'error', 'invalid_status');
  END IF;

  SELECT status INTO v_old_status FROM public.partners WHERE id = p_partner_id FOR UPDATE;
  IF v_old_status IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'partner_not_found');
  END IF;

  IF p_status = 'banned' AND v_old_status <> 'banned' THEN
    -- Wipe all pending commissions (the partner forfeits unpaid earnings)
    SELECT COALESCE(SUM(commission_amount_cents), 0)
    INTO v_wiped
    FROM public.partner_commissions
    WHERE partner_id = p_partner_id AND status = 'pending';

    UPDATE public.partner_commissions
    SET status = 'clawed_back'
    WHERE partner_id = p_partner_id AND status = 'pending';

    UPDATE public.partners
    SET status = 'banned',
        total_earned_cents = total_earned_cents - GREATEST(v_wiped, 0),
        total_clawed_back_cents = total_clawed_back_cents + GREATEST(v_wiped, 0),
        updated_at = now()
    WHERE id = p_partner_id;
  ELSE
    UPDATE public.partners
    SET status = p_status, updated_at = now()
    WHERE id = p_partner_id;
  END IF;

  RETURN jsonb_build_object('success', true, 'old_status', v_old_status, 'new_status', p_status, 'wiped_cents', v_wiped);
END;
$$;

CREATE OR REPLACE FUNCTION public.admin_adjust_partner_status(
  p_partner_id uuid,
  p_status     text,
  p_reason     text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  RETURN private.admin_adjust_partner_status(auth.uid(), p_partner_id, p_status, p_reason);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.admin_adjust_partner_status(uuid, text, text) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.admin_adjust_partner_status(uuid, text, text) TO authenticated;
