-- Private implementation
CREATE OR REPLACE FUNCTION private.get_pending_approvals(
  p_caller_auth_uid uuid,
  p_location_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_is_receptionist boolean := false;
  v_result jsonb;
BEGIN
  -- Get location org
  SELECT l.org_id INTO v_org_id
  FROM public.locations l
  WHERE l.id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Get caller staff id
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  -- Authorization: owner or receptionist at this location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can view
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'receptionist'
        AND sr.location_id = p_location_id
    ) INTO v_is_receptionist;

    IF NOT v_is_receptionist THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Get pending visits with patient info, match type, and collision fields
  SELECT jsonb_build_object(
    'success', true,
    'pending', COALESCE(jsonb_agg(
      jsonb_build_object(
        'visit_id', v.id,
        'patient_id', p.id,
        'first_name', p.first_name,
        'last_name', p.last_name,
        'birthday', p.birthday,
        'created_at', v.created_at,
        'has_previous_visits', v.has_previous_visits,
        'match_type', CASE
          WHEN v.has_previous_visits THEN 'returning'
          ELSE 'new'
        END,
        'collision_flag', p.collision_flag,
        'phone_verified', p.phone_verified,
        'phone_masked', CASE WHEN p.phone IS NOT NULL THEN '***-***-' || right(p.phone, 4) ELSE NULL END,
        'phone_verification_pending', v.phone_verification_pending,
        'active_follow_ups', (
          SELECT COALESCE(jsonb_agg(jsonb_build_object(
            'id', fu.id,
            'doctor_name', su.full_name,
            'due_date', fu.due_date,
            'ai_instructions_preview', left(fu.ai_instructions, 100),
            'visit_id', fu.visit_id,
            'visit_date', fv.completed_at,
            'visit_summary_preview', left(fv.ai_summary, 100)
          ) ORDER BY fu.due_date ASC), '[]'::jsonb)
          FROM public.follow_ups fu
          JOIN public.staff_users su ON su.id = fu.doctor_id
          JOIN public.visits fv ON fv.id = fu.visit_id
          WHERE fu.patient_id = p.id AND fu.status = 'active'
        ),
        'referral_match', (
          SELECT jsonb_build_object(
            'referral_id', r.id,
            'specialty', r.specialty,
            'from_org_name', rorg.name,
            'from_doctor_name', rsu.full_name
          )
          FROM public.referrals r
          JOIN public.organizations rorg ON rorg.id = r.from_org_id
          JOIN public.staff_users rsu ON rsu.id = r.from_doctor_id
          WHERE r.to_location_id = p_location_id
            AND r.status IN ('sent', 'viewed')
            AND r.patient_birthday = p.birthday
            AND r.patient_name ILIKE replace(replace(p.first_name, '%', '\%'), '_', '\_') || '%' || replace(replace(p.last_name, '%', '\%'), '_', '\_')
          ORDER BY r.created_at DESC
          LIMIT 1
        )
      ) ORDER BY v.created_at ASC
    ), '[]'::jsonb)
  ) INTO v_result
  FROM public.visits v
  JOIN public.patients p ON p.id = v.patient_id
  WHERE v.location_id = p_location_id
    AND v.status = 'pending_approval';

  RETURN v_result;
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_pending_approvals(
  p_location_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.get_pending_approvals(v_auth_uid, p_location_id);
END;
$$;

REVOKE ALL ON FUNCTION public.get_pending_approvals(uuid) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.get_pending_approvals(uuid) TO authenticated;
