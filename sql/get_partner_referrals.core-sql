-- Paginated referrals table for the partner dashboard.
-- Returns clinic name + plan + per-referral commission total. **Never gross revenue.**
CREATE OR REPLACE FUNCTION public.get_partner_referrals(
  p_limit  int DEFAULT 50,
  p_offset int DEFAULT 0
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid     uuid := auth.uid();
  v_partner uuid;
  v_rows    jsonb;
  v_total   int;
BEGIN
  IF v_uid IS NULL THEN
    RAISE EXCEPTION 'Authentication required';
  END IF;
  SELECT id INTO v_partner FROM public.partners WHERE auth_uid = v_uid;
  IF v_partner IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'not_a_partner');
  END IF;

  SELECT COUNT(*) INTO v_total FROM public.partner_referrals WHERE partner_id = v_partner;

  SELECT COALESCE(jsonb_agg(row_to_json(t) ORDER BY (t->>'attributed_at') DESC), '[]'::jsonb)
  INTO v_rows
  FROM (
    SELECT
      pr.id,
      pr.attributed_at,
      pr.first_payment_at,
      pr.code_used,
      pr.code_type,
      o.name AS org_name,
      o.subscription_plan AS plan,
      COALESCE((
        SELECT SUM(pc.commission_amount_cents)
        FROM public.partner_commissions pc
        WHERE pc.referral_id = pr.id
      ), 0) AS commission_to_date_cents
    FROM public.partner_referrals pr
    JOIN public.organizations o ON o.id = pr.org_id
    WHERE pr.partner_id = v_partner
    ORDER BY pr.attributed_at DESC
    LIMIT GREATEST(LEAST(p_limit, 200), 1)
    OFFSET GREATEST(p_offset, 0)
  ) AS sub
  CROSS JOIN LATERAL (SELECT to_jsonb(sub) AS t) j;

  RETURN jsonb_build_object('success', true, 'total', v_total, 'rows', v_rows);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.get_partner_referrals(int, int) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.get_partner_referrals(int, int) TO authenticated;
