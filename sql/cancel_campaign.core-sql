-- Private implementation
CREATE OR REPLACE FUNCTION private.cancel_campaign(
  p_caller_auth_uid uuid,
  p_campaign_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org record;
  v_campaign record;
  v_pending_count int;
  v_refund_amount numeric := 0;
  v_refund_from_recharge numeric := 0;
  v_refund_from_regular numeric := 0;
BEGIN
  -- Try owner (locks org row)
  SELECT id, credits_used, recharge_used, recharge_limit
  INTO v_org
  FROM public.organizations
  WHERE owner_id = p_caller_auth_uid
  FOR UPDATE;

  -- If not owner, try marketer (still locks org row)
  IF v_org IS NULL THEN
    SELECT o.id, o.credits_used, o.recharge_used, o.recharge_limit
    INTO v_org
    FROM public.organizations o
    JOIN public.staff_users su ON su.org_id = o.id
    JOIN public.staff_roles sr ON sr.staff_user_id = su.id
    WHERE su.auth_uid = p_caller_auth_uid AND su.is_active AND NOT su.is_deleted AND sr.role = 'marketer'
    FOR UPDATE OF o;
  END IF;

  IF v_org IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Load campaign
  SELECT id, status, org_id, ai_criteria
  INTO v_campaign
  FROM public.sms_campaigns
  WHERE id = p_campaign_id
    AND org_id = v_org.id;

  IF v_campaign IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Campaign not found');
  END IF;

  -- Guard: must be in cancellable status
  IF v_campaign.status NOT IN ('scanning', 'ready', 'sending') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Campaign cannot be cancelled in its current status');
  END IF;

  -- If sending, handle refunds for unsent messages
  IF v_campaign.status = 'sending' THEN
    -- Count pending (unsent) recipients
    SELECT count(*) INTO v_pending_count
    FROM public.sms_campaign_recipients
    WHERE campaign_id = p_campaign_id
      AND status = 'pending'
      AND NOT excluded;

    v_refund_amount := v_pending_count * 0.3;

    IF v_refund_amount > 0 THEN
      -- Refund credits: reverse from recharge first, then regular
      -- (opposite order of deduction)
      IF v_org.recharge_used > 0 THEN
        v_refund_from_recharge := LEAST(v_refund_amount, v_org.recharge_used);
        v_refund_from_regular := v_refund_amount - v_refund_from_recharge;
      ELSE
        v_refund_from_regular := v_refund_amount;
      END IF;

      UPDATE public.organizations
      SET credits_used = credits_used - v_refund_from_regular,
          recharge_used = recharge_used - v_refund_from_recharge
      WHERE id = v_org.id;

      -- Log refund (positive amount = credit returned)
      INSERT INTO public.credits_log (org_id, visit_id, credits_amount, credit_type, description)
      VALUES (
        v_org.id,
        NULL,
        v_refund_amount,
        'marketing_sms',
        'Campaign refund: ' || LEFT(COALESCE(v_campaign.ai_criteria, 'Structured filters'), 100)
      );

      -- Mark pending recipients as excluded
      UPDATE public.sms_campaign_recipients
      SET status = 'excluded'
      WHERE campaign_id = p_campaign_id
        AND status = 'pending'
        AND NOT excluded;
    END IF;
  END IF;

  -- Update campaign status
  UPDATE public.sms_campaigns
  SET status = 'cancelled'
  WHERE id = p_campaign_id;

  -- Audit trail
  INSERT INTO public.audit_trail (org_id, actor_id, actor_type, action, entity_type, entity_id, details)
  VALUES (
    v_org.id,
    p_caller_auth_uid,
    'owner',
    'cancel_campaign',
    'sms_campaign',
    p_campaign_id,
    jsonb_build_object(
      'previous_status', v_campaign.status,
      'refunded_credits', v_refund_amount
    )
  );

  RETURN jsonb_build_object('success', true, 'refunded_credits', v_refund_amount);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.cancel_campaign(
  p_campaign_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid uuid;
BEGIN
  v_uid := auth.uid();
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;

  RETURN private.cancel_campaign(v_uid, p_campaign_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.cancel_campaign(uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.cancel_campaign(uuid) TO authenticated;
