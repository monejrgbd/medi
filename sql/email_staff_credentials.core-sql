-- Private implementation
-- Queues a credentials email for the given staff user.
-- Caller must be the org owner OR an active manager at one of the staff's locations.
-- Resolves recipient email from p_override_email or staff_users.notification_email.
-- Writes an audit_trail entry so owners can later see who sent what to whom.
CREATE OR REPLACE FUNCTION private.email_staff_credentials(
  p_caller_auth_uid uuid,
  p_staff_user_id uuid,
  p_password text,
  p_override_email text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_org_name text;
  v_org_slug text;
  v_owner_id uuid;
  v_owner_name text;
  v_caller_staff_id uuid;
  v_actor_type text;
  v_is_manager boolean := false;
  v_staff_full_name text;
  v_staff_username text;
  v_staff_notification_email text;
  v_staff_is_active boolean;
  v_staff_is_deleted boolean;
  v_recipient_email text;
  v_synthetic_email text;
  v_subject text;
  v_body text;
  v_email_id uuid;
BEGIN
  -- Load the target staff row
  SELECT su.org_id, su.full_name, su.username, su.notification_email,
         su.is_active, su.is_deleted
    INTO v_org_id, v_staff_full_name, v_staff_username, v_staff_notification_email,
         v_staff_is_active, v_staff_is_deleted
  FROM public.staff_users su
  WHERE su.id = p_staff_user_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user not found');
  END IF;

  IF v_staff_is_deleted OR NOT v_staff_is_active THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff is not active');
  END IF;

  -- Load org context
  SELECT o.owner_id, o.name, o.slug
    INTO v_owner_id, v_org_name, v_org_slug
  FROM public.organizations o
  WHERE o.id = v_org_id;

  -- Authorization: owner OR active manager at one of the staff's locations
  IF v_owner_id = p_caller_auth_uid THEN
    v_actor_type := 'owner';
    SELECT su.id INTO v_caller_staff_id
    FROM public.staff_users su
    WHERE su.auth_uid = p_caller_auth_uid
      AND su.org_id = v_org_id
      AND su.is_deleted = false
    LIMIT 1;
  ELSE
    SELECT su.id, true
      INTO v_caller_staff_id, v_is_manager
    FROM public.staff_roles sr
    JOIN public.staff_users su ON su.id = sr.staff_user_id
    WHERE su.auth_uid = p_caller_auth_uid
      AND sr.role = 'manager'
      AND su.is_active = true
      AND su.is_deleted = false
      AND sr.location_id IN (
        SELECT sr2.location_id FROM public.staff_roles sr2
        WHERE sr2.staff_user_id = p_staff_user_id
      )
    LIMIT 1;

    IF NOT v_is_manager THEN
      RETURN jsonb_build_object('success', false, 'error', 'Only owner or manager can email credentials');
    END IF;
    v_actor_type := 'manager';
  END IF;

  -- Resolve recipient: override wins, else stored notification_email.
  -- NULLIF converts empty strings to NULL so COALESCE falls through correctly.
  v_recipient_email := COALESCE(
    NULLIF(lower(trim(p_override_email)), ''),
    NULLIF(lower(trim(v_staff_notification_email)), '')
  );

  IF v_recipient_email IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'No email on file for this staff member');
  END IF;

  IF length(v_recipient_email) > 254 OR v_recipient_email NOT LIKE '%_@_%._%' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid recipient email');
  END IF;

  -- Resolve owner display name (for the email body)
  SELECT su.full_name INTO v_owner_name
  FROM public.staff_users su
  WHERE su.auth_uid = v_owner_id
    AND su.org_id = v_org_id
    AND su.is_deleted = false
  LIMIT 1;
  v_owner_name := COALESCE(v_owner_name, 'Your clinic owner');

  v_synthetic_email := v_staff_username || '@' || v_org_slug || '.staff.hilt';
  v_subject := 'Your Hilt Health login for ' || v_org_name;

  v_body :=
    '<div style="font-family: sans-serif; max-width: 480px; margin: 0 auto; padding: 32px;">'
    || '<h2 style="color: #1a1a1a; margin-bottom: 8px;">' || v_org_name || '</h2>'
    || '<p style="color: #555; font-size: 15px;">'
    || v_owner_name || ' added you to Hilt Health.'
    || '</p>'
    || '<p style="color: #555; font-size: 15px;">Use these details to sign in:</p>'
    || '<div style="background: #f4f4f5; border-radius: 8px; padding: 20px; margin: 24px 0;">'
    || '<p style="margin: 0 0 8px 0; color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Username</p>'
    || '<p style="margin: 0 0 16px 0; font-family: monospace; font-size: 14px; color: #1a1a1a; word-break: break-all;">' || v_synthetic_email || '</p>'
    || '<p style="margin: 0 0 8px 0; color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Password</p>'
    || '<p style="margin: 0; font-family: monospace; font-size: 14px; color: #1a1a1a; word-break: break-all;">' || p_password || '</p>'
    || '</div>'
    || '<div style="text-align: center; margin: 24px 0;">'
    || '<a href="https://hilthealth.com/login" style="background: #2563EB; color: white; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-block;">Sign in</a>'
    || '</div>'
    || '<p style="color: #888; font-size: 13px; margin-top: 24px;">'
    || v_owner_name || ' can reset this for you anytime.'
    || '</p>'
    || '<div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #e5e5e5;">'
    || '<p style="color: #888; font-size: 11px;">Reply to this email if you do not recognize this account.</p>'
    || '</div>'
    || '</div>';

  INSERT INTO public.pending_emails (to_email, subject, html_body, priority, metadata)
  VALUES (
    v_recipient_email,
    v_subject,
    v_body,
    2,
    jsonb_build_object('type', 'staff_credentials', 'staff_user_id', p_staff_user_id, 'org_id', v_org_id)
  )
  RETURNING id INTO v_email_id;

  -- Audit trail (org owners and managers can later see who sent what)
  INSERT INTO public.audit_trail (org_id, entity_type, entity_id, actor_id, actor_type, action, details)
  VALUES (
    v_org_id,
    'staff_user',
    p_staff_user_id,
    v_caller_staff_id,
    v_actor_type,
    'staff_credentials_emailed',
    jsonb_build_object('recipient_email', v_recipient_email, 'pending_email_id', v_email_id)
  );

  RETURN jsonb_build_object('success', true, 'queued_email_id', v_email_id);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.email_staff_credentials(
  p_staff_user_id uuid,
  p_password text,
  p_override_email text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.email_staff_credentials(v_auth_uid, p_staff_user_id, p_password, p_override_email);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.email_staff_credentials(uuid, text, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.email_staff_credentials(uuid, text, text) TO authenticated;
