-- Private only — called by daily cron, no public wrapper needed
CREATE OR REPLACE FUNCTION private.send_daily_digest()
RETURNS void
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org record;
  v_owner_email text;
  v_unseen_count int;
  v_unsub_token text;
  v_edge_url text;
BEGIN
  SELECT decrypted_secret INTO v_edge_url
  FROM vault.decrypted_secrets WHERE name = 'edge_function_url';

  FOR v_org IN
    SELECT o.id, o.name, o.owner_id
    FROM public.organizations o
    WHERE o.subscription_plan NOT IN ('expired', 'suspended', 'read_only')
  LOOP
    SELECT count(*)::int INTO v_unseen_count
    FROM public.visits v
    WHERE v.org_id = v_org.id
      AND v.created_at >= CURRENT_DATE - interval '1 day'
      AND v.created_at < CURRENT_DATE
      AND v.status IN ('left', 'waiting_doctor_claim');

    IF v_unseen_count > 0 THEN
      SELECT email INTO v_owner_email
      FROM auth.users WHERE id = v_org.owner_id;

      IF v_owner_email IS NOT NULL THEN
        v_unsub_token := private.generate_unsubscribe_token(v_owner_email, 'daily_digest');

        INSERT INTO public.pending_emails (to_email, subject, html_body, priority, metadata)
        VALUES (
          v_owner_email,
          'Daily Summary — ' || v_org.name,
          '<h2>Daily Summary</h2><p>Yesterday at <strong>' || replace(replace(v_org.name, '&', '&amp;'), '<', '&lt;') ||
            '</strong>: ' || v_unseen_count || ' patient' ||
            CASE WHEN v_unseen_count > 1 THEN 's were' ELSE ' was' END ||
            ' not seen by a doctor.</p>' ||
            CASE WHEN v_unsub_token IS NOT NULL AND v_edge_url IS NOT NULL
              THEN '<p style="color:#94a3b8;font-size:12px;margin-top:24px;"><a href="' || v_edge_url || '/unsubscribe?pref=' || v_unsub_token || '" style="color:#94a3b8;">Unsubscribe from daily digest</a></p>'
              ELSE ''
            END,
          1,
          jsonb_build_object('type', 'daily_digest', 'pref_key', 'daily_digest', 'org_id', v_org.id)
        );
      END IF;
    END IF;
  END LOOP;
END;
$$;
