-- Private implementation
CREATE OR REPLACE FUNCTION private.finalize_campaign_scan(
  p_campaign_id uuid,
  p_total_scanned int
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_matched int;
BEGIN
  -- Get current matched_count
  SELECT matched_count INTO v_matched
  FROM public.sms_campaigns
  WHERE id = p_campaign_id;

  IF v_matched IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Campaign not found');
  END IF;

  -- Update campaign scan results
  UPDATE public.sms_campaigns
  SET total_scanned = p_total_scanned,
      scan_completed_at = now(),
      status = CASE WHEN v_matched = 0 THEN 'completed' ELSE 'ready' END
  WHERE id = p_campaign_id;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper (service_role only)
CREATE OR REPLACE FUNCTION public.finalize_campaign_scan(
  p_campaign_id uuid,
  p_total_scanned int
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  RETURN private.finalize_campaign_scan(p_campaign_id, p_total_scanned);
END;
$$;

-- Service role only: revoke from authenticated and anon
REVOKE EXECUTE ON FUNCTION public.finalize_campaign_scan(uuid, int) FROM authenticated;
REVOKE EXECUTE ON FUNCTION public.finalize_campaign_scan(uuid, int) FROM anon;
