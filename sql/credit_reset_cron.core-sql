-- Cron job: daily midnight — reset monthly credits for orgs past billing cycle
SELECT cron.schedule(
  'credit_reset',
  '0 0 * * *',
  $cron$
  DO $body$
  DECLARE
    v_org_id uuid;
  BEGIN
    FOR v_org_id IN
      SELECT id FROM public.organizations
      WHERE billing_cycle_start IS NOT NULL
        AND cancel_at_period_end IS NULL
        AND (
          (subscription_plan IN ('starter', 'professional', 'business', 'enterprise')
           AND billing_cycle_start + interval '1 month' <= now())
          OR
          (subscription_plan = 'pay_as_you_go' AND recharge_limit IS NOT NULL
           AND billing_cycle_start + interval '30 days' <= now())
        )
    LOOP
      PERFORM private.reset_monthly_credits(v_org_id);
    END LOOP;
  END;
  $body$
  $cron$
);
