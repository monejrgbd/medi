-- Private implementation
CREATE OR REPLACE FUNCTION private.delete_staff(
  p_caller_auth_uid uuid,
  p_staff_user_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_target_auth_uid uuid;
  v_caller_staff_id uuid;
  v_is_manager boolean := false;
BEGIN
  SELECT su.org_id, su.auth_uid INTO v_org_id, v_target_auth_uid
  FROM public.staff_users su
  WHERE su.id = p_staff_user_id AND su.is_deleted = false;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user not found');
  END IF;

  -- Authorization: owner or manager at a shared location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can delete anyone
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      JOIN public.staff_users su ON su.id = sr.staff_user_id
      WHERE su.auth_uid = p_caller_auth_uid
        AND sr.role = 'manager'
        AND su.is_active = true
        AND su.is_deleted = false
        AND sr.location_id IN (
          SELECT sr2.location_id FROM public.staff_roles sr2
          WHERE sr2.staff_user_id = p_staff_user_id
        )
    ) INTO v_is_manager;

    IF NOT v_is_manager THEN
      RETURN jsonb_build_object('success', false, 'error', 'Only owner or manager can delete staff');
    END IF;
  END IF;

  -- Get caller staff id for audit
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_deleted = false;

  -- Release claimed patients back to queue
  PERFORM set_config('app.audit_actor_id', COALESCE(v_caller_staff_id::text, p_caller_auth_uid::text), true);
  PERFORM set_config('app.audit_actor_type', 'staff', true);
  PERFORM set_config('app.audit_action', 'released_on_deletion', true);

  UPDATE public.visits
  SET status = 'waiting_doctor_claim',
      claimed_by = NULL,
      claimed_at = NULL
  WHERE claimed_by = p_staff_user_id
    AND status = 'claimed_by_doctor';

  -- Soft delete
  UPDATE public.staff_users
  SET is_deleted = true, deleted_at = now(), is_active = false
  WHERE id = p_staff_user_id;

  -- Auto-check out
  UPDATE public.staff_checkins
  SET checked_out_at = now()
  WHERE staff_user_id = p_staff_user_id
    AND checked_out_at IS NULL;

  -- Ban auth user to prevent login
  IF v_target_auth_uid IS NOT NULL THEN
    UPDATE auth.users SET banned_until = '2099-12-31T23:59:59Z'::timestamptz
    WHERE id = v_target_auth_uid;
  END IF;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.delete_staff(
  p_staff_user_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.delete_staff(v_auth_uid, p_staff_user_id);
END;
$$;
