-- deduct_scribe_credits: AI ambient scribe billing.
-- Subscription plans (starter/professional/business/enterprise): bundled and
-- UNLIMITED — no deduction, no cap, no blocking. PAYG and trials: metered per
-- audio minute against the credits pool, idempotent per visit via the
-- credits_log (visit_id, credit_type) unique index. Mirrors deduct_credits.
-- Called by the transcribe-encounter edge function (service role).

-- Private implementation
CREATE OR REPLACE FUNCTION private.deduct_scribe_credits(
  p_caller_role text,
  p_org_id uuid,
  p_visit_id uuid,
  p_audio_minutes numeric
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_rate constant numeric := 0.1;   -- credits per audio minute (PAYG/trial only)
  v_org record;
  v_minutes int;
  v_amount numeric;
  v_remaining numeric;
  v_from_regular numeric := 0;
  v_from_recharge numeric := 0;
  v_recharge_remaining numeric;
  v_rows_inserted int;
BEGIN
  -- Lock org row FIRST to prevent race conditions
  SELECT credits_total, credits_used, recharge_limit, recharge_used, subscription_plan
  INTO v_org
  FROM public.organizations
  WHERE id = p_org_id
  FOR UPDATE;

  IF v_org IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Organization not found');
  END IF;

  -- Idempotency: one scribe charge per visit (retry safe)
  IF EXISTS (
    SELECT 1 FROM public.credits_log
    WHERE visit_id = p_visit_id AND credit_type = 'scribe_transcription'
  ) THEN
    RETURN jsonb_build_object('success', true, 'already_deducted', true, 'credits_deducted', 0);
  END IF;

  -- Subscription plans: bundled, unlimited. No deduction, no cap, no blocking.
  IF v_org.subscription_plan IN ('starter', 'professional', 'business', 'enterprise') THEN
    RETURN jsonb_build_object('success', true, 'source', 'plan_unlimited', 'credits_deducted', 0);
  END IF;

  -- PAYG / trials: metered (round audio minutes up)
  v_minutes := ceil(GREATEST(COALESCE(p_audio_minutes, 0), 0));
  v_amount := v_minutes * v_rate;

  IF v_amount <= 0 THEN
    RETURN jsonb_build_object('success', true, 'source', 'credits', 'credits_deducted', 0);
  END IF;

  v_remaining := v_org.credits_total - v_org.credits_used;

  IF v_remaining >= v_amount THEN
    v_from_regular := v_amount;
  ELSIF v_org.recharge_limit IS NOT NULL THEN
    v_from_regular := GREATEST(v_remaining, 0);
    v_from_recharge := v_amount - v_from_regular;
    v_recharge_remaining := v_org.recharge_limit - v_org.recharge_used;

    IF v_from_recharge > v_recharge_remaining THEN
      RETURN jsonb_build_object('success', false, 'error', 'no_credits');
    END IF;
  ELSE
    RETURN jsonb_build_object('success', false, 'error', 'no_credits');
  END IF;

  -- Log the deduction with the UNIQUE (visit_id, credit_type) index as final guard
  INSERT INTO public.credits_log (org_id, visit_id, credits_amount, credit_type, description)
  VALUES (p_org_id, p_visit_id, -v_amount, 'scribe_transcription',
          'AI scribe transcription (' || v_minutes || ' min)')
  ON CONFLICT (visit_id, credit_type) WHERE visit_id IS NOT NULL DO NOTHING;

  GET DIAGNOSTICS v_rows_inserted = ROW_COUNT;
  IF v_rows_inserted = 0 THEN
    RETURN jsonb_build_object('success', true, 'already_deducted', true, 'credits_deducted', 0);
  END IF;

  UPDATE public.organizations
  SET credits_used = credits_used + v_from_regular,
      recharge_used = recharge_used + v_from_recharge
  WHERE id = p_org_id;

  RETURN jsonb_build_object('success', true, 'credits_deducted', v_amount,
    'source', 'credits', 'recharge_charged', v_from_recharge);
END;
$$;

-- Public wrapper (service-role only)
CREATE OR REPLACE FUNCTION public.deduct_scribe_credits(
  p_org_id uuid,
  p_visit_id uuid,
  p_audio_minutes numeric
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  IF auth.role() <> 'service_role' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  RETURN private.deduct_scribe_credits(auth.role(), p_org_id, p_visit_id, p_audio_minutes);
END;
$$;
