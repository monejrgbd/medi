-- deduct_scribe_credits: AI ambient scribe billing.
-- Scribe is FREE on every plan (PAYG, trials, and all subscription plans).
-- This is a no-op kept as a stable seam so the transcribe-encounter edge
-- function call site, signature, and service-role gate do not change. The
-- scribe model quality still varies by plan (see PLAN_SCRIBE_TIER), but no
-- credits are ever deducted and no credits_log row is written for scribe.

-- Private implementation
CREATE OR REPLACE FUNCTION private.deduct_scribe_credits(
  p_caller_role text,
  p_org_id uuid,
  p_visit_id uuid,
  p_audio_minutes numeric
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  -- Scribe is free for all plans. No lookup, no deduction, no logging.
  RETURN jsonb_build_object('success', true, 'source', 'free', 'credits_deducted', 0);
END;
$$;

-- Public wrapper (service-role only)
CREATE OR REPLACE FUNCTION public.deduct_scribe_credits(
  p_org_id uuid,
  p_visit_id uuid,
  p_audio_minutes numeric
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  IF auth.role() <> 'service_role' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  RETURN private.deduct_scribe_credits(auth.role(), p_org_id, p_visit_id, p_audio_minutes);
END;
$$;
