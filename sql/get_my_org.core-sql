-- Private implementation
CREATE OR REPLACE FUNCTION private.get_my_org(p_caller_auth_uid uuid)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_result jsonb;
BEGIN
  -- Try owner first
  SELECT jsonb_build_object(
    'id', o.id,
    'name', o.name,
    'slug', o.slug,
    'owner_id', o.owner_id,
    'subscription_plan', o.subscription_plan,
    'credits_total', o.credits_total,
    'credits_used', o.credits_used,
    'trial_end_date', o.trial_end_date,
    'onboarding_completed_at', o.onboarding_completed_at,
    'country', o.country,
    'cancel_at_period_end', o.cancel_at_period_end,
    'verified', o.verified,
    'created_at', o.created_at
  )
  INTO v_result
  FROM public.organizations o
  WHERE o.owner_id = p_caller_auth_uid
  LIMIT 1;

  -- Fallback to staff_users
  IF v_result IS NULL THEN
    SELECT jsonb_build_object(
      'id', o.id,
      'name', o.name,
      'slug', o.slug,
      'owner_id', o.owner_id,
      'subscription_plan', o.subscription_plan,
      'credits_total', o.credits_total,
      'credits_used', o.credits_used,
      'trial_end_date', o.trial_end_date,
      'onboarding_completed_at', o.onboarding_completed_at,
      'country', o.country,
      'verified', o.verified,
      'created_at', o.created_at
    )
    INTO v_result
    FROM public.organizations o
    JOIN public.staff_users su ON su.org_id = o.id
    WHERE su.auth_uid = p_caller_auth_uid
      AND su.is_deleted = false
    LIMIT 1;
  END IF;

  RETURN COALESCE(v_result, '{}'::jsonb);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_my_org()
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.get_my_org(v_auth_uid);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.get_my_org() FROM anon;
GRANT EXECUTE ON FUNCTION public.get_my_org() TO authenticated;
