-- Private implementation
CREATE OR REPLACE FUNCTION private.get_my_org(p_caller_auth_uid uuid)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_result jsonb;
BEGIN
  SELECT jsonb_build_object(
    'id', o.id,
    'name', o.name,
    'slug', o.slug,
    'owner_id', o.owner_id,
    'subscription_plan', o.subscription_plan,
    'credits_total', o.credits_total,
    'credits_used', o.credits_used,
    'trial_end_date', o.trial_end_date,
    'review_sms_addon', o.review_sms_addon,
    'followup_sms_addon', o.followup_sms_addon,
    'created_at', o.created_at
  )
  INTO v_result
  FROM public.organizations o
  JOIN public.staff_users su ON su.org_id = o.id
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_deleted = false
  LIMIT 1;

  RETURN COALESCE(v_result, '{}'::jsonb);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_my_org()
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.get_my_org(v_auth_uid);
END;
$$;
