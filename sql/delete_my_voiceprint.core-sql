-- delete_my_voiceprint: the clinician deletes their own enrolled voiceprint.
-- Strips the biometric embedding bytes and marks the row deleted (the row is
-- kept for the audit record). Compliance path for BIPA/Quebec.

-- Private implementation
CREATE OR REPLACE FUNCTION private.delete_my_voiceprint(p_caller_auth_uid uuid)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_staff_id uuid;
  v_org_id uuid;
  v_vp_id uuid;
BEGIN
  SELECT su.id, su.org_id
  INTO v_staff_id, v_org_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff account not found');
  END IF;

  UPDATE public.voiceprints
  SET status = 'deleted', deleted_at = now(), updated_at = now(),
      embedding = '[]'::jsonb
  WHERE staff_user_id = v_staff_id AND status = 'active'
  RETURNING id INTO v_vp_id;

  IF v_vp_id IS NULL THEN
    RETURN jsonb_build_object('success', true, 'deleted', false);
  END IF;

  INSERT INTO public.audit_trail (org_id, entity_type, entity_id, actor_id, actor_type, action, details)
  VALUES (v_org_id, 'voiceprint', v_vp_id, v_staff_id, 'clinician', 'voiceprint_deleted', '{}'::jsonb);

  RETURN jsonb_build_object('success', true, 'deleted', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.delete_my_voiceprint()
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.delete_my_voiceprint(v_auth_uid);
END;
$$;

REVOKE ALL ON FUNCTION public.delete_my_voiceprint() FROM PUBLIC;
REVOKE EXECUTE ON FUNCTION public.delete_my_voiceprint() FROM anon;
GRANT EXECUTE ON FUNCTION public.delete_my_voiceprint() TO authenticated;
