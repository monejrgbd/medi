-- start_scribe_recording: doctor activates the AI scribe on a claimed patient.
-- Creates the scribe_recordings lifecycle row and logs the consent attestation
-- BEFORE any audio is captured. No clinical_documents row is created here (it is
-- created at finalize, only when real audio exists) to avoid orphan drafts.
--
-- p_room_roster: the closed-set roles the doctor declares are in the room
-- (besides themselves), e.g. ["patient","caregiver"]. Stored on the recording
-- and handed to the identity/labeling stage as the expected-speaker hint.

-- Signature changed (added p_room_roster); drop the prior overloads so the new
-- argument list is unambiguous.
DROP FUNCTION IF EXISTS public.start_scribe_recording(uuid, text);
DROP FUNCTION IF EXISTS private.start_scribe_recording(uuid, uuid, text);

-- Private implementation
CREATE OR REPLACE FUNCTION private.start_scribe_recording(
  p_caller_auth_uid uuid,
  p_visit_id uuid,
  p_language text DEFAULT 'en',
  p_room_roster jsonb DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_caller_staff_id uuid;
  v_caller_org_id uuid;
  v_owner_id uuid;
  v_visit record;
  v_has_role boolean := false;
  v_recording_id uuid := gen_random_uuid();
  v_audio_prefix text;
  v_org record;
  v_lang text;
  v_location_ai_model text;
  v_model text;
  v_min numeric;
  v_roster jsonb;
BEGIN
  v_lang := COALESCE(NULLIF(trim(p_language), ''), 'en');
  -- Only keep a roster that is a JSON array; anything else is ignored.
  v_roster := CASE WHEN jsonb_typeof(p_room_roster) = 'array' THEN p_room_roster ELSE NULL END;

  -- Caller staff
  SELECT su.id, su.org_id
  INTO v_caller_staff_id, v_caller_org_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_caller_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff account not found');
  END IF;

  -- Visit (derive org/location/patient server-side; do not trust client)
  SELECT id, org_id, location_id, patient_id, ai_model_override
  INTO v_visit
  FROM public.visits
  WHERE id = p_visit_id;

  IF v_visit.id IS NULL OR v_visit.org_id <> v_caller_org_id THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  -- Authorization: owner OR doctor/nurse at the visit location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_caller_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL;
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.location_id = v_visit.location_id
        AND sr.role IN ('doctor', 'nurse')
    ) INTO v_has_role;

    IF NOT v_has_role THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Credit preflight (metered plans only): refuse to start a recording the
  -- clinic cannot afford. Subscription plans are plan_included and skip this
  -- (mirrors deduct_scribe_credits plan partitioning, so PAYG/trials and
  -- expired/suspended are all gated). Minutes are unknown until Stop, so the
  -- floor is one minute at the resolved tier rate (CASE replicates
  -- aiModelToTier + the deduct_scribe_credits rate). We never interrupt a
  -- recording mid-encounter; a bounded one-recording overrun is accepted.
  SELECT subscription_plan, credits_total, credits_used INTO v_org
  FROM public.organizations WHERE id = v_caller_org_id;

  IF v_org.subscription_plan NOT IN ('starter', 'professional', 'business', 'enterprise') THEN
    SELECT ai_model INTO v_location_ai_model
    FROM public.locations WHERE id = v_visit.location_id;

    v_model := COALESCE(v_visit.ai_model_override, v_location_ai_model);
    v_min := CASE
      WHEN v_model = 'premium'   THEN 0.5
      WHEN v_model = 'precision' THEN 0.5
      WHEN v_model = 'advanced'  THEN 0.2
      ELSE 0.1  -- standard / null / unknown
    END;

    IF (v_org.credits_total - v_org.credits_used) < v_min THEN
      RETURN jsonb_build_object(
        'success', false,
        'error', 'Out of credits. Add credits to use the AI scribe.'
      );
    END IF;
  END IF;

  v_audio_prefix := v_caller_org_id::text || '/' || v_visit.id::text
                    || '/scribe/' || v_recording_id::text;

  INSERT INTO public.scribe_recordings (
    id, org_id, location_id, visit_id, patient_id, created_by,
    status, consent_attested_at, audio_prefix, language, room_roster
  ) VALUES (
    v_recording_id, v_caller_org_id, v_visit.location_id, v_visit.id, v_visit.patient_id,
    v_caller_staff_id, 'consented', now(), v_audio_prefix, v_lang, v_roster
  );

  -- Consent + lifecycle audit (logged before any capture)
  INSERT INTO public.audit_trail (org_id, location_id, entity_type, entity_id, actor_id, actor_type, action, details)
  VALUES (
    v_caller_org_id, v_visit.location_id, 'scribe_recording', v_recording_id,
    v_caller_staff_id,
    CASE WHEN v_owner_id = p_caller_auth_uid THEN 'owner' ELSE 'doctor' END,
    'scribe_consent_attested',
    jsonb_build_object('visit_id', v_visit.id, 'patient_id', v_visit.patient_id,
                       'consent_text_version', 'scribe_v1', 'language', v_lang,
                       'room_roster', v_roster)
  );

  -- Passed the credit preflight (or plan_included). The hard gate above
  -- blocks insufficient-credit starts; the soft low_credits warning is left
  -- false here (the actual per-minute charge happens post-recording in
  -- transcribe-encounter via deduct_scribe_credits).
  RETURN jsonb_build_object(
    'success', true,
    'recording_id', v_recording_id,
    'audio_prefix', v_audio_prefix,
    'low_credits', false
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.start_scribe_recording(
  p_visit_id uuid,
  p_language text DEFAULT 'en',
  p_room_roster jsonb DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.start_scribe_recording(v_auth_uid, p_visit_id, p_language, p_room_roster);
END;
$$;

REVOKE ALL ON FUNCTION public.start_scribe_recording(uuid, text, jsonb) FROM PUBLIC;
REVOKE EXECUTE ON FUNCTION public.start_scribe_recording(uuid, text, jsonb) FROM anon;
GRANT EXECUTE ON FUNCTION public.start_scribe_recording(uuid, text, jsonb) TO authenticated;
