-- Private implementation — called by daily cron
CREATE OR REPLACE FUNCTION private.expire_stale_sessions()
RETURNS void
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  -- Set audit context
  PERFORM set_config('app.audit_actor_type', 'system', true);
  PERFORM set_config('app.audit_action', 'daily_cleanup', true);

  -- 1. Expire stale waiting_doctor_claim from previous day
  UPDATE public.visits
  SET status = 'left', updated_at = now()
  WHERE status = 'waiting_doctor_claim'
    AND entered_queue_at < CURRENT_DATE;

  -- 1b. Expire stale awaiting_arrival visits (remote check-ins that never arrived).
  -- 24h window is long enough for same-day pre-checkins + overnight edge cases.
  UPDATE public.visits
  SET status = 'left', updated_at = now()
  WHERE status = 'awaiting_arrival'
    AND created_at < now() - interval '24 hours';

  -- 2. Expire 90-day overdue follow-ups
  UPDATE public.follow_ups
  SET status = 'expired'
  WHERE status = 'active'
    AND due_at < now() - interval '90 days';

  -- 3. Expire 30-day unfollowed referrals
  UPDATE public.referrals
  SET status = 'expired', expired_at = now()
  WHERE status IN ('sent', 'viewed')
    AND created_at < now() - interval '30 days';

  -- 4. Delete expired phone verifications
  DELETE FROM public.phone_verifications
  WHERE expires_at < now() - interval '24 hours';

  -- 5. Expire trial subscriptions past their end date
  UPDATE public.organizations
  SET subscription_plan = 'expired', updated_at = now()
  WHERE subscription_plan IN ('standard_trial', 'premium_trial')
    AND trial_end_date IS NOT NULL
    AND trial_end_date < now();

  -- 6. Expire orgs past their cancel date
  UPDATE public.organizations
  SET subscription_plan = 'expired',
      credits_total = 0,
      credits_used = 0,
      recharge_used = 0,
      billing_cycle_start = NULL,
      paypal_subscription_id = NULL,
      cancel_at_period_end = NULL,
      cancelled_at = COALESCE(cancelled_at, now()),
      data_retention_until = COALESCE(data_retention_until, now() + interval '90 days')
  WHERE cancel_at_period_end IS NOT NULL
    AND cancel_at_period_end < now()
    AND subscription_plan NOT IN ('expired', 'suspended');

  -- 7. Delete expired pre-checkin tokens older than 7 days
  DELETE FROM public.pre_checkin_tokens
  WHERE expires_at < now() - interval '7 days';

  -- 8. Owner alerts (trial expiry + daily digest)
  PERFORM private.send_trial_expiry_alert();
  PERFORM private.send_daily_digest();
END;
$$;
