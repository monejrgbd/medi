-- Private implementation
CREATE OR REPLACE FUNCTION private.get_patient_session(
  p_session_token uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_queue_position int;
  v_estimated_wait numeric;
  v_meds jsonb;
  v_allergies jsonb;
  v_chronic jsonb;
  v_pets jsonb;
  v_custom_fields jsonb;
  v_location_config jsonb;
BEGIN
  -- Look up visit by session token
  SELECT v.id AS visit_id, v.status, v.has_previous_visits, v.created_at,
         v.timeout_flagged, v.ai_summary, v.ai_structured_card, v.ai_completed_at,
         v.priority, v.location_id, v.phone_verification_pending,
         v.pending_phone, v.queue_number,
         v.entered_queue_at, v.patient_denied, v.patient_id,
         v.staff_room, v.checkin_mode, v.arrived_at,
         v.prescreening_data, v.ai_skipped,
         p.first_name AS patient_first_name, p.language, p.consent_given,
         p.birthday AS patient_birthday,
         p.sex,
         p.phone_verified AS patient_phone_verified,
         (p.phone IS NOT NULL) AS patient_has_phone,
         l.name AS location_name, l.estimated_wait_minutes,
         l.show_doctor_room_to_patients
  INTO v_visit
  FROM public.visits v
  JOIN public.patients p ON p.id = v.patient_id
  JOIN public.locations l ON l.id = v.location_id
  WHERE v.session_token = p_session_token;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Session not found');
  END IF;

  -- Reject if visit created more than 24 hours ago
  IF v_visit.created_at < now() - interval '24 hours' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Session expired');
  END IF;

  -- Compute queue position when in queue
  IF v_visit.status = 'waiting_doctor_claim' THEN
    SELECT count(*) + 1 INTO v_queue_position
    FROM public.visits
    WHERE location_id = v_visit.location_id
      AND status = 'waiting_doctor_claim'
      AND (priority > v_visit.priority
        OR (priority = v_visit.priority AND entered_queue_at < v_visit.entered_queue_at));

    IF v_visit.estimated_wait_minutes IS NOT NULL THEN
      v_estimated_wait := v_visit.estimated_wait_minutes * v_queue_position;
    END IF;
  ELSIF v_visit.status = 'claimed_by_doctor' THEN
    v_queue_position := 0;
  END IF;

  -- Load medical info from separate tables
  SELECT COALESCE(jsonb_agg(jsonb_build_object('name', pm.name)), '[]'::jsonb)
  INTO v_meds
  FROM public.patient_medications pm
  WHERE pm.patient_id = v_visit.patient_id AND pm.active = true;

  SELECT COALESCE(jsonb_agg(jsonb_build_object('name', pa.name)), '[]'::jsonb)
  INTO v_allergies
  FROM public.patient_allergies pa
  WHERE pa.patient_id = v_visit.patient_id AND pa.active = true;

  SELECT COALESCE(jsonb_agg(jsonb_build_object('name', pc.name)), '[]'::jsonb)
  INTO v_chronic
  FROM public.patient_chronic_conditions pc
  WHERE pc.patient_id = v_visit.patient_id AND pc.active = true;

  SELECT COALESCE(jsonb_agg(jsonb_build_object('name', pp.name)), '[]'::jsonb)
  INTO v_pets
  FROM public.patient_pets pp
  WHERE pp.patient_id = v_visit.patient_id AND pp.active = true;

  -- Load location prescreening config for custom field label lookup
  SELECT l.prescreening_config INTO v_location_config
  FROM public.locations l WHERE l.id = v_visit.location_id;

  -- Load active custom fields with labels from location config
  SELECT COALESCE(
    (SELECT jsonb_object_agg(sub.field_id::text, jsonb_build_object(
      'label', COALESCE(
        (SELECT cf->>'label'
         FROM jsonb_array_elements(v_location_config->'custom_fields') cf
         WHERE cf->>'id' = sub.field_id::text),
        'Custom field'
      ),
      'values', sub.vals
    ))
     FROM (
       SELECT field_id, jsonb_agg(value ORDER BY created_at) AS vals
       FROM public.patient_custom_fields
       WHERE patient_id = v_visit.patient_id AND active = true
       GROUP BY field_id
     ) sub),
    '{}'::jsonb
  ) INTO v_custom_fields;

  RETURN jsonb_build_object(
    'success', true,
    'visit_id', v_visit.visit_id,
    'queue_number', v_visit.queue_number,
    'status', v_visit.status,
    'patient_first_name', v_visit.patient_first_name,
    'location_name', v_visit.location_name,
    'has_previous_visits', v_visit.has_previous_visits,
    'language', v_visit.language,
    'consent_given', v_visit.consent_given,
    'timeout_flagged', v_visit.timeout_flagged,
    'ai_summary', v_visit.ai_summary,
    'ai_structured_card', v_visit.ai_structured_card,
    'ai_completed_at', v_visit.ai_completed_at,
    'queue_position', v_queue_position,
    'estimated_wait_minutes', v_estimated_wait,
    'phone_verification_pending', v_visit.phone_verification_pending,
    'pending_phone', v_visit.pending_phone,
    'patient_phone_verified', v_visit.patient_phone_verified,
    'patient_has_phone', v_visit.patient_has_phone,
    'patient_birthday', v_visit.patient_birthday,
    'sex', v_visit.sex,
    'patient_denied', v_visit.patient_denied,
    'medications', v_meds,
    'allergies', v_allergies,
    'chronic_conditions', v_chronic,
    'pets', v_pets,
    'staff_room', CASE WHEN v_visit.show_doctor_room_to_patients THEN v_visit.staff_room ELSE NULL END,
    'checkin_mode', v_visit.checkin_mode,
    'arrived_at', v_visit.arrived_at,
    'prescreening_data', v_visit.prescreening_data,
    'ai_skipped', v_visit.ai_skipped,
    'custom_fields', v_custom_fields
  );
END;
$$;

-- Public wrapper (anon-callable, no auth.uid() capture)
CREATE OR REPLACE FUNCTION public.get_patient_session(
  p_session_token uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  RETURN private.get_patient_session(p_session_token);
END;
$$;
