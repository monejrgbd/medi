-- Private implementation
CREATE OR REPLACE FUNCTION private.mark_patient_left(
  p_caller_auth_uid uuid,
  p_visit_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_is_receptionist boolean := false;
BEGIN
  -- Get visit
  SELECT v.* INTO v_visit
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  -- Only allow from pre-claim statuses
  IF v_visit.status NOT IN ('pending_approval', 'still_answering_ai', 'waiting_doctor_claim', 'claimed_by_doctor') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Cannot mark as left from current status');
  END IF;

  -- Get caller staff id
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.org_id = v_visit.org_id
    AND su.is_active = true
    AND su.is_deleted = false;

  -- Authorization: owner or receptionist at location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_visit.org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL;
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'receptionist'
        AND sr.location_id = v_visit.location_id
    ) INTO v_is_receptionist;

    IF NOT v_is_receptionist THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Set audit context
  PERFORM set_config('app.audit_actor_id', COALESCE(v_caller_staff_id::text, p_caller_auth_uid::text), true);
  PERFORM set_config('app.audit_actor_type', 'receptionist', true);
  PERFORM set_config('app.audit_action', 'marked_left', true);

  -- Update status
  UPDATE public.visits
  SET status = 'left',
      claimed_by = NULL,
      claimed_at = NULL,
      updated_at = now()
  WHERE id = p_visit_id;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.mark_patient_left(
  p_visit_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.mark_patient_left(v_auth_uid, p_visit_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.mark_patient_left(uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.mark_patient_left(uuid) TO authenticated;
