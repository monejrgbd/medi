-- attachments bucket (private) — visit attachments (images, PDFs, docs)
-- Path pattern: {org_id}/{visit_id}/{uuid}-{filename}

INSERT INTO storage.buckets (id, name, public, file_size_limit)
VALUES ('attachments', 'attachments', false, 10485760)
ON CONFLICT (id) DO UPDATE SET public = false, file_size_limit = 10485760;

-- SELECT: authenticated, org match
DROP POLICY IF EXISTS "attachments_org_read" ON storage.objects;
CREATE POLICY "attachments_org_read" ON storage.objects FOR SELECT
  TO authenticated
  USING (
    bucket_id = 'attachments'
    AND requesting_org_id()::text = (storage.foldername(name))[1]
  );

-- INSERT: authenticated, org match
DROP POLICY IF EXISTS "attachments_org_insert" ON storage.objects;
CREATE POLICY "attachments_org_insert" ON storage.objects FOR INSERT
  TO authenticated
  WITH CHECK (
    bucket_id = 'attachments'
    AND requesting_org_id()::text = (storage.foldername(name))[1]
  );

-- DELETE: authenticated, org match (for cleanup on failed uploads)
DROP POLICY IF EXISTS "attachments_org_delete" ON storage.objects;
CREATE POLICY "attachments_org_delete" ON storage.objects FOR DELETE
  TO authenticated
  USING (
    bucket_id = 'attachments'
    AND requesting_org_id()::text = (storage.foldername(name))[1]
  );
