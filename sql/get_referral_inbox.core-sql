-- Private implementation
CREATE OR REPLACE FUNCTION private.get_referral_inbox(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_limit int DEFAULT 20,
  p_cursor timestamptz DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_is_authorized boolean := false;
  v_limit int;
  v_rows jsonb;
  v_has_more boolean := false;
  v_row_count int;
BEGIN
  -- Get location org
  SELECT l.org_id INTO v_org_id
  FROM public.locations l
  WHERE l.id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Get caller staff id
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.org_id = v_org_id
    AND su.is_active = true
    AND su.is_deleted = false;

  -- Authorization: owner or receptionist/manager at this location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    v_is_authorized := true;
  ELSIF v_caller_staff_id IS NOT NULL THEN
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role IN ('receptionist', 'manager')
        AND sr.location_id = p_location_id
    ) INTO v_is_authorized;
  END IF;

  IF NOT v_is_authorized THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Clamp limit
  v_limit := LEAST(COALESCE(p_limit, 20), 100);

  -- Query referrals
  SELECT COALESCE(jsonb_agg(row_data), '[]'::jsonb)
  INTO v_rows
  FROM (
    SELECT jsonb_build_object(
      'id', r.id,
      'patient_name', r.patient_name,
      'specialty', r.specialty,
      'status', r.status,
      'source', r.source,
      'from_org_name', COALESCE(o.name, r.referral_note, 'External'),
      'from_doctor_name', COALESCE(su.full_name, ''),
      'created_at', r.created_at
    ) AS row_data
    FROM public.referrals r
    LEFT JOIN public.organizations o ON o.id = r.from_org_id
    LEFT JOIN public.staff_users su ON su.id = r.from_doctor_id
    WHERE r.to_location_id = p_location_id
      AND (p_cursor IS NULL OR r.created_at < p_cursor)
    ORDER BY r.created_at DESC
    LIMIT v_limit + 1
  ) sub;

  -- has_more detection
  v_row_count := jsonb_array_length(v_rows);

  IF v_row_count > v_limit THEN
    v_has_more := true;
    v_rows := v_rows - v_limit; -- Remove the extra element
  END IF;

  RETURN jsonb_build_object(
    'success', true,
    'referrals', v_rows,
    'has_more', v_has_more
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_referral_inbox(
  p_location_id uuid,
  p_limit int DEFAULT 20,
  p_cursor timestamptz DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.get_referral_inbox(v_auth_uid, p_location_id, p_limit, p_cursor);
END;
$$;

REVOKE ALL ON FUNCTION public.get_referral_inbox(uuid, int, timestamptz) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.get_referral_inbox(uuid, int, timestamptz) TO authenticated;
