-- Private implementation
CREATE OR REPLACE FUNCTION private.resolve_potential_match(
  p_location_id uuid,
  p_first_name text,
  p_last_name text,
  p_birthday date,
  p_sex text DEFAULT NULL,
  p_phone text DEFAULT NULL,
  p_old_phone text DEFAULT NULL,
  p_action text DEFAULT NULL,
  p_was_referred boolean DEFAULT false,
  p_referred_by text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_clean_first text;
  v_clean_last text;
  v_clean_phone text;
  v_clean_old_phone text;
  v_clean_referred_by text;
  v_patient record;
  v_active_visit record;
  v_has_previous boolean;
  v_new_patient_id uuid;
  v_new_visit record;
  v_other_location_name text;
  v_is_discovery_eligible boolean;
BEGIN
  -- ============================================================
  -- INPUT VALIDATION
  -- ============================================================

  -- Strip HTML from names, trim, enforce length
  v_clean_first := substring(trim(regexp_replace(p_first_name, '<[^>]*>', '', 'g')), 1, 100);
  v_clean_last := substring(trim(regexp_replace(p_last_name, '<[^>]*>', '', 'g')), 1, 100);

  IF v_clean_first = '' OR v_clean_last = '' THEN
    RETURN jsonb_build_object('success', false, 'error', 'First and last name are required');
  END IF;

  -- Reject control chars and digits in names
  IF v_clean_first ~ '[<>&;\\0-9]' OR v_clean_first ~ '[\x00-\x1F]' THEN
    RETURN jsonb_build_object('success', false, 'error', 'First name contains invalid characters');
  END IF;

  IF v_clean_last ~ '[<>&;\\0-9]' OR v_clean_last ~ '[\x00-\x1F]' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Last name contains invalid characters');
  END IF;

  -- Validate birthday
  IF p_birthday IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Birthday is required');
  END IF;

  IF p_birthday >= CURRENT_DATE THEN
    RETURN jsonb_build_object('success', false, 'error', 'Birthday must be in the past');
  END IF;

  IF p_birthday < '1900-01-01'::date THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid birthday');
  END IF;

  -- Sex validation if provided
  IF p_sex IS NOT NULL AND p_sex NOT IN ('male', 'female', 'other') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid sex value');
  END IF;

  -- Phone validation (new phone) if provided
  IF p_phone IS NOT NULL AND p_phone <> '' THEN
    v_clean_phone := regexp_replace(p_phone, '[^0-9+]', '', 'g');
    IF left(v_clean_phone, 1) = '+' THEN
      v_clean_phone := '+' || regexp_replace(substring(v_clean_phone, 2), '[^0-9]', '', 'g');
    END IF;
    IF v_clean_phone !~ '^\+[1-9][0-9]{1,14}$' THEN
      RETURN jsonb_build_object('success', false, 'error', 'Invalid phone number format');
    END IF;
  ELSE
    v_clean_phone := NULL;
  END IF;

  -- Old phone validation if provided
  IF p_old_phone IS NOT NULL AND p_old_phone <> '' THEN
    v_clean_old_phone := regexp_replace(p_old_phone, '[^0-9+]', '', 'g');
    IF left(v_clean_old_phone, 1) = '+' THEN
      v_clean_old_phone := '+' || regexp_replace(substring(v_clean_old_phone, 2), '[^0-9]', '', 'g');
    END IF;
    IF v_clean_old_phone !~ '^\+[1-9][0-9]{1,14}$' THEN
      RETURN jsonb_build_object('success', false, 'error', 'Invalid old phone number format');
    END IF;
  ELSE
    v_clean_old_phone := NULL;
  END IF;

  -- Sanitize referred_by
  IF p_was_referred AND p_referred_by IS NOT NULL THEN
    v_clean_referred_by := substring(trim(regexp_replace(p_referred_by, '<[^>]*>', '', 'g')), 1, 200);
  ELSE
    v_clean_referred_by := NULL;
  END IF;

  -- Validate action
  IF p_action IS NULL OR p_action NOT IN ('phone_change', 'no_phone_verify', 'add_phone', 'new_patient') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid action');
  END IF;

  -- Validate location exists and get org_id
  SELECT l.org_id INTO v_org_id
  FROM public.locations l
  WHERE l.id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Check subscription status
  IF EXISTS (
    SELECT 1 FROM public.organizations o
    WHERE o.id = v_org_id
      AND o.subscription_plan IN ('expired', 'suspended', 'read_only')
  ) THEN
    RETURN jsonb_build_object('success', false, 'error', 'subscription_inactive');
  END IF;

  -- ============================================================
  -- ACTION: phone_change
  -- ============================================================
  IF p_action = 'phone_change' THEN
    -- Find patient by name + birthday + old phone
    SELECT p.* INTO v_patient
    FROM public.patients p
    WHERE p.org_id = v_org_id
      AND lower(p.first_name) = lower(v_clean_first)
      AND lower(p.last_name) = lower(v_clean_last)
      AND p.birthday = p_birthday
      AND p.phone = v_clean_old_phone
      AND NOT p.is_orphaned
    FOR UPDATE;

    IF v_patient IS NULL THEN
      RETURN jsonb_build_object('success', false, 'error', 'old_phone_mismatch');
    END IF;

    -- Check for active visit
    SELECT v.* INTO v_active_visit
    FROM public.visits v
    WHERE v.patient_id = v_patient.id
      AND v.status NOT IN ('completed', 'left')
    ORDER BY v.created_at DESC
    LIMIT 1;

    IF v_active_visit IS NOT NULL THEN
      -- Cross-location detection
      IF v_active_visit.location_id <> p_location_id THEN
        SELECT l.name INTO v_other_location_name
        FROM public.locations l WHERE l.id = v_active_visit.location_id;

        INSERT INTO public.audit_trail (org_id, location_id, actor_type, action, entity_type, entity_id, details)
        VALUES (
          v_org_id,
          v_active_visit.location_id,
          'patient',
          'cross_location_checkin_attempt',
          'visit',
          v_active_visit.id,
          jsonb_build_object(
            'attempted_location', p_location_id,
            'active_location', v_active_visit.location_id
          )
        );

        RETURN jsonb_build_object(
          'success', true,
          'match_type', 'active_session',
          'session_token', v_active_visit.session_token,
          'has_previous_visits', true,
          'active_at_other_location', true,
          'other_location_name', v_other_location_name,
          'queue_number', v_active_visit.queue_number
        );
      END IF;

      RETURN jsonb_build_object(
        'success', true,
        'match_type', 'active_session',
        'session_token', v_active_visit.session_token,
        'has_previous_visits', true,
        'queue_number', v_active_visit.queue_number
      );
    END IF;

    -- Check has_previous_visits
    SELECT EXISTS(
      SELECT 1 FROM public.visits v
      WHERE v.patient_id = v_patient.id AND v.status = 'completed'
    ) INTO v_has_previous;

    -- Create visit with pending_phone (new phone not written to patient yet)
    INSERT INTO public.visits (
      org_id, location_id, patient_id, has_previous_visits,
      is_return_visit, phone_verification_pending, pending_phone,
      self_reported_referral, self_reported_referrer
    )
    VALUES (
      v_org_id, p_location_id, v_patient.id, v_has_previous,
      v_has_previous, true, v_clean_phone,
      p_was_referred, v_clean_referred_by
    )
    RETURNING * INTO v_new_visit;

    RETURN jsonb_build_object(
      'success', true,
      'match_type', 'returning',
      'session_token', v_new_visit.session_token,
      'visit_id', v_new_visit.id,
      'has_previous_visits', v_has_previous,
      'phone_verified', false,
      'is_discovery_eligible', false,
      'queue_number', v_new_visit.queue_number
    );
  END IF;

  -- ============================================================
  -- ACTION: no_phone_verify
  -- ============================================================
  IF p_action = 'no_phone_verify' THEN
    -- Find patient by name + birthday + old phone
    SELECT p.* INTO v_patient
    FROM public.patients p
    WHERE p.org_id = v_org_id
      AND lower(p.first_name) = lower(v_clean_first)
      AND lower(p.last_name) = lower(v_clean_last)
      AND p.birthday = p_birthday
      AND p.phone = v_clean_old_phone
      AND NOT p.is_orphaned
    FOR UPDATE;

    IF v_patient IS NULL THEN
      RETURN jsonb_build_object('success', false, 'error', 'old_phone_mismatch');
    END IF;

    -- Check for active visit
    SELECT v.* INTO v_active_visit
    FROM public.visits v
    WHERE v.patient_id = v_patient.id
      AND v.status NOT IN ('completed', 'left')
    ORDER BY v.created_at DESC
    LIMIT 1;

    IF v_active_visit IS NOT NULL THEN
      -- Cross-location detection
      IF v_active_visit.location_id <> p_location_id THEN
        SELECT l.name INTO v_other_location_name
        FROM public.locations l WHERE l.id = v_active_visit.location_id;

        INSERT INTO public.audit_trail (org_id, location_id, actor_type, action, entity_type, entity_id, details)
        VALUES (
          v_org_id,
          v_active_visit.location_id,
          'patient',
          'cross_location_checkin_attempt',
          'visit',
          v_active_visit.id,
          jsonb_build_object(
            'attempted_location', p_location_id,
            'active_location', v_active_visit.location_id
          )
        );

        RETURN jsonb_build_object(
          'success', true,
          'match_type', 'active_session',
          'session_token', v_active_visit.session_token,
          'has_previous_visits', true,
          'active_at_other_location', true,
          'other_location_name', v_other_location_name,
          'queue_number', v_active_visit.queue_number
        );
      END IF;

      RETURN jsonb_build_object(
        'success', true,
        'match_type', 'active_session',
        'session_token', v_active_visit.session_token,
        'has_previous_visits', true,
        'queue_number', v_active_visit.queue_number
      );
    END IF;

    -- Check has_previous_visits
    SELECT EXISTS(
      SELECT 1 FROM public.visits v
      WHERE v.patient_id = v_patient.id AND v.status = 'completed'
    ) INTO v_has_previous;

    -- Create visit (no pending_phone, no phone verification needed)
    INSERT INTO public.visits (
      org_id, location_id, patient_id, has_previous_visits,
      is_return_visit, phone_verification_pending,
      self_reported_referral, self_reported_referrer
    )
    VALUES (
      v_org_id, p_location_id, v_patient.id, v_has_previous,
      v_has_previous, false,
      p_was_referred, v_clean_referred_by
    )
    RETURNING * INTO v_new_visit;

    RETURN jsonb_build_object(
      'success', true,
      'match_type', 'returning',
      'session_token', v_new_visit.session_token,
      'visit_id', v_new_visit.id,
      'has_previous_visits', v_has_previous,
      'phone_verified', true,
      'is_discovery_eligible', false,
      'queue_number', v_new_visit.queue_number
    );
  END IF;

  -- ============================================================
  -- ACTION: add_phone
  -- ============================================================
  IF p_action = 'add_phone' THEN
    -- Find null-phone patient by name + birthday
    SELECT p.* INTO v_patient
    FROM public.patients p
    WHERE p.org_id = v_org_id
      AND lower(p.first_name) = lower(v_clean_first)
      AND lower(p.last_name) = lower(v_clean_last)
      AND p.birthday = p_birthday
      AND p.phone IS NULL
      AND NOT p.is_orphaned
    FOR UPDATE;

    IF v_patient IS NULL THEN
      -- Fallback: try primary match on (org_id, name, birthday, phone)
      -- in case another request already wrote the phone
      SELECT p.* INTO v_patient
      FROM public.patients p
      WHERE p.org_id = v_org_id
        AND lower(p.first_name) = lower(v_clean_first)
        AND lower(p.last_name) = lower(v_clean_last)
        AND p.birthday = p_birthday
        AND p.phone = v_clean_phone
        AND NOT p.is_orphaned
      LIMIT 1;

      IF v_patient IS NULL THEN
        RETURN jsonb_build_object('success', false, 'error', 'patient_not_found');
      END IF;

      -- Check for active visit on the fallback patient
      SELECT v.* INTO v_active_visit
      FROM public.visits v
      WHERE v.patient_id = v_patient.id
        AND v.status NOT IN ('completed', 'left')
      ORDER BY v.created_at DESC
      LIMIT 1;

      IF v_active_visit IS NOT NULL THEN
        -- Cross-location detection
        IF v_active_visit.location_id <> p_location_id THEN
          SELECT l.name INTO v_other_location_name
          FROM public.locations l WHERE l.id = v_active_visit.location_id;

          INSERT INTO public.audit_trail (org_id, location_id, actor_type, action, entity_type, entity_id, details)
          VALUES (
            v_org_id,
            v_active_visit.location_id,
            'patient',
            'cross_location_checkin_attempt',
            'visit',
            v_active_visit.id,
            jsonb_build_object(
              'attempted_location', p_location_id,
              'active_location', v_active_visit.location_id
            )
          );

          RETURN jsonb_build_object(
            'success', true,
            'match_type', 'active_session',
            'session_token', v_active_visit.session_token,
            'has_previous_visits', true,
            'active_at_other_location', true,
            'other_location_name', v_other_location_name,
            'queue_number', v_active_visit.queue_number
          );
        END IF;

        RETURN jsonb_build_object(
          'success', true,
          'match_type', 'active_session',
          'session_token', v_active_visit.session_token,
          'has_previous_visits', true,
          'queue_number', v_active_visit.queue_number
        );
      END IF;

      -- Fallback patient exists but no active visit: create one
      SELECT EXISTS(
        SELECT 1 FROM public.visits v
        WHERE v.patient_id = v_patient.id AND v.status = 'completed'
      ) INTO v_has_previous;

      INSERT INTO public.visits (
        org_id, location_id, patient_id, has_previous_visits,
        is_return_visit, phone_verification_pending, pending_phone,
        self_reported_referral, self_reported_referrer
      )
      VALUES (
        v_org_id, p_location_id, v_patient.id, v_has_previous,
        v_has_previous, true, v_clean_phone,
        p_was_referred, v_clean_referred_by
      )
      RETURNING * INTO v_new_visit;

      RETURN jsonb_build_object(
        'success', true,
        'match_type', 'returning',
        'session_token', v_new_visit.session_token,
        'visit_id', v_new_visit.id,
        'has_previous_visits', v_has_previous,
        'phone_verified', false,
        'is_discovery_eligible', false
      );
    END IF;

    -- Found the null-phone patient: check for active visit
    SELECT v.* INTO v_active_visit
    FROM public.visits v
    WHERE v.patient_id = v_patient.id
      AND v.status NOT IN ('completed', 'left')
    ORDER BY v.created_at DESC
    LIMIT 1;

    IF v_active_visit IS NOT NULL THEN
      -- Cross-location detection
      IF v_active_visit.location_id <> p_location_id THEN
        SELECT l.name INTO v_other_location_name
        FROM public.locations l WHERE l.id = v_active_visit.location_id;

        INSERT INTO public.audit_trail (org_id, location_id, actor_type, action, entity_type, entity_id, details)
        VALUES (
          v_org_id,
          v_active_visit.location_id,
          'patient',
          'cross_location_checkin_attempt',
          'visit',
          v_active_visit.id,
          jsonb_build_object(
            'attempted_location', p_location_id,
            'active_location', v_active_visit.location_id
          )
        );

        RETURN jsonb_build_object(
          'success', true,
          'match_type', 'active_session',
          'session_token', v_active_visit.session_token,
          'has_previous_visits', true,
          'active_at_other_location', true,
          'other_location_name', v_other_location_name,
          'queue_number', v_active_visit.queue_number
        );
      END IF;

      RETURN jsonb_build_object(
        'success', true,
        'match_type', 'active_session',
        'session_token', v_active_visit.session_token,
        'has_previous_visits', true,
        'queue_number', v_active_visit.queue_number
      );
    END IF;

    -- Check has_previous_visits
    SELECT EXISTS(
      SELECT 1 FROM public.visits v
      WHERE v.patient_id = v_patient.id AND v.status = 'completed'
    ) INTO v_has_previous;

    -- Create visit with pending_phone
    INSERT INTO public.visits (
      org_id, location_id, patient_id, has_previous_visits,
      is_return_visit, phone_verification_pending, pending_phone,
      self_reported_referral, self_reported_referrer
    )
    VALUES (
      v_org_id, p_location_id, v_patient.id, v_has_previous,
      v_has_previous, true, v_clean_phone,
      p_was_referred, v_clean_referred_by
    )
    RETURNING * INTO v_new_visit;

    RETURN jsonb_build_object(
      'success', true,
      'match_type', 'returning',
      'session_token', v_new_visit.session_token,
      'visit_id', v_new_visit.id,
      'has_previous_visits', v_has_previous,
      'phone_verified', false,
      'is_discovery_eligible', false,
      'queue_number', v_new_visit.queue_number
    );
  END IF;

  -- ============================================================
  -- ACTION: new_patient
  -- ============================================================
  IF p_action = 'new_patient' THEN
    BEGIN
      INSERT INTO public.patients (org_id, first_name, last_name, birthday, sex, phone, phone_verified)
      VALUES (v_org_id, v_clean_first, v_clean_last, p_birthday, p_sex, v_clean_phone, false)
      RETURNING id INTO v_new_patient_id;
    EXCEPTION WHEN unique_violation THEN
      -- Race condition: concurrent insert with same name+birthday
      SELECT p.id INTO v_new_patient_id
      FROM public.patients p
      WHERE p.org_id = v_org_id
        AND lower(p.first_name) = lower(v_clean_first)
        AND lower(p.last_name) = lower(v_clean_last)
        AND p.birthday = p_birthday
        AND NOT p.is_orphaned
      ORDER BY p.created_at ASC
      LIMIT 1;

      IF v_new_patient_id IS NULL THEN
        RETURN jsonb_build_object('success', false, 'error', 'Unable to create patient record');
      END IF;

      -- Check for active session on race-condition patient
      SELECT v.* INTO v_active_visit
      FROM public.visits v
      WHERE v.patient_id = v_new_patient_id
        AND v.status NOT IN ('completed', 'left')
      ORDER BY v.created_at DESC
      LIMIT 1;

      IF v_active_visit IS NOT NULL THEN
        -- Cross-location detection
        IF v_active_visit.location_id <> p_location_id THEN
          SELECT l.name INTO v_other_location_name
          FROM public.locations l WHERE l.id = v_active_visit.location_id;

          INSERT INTO public.audit_trail (org_id, location_id, actor_type, action, entity_type, entity_id, details)
          VALUES (
            v_org_id,
            v_active_visit.location_id,
            'patient',
            'cross_location_checkin_attempt',
            'visit',
            v_active_visit.id,
            jsonb_build_object(
              'attempted_location', p_location_id,
              'active_location', v_active_visit.location_id
            )
          );

          RETURN jsonb_build_object(
            'success', true,
            'match_type', 'active_session',
            'session_token', v_active_visit.session_token,
            'has_previous_visits', true,
            'active_at_other_location', true,
            'other_location_name', v_other_location_name,
            'queue_number', v_active_visit.queue_number
          );
        END IF;

        RETURN jsonb_build_object(
          'success', true,
          'match_type', 'active_session',
          'session_token', v_active_visit.session_token,
          'has_previous_visits', true,
          'queue_number', v_active_visit.queue_number
        );
      END IF;

      -- Create visit on race-winner patient
      INSERT INTO public.visits (
        org_id, location_id, patient_id, has_previous_visits,
        phone_verification_pending,
        self_reported_referral, self_reported_referrer
      )
      VALUES (
        v_org_id, p_location_id, v_new_patient_id, false,
        (v_clean_phone IS NOT NULL),
        p_was_referred, v_clean_referred_by
      )
      RETURNING * INTO v_new_visit;

      -- Check discovery eligibility
      SELECT COALESCE(loc.ask_discovery_source, false) INTO v_is_discovery_eligible
      FROM public.locations loc
      WHERE loc.id = p_location_id;

      RETURN jsonb_build_object(
        'success', true,
        'match_type', 'new',
        'session_token', v_new_visit.session_token,
        'visit_id', v_new_visit.id,
        'has_previous_visits', false,
        'phone_verified', false,
        'is_discovery_eligible', v_is_discovery_eligible
      );
    END;

    -- Normal path: patient created successfully
    INSERT INTO public.visits (
      org_id, location_id, patient_id, has_previous_visits,
      phone_verification_pending,
      self_reported_referral, self_reported_referrer
    )
    VALUES (
      v_org_id, p_location_id, v_new_patient_id, false,
      (v_clean_phone IS NOT NULL),
      p_was_referred, v_clean_referred_by
    )
    RETURNING * INTO v_new_visit;

    -- Check discovery eligibility
    SELECT COALESCE(loc.ask_discovery_source, false) INTO v_is_discovery_eligible
    FROM public.locations loc
    WHERE loc.id = p_location_id;

    RETURN jsonb_build_object(
      'success', true,
      'match_type', 'new',
      'session_token', v_new_visit.session_token,
      'visit_id', v_new_visit.id,
      'has_previous_visits', false,
      'phone_verified', false,
      'is_discovery_eligible', v_is_discovery_eligible,
      'queue_number', v_new_visit.queue_number
    );
  END IF;

  -- Should never reach here due to action validation above
  RETURN jsonb_build_object('success', false, 'error', 'Invalid action');
END;
$$;

-- Public wrapper (anon-callable, no auth.uid() capture needed)
CREATE OR REPLACE FUNCTION public.resolve_potential_match(
  p_location_id uuid,
  p_first_name text,
  p_last_name text,
  p_birthday date,
  p_sex text DEFAULT NULL,
  p_phone text DEFAULT NULL,
  p_old_phone text DEFAULT NULL,
  p_action text DEFAULT NULL,
  p_was_referred boolean DEFAULT false,
  p_referred_by text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  RETURN private.resolve_potential_match(
    p_location_id, p_first_name, p_last_name, p_birthday,
    p_sex, p_phone, p_old_phone, p_action,
    p_was_referred, p_referred_by
  );
END;
$$;
