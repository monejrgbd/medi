-- Private implementation
CREATE OR REPLACE FUNCTION private.deduct_diagnostic_credits(
  p_caller_role text,
  p_org_id uuid,
  p_visit_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org record;
  v_amount numeric := 0.5;
  v_remaining numeric;
  v_rows_inserted int;
  v_from_regular numeric := 0;
  v_from_recharge numeric := 0;
  v_recharge_remaining numeric;
BEGIN
  -- Lock org row FIRST to prevent race conditions
  SELECT credits_total, credits_used, recharge_limit, recharge_used
  INTO v_org
  FROM public.organizations
  WHERE id = p_org_id
  FOR UPDATE;

  IF v_org IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Organization not found');
  END IF;

  -- After lock: check credits_log for existing diagnostic entry (prevents double-deduction)
  IF EXISTS (SELECT 1 FROM public.credits_log WHERE visit_id = p_visit_id AND credit_type = 'diagnostic') THEN
    RETURN jsonb_build_object('success', true, 'already_deducted', true);
  END IF;

  v_remaining := v_org.credits_total - v_org.credits_used;

  IF v_remaining >= v_amount THEN
    v_from_regular := v_amount;
  ELSIF v_org.recharge_limit IS NOT NULL THEN
    v_from_regular := GREATEST(v_remaining, 0);
    v_from_recharge := v_amount - v_from_regular;
    v_recharge_remaining := v_org.recharge_limit - v_org.recharge_used;

    IF v_from_recharge > v_recharge_remaining THEN
      RETURN jsonb_build_object('success', false, 'error', 'no_credits');
    END IF;
  ELSE
    RETURN jsonb_build_object('success', false, 'error', 'no_credits');
  END IF;

  -- Log the deduction with UNIQUE constraint as final guard
  INSERT INTO public.credits_log (org_id, visit_id, credits_amount, ai_model, credit_type, description)
  VALUES (p_org_id, p_visit_id, -v_amount, 'opus', 'diagnostic', 'AI diagnostic credit deduction')
  ON CONFLICT (visit_id, credit_type) WHERE visit_id IS NOT NULL DO NOTHING;

  GET DIAGNOSTICS v_rows_inserted = ROW_COUNT;
  IF v_rows_inserted = 0 THEN
    RETURN jsonb_build_object('success', true, 'already_deducted', true);
  END IF;

  -- Deduct credits
  UPDATE public.organizations
  SET credits_used = credits_used + v_from_regular,
      recharge_used = recharge_used + v_from_recharge
  WHERE id = p_org_id;

  -- Update visit with additional credit info
  UPDATE public.visits
  SET credits_charged = credits_charged + v_amount
  WHERE id = p_visit_id;

  RETURN jsonb_build_object('success', true, 'credits_deducted', v_amount);
END;
$$;

-- Public wrapper (service-role only)
CREATE OR REPLACE FUNCTION public.deduct_diagnostic_credits(
  p_org_id uuid,
  p_visit_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  IF auth.role() <> 'service_role' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  RETURN private.deduct_diagnostic_credits(auth.role(), p_org_id, p_visit_id);
END;
$$;
