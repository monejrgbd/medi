-- Private implementation
CREATE OR REPLACE FUNCTION private.exclude_campaign_recipient(
  p_caller_auth_uid uuid,
  p_campaign_id uuid,
  p_recipient_id uuid,
  p_excluded boolean
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_campaign record;
  v_updated int;
BEGIN
  -- Try owner
  SELECT id INTO v_org_id FROM public.organizations WHERE owner_id = p_caller_auth_uid;
  -- If not owner, try marketer
  IF v_org_id IS NULL THEN
    SELECT su.org_id INTO v_org_id
    FROM public.staff_users su
    JOIN public.staff_roles sr ON sr.staff_user_id = su.id
    WHERE su.auth_uid = p_caller_auth_uid
      AND su.is_active AND NOT su.is_deleted
      AND sr.role = 'marketer';
  END IF;
  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Load campaign
  SELECT id, status
  INTO v_campaign
  FROM public.sms_campaigns
  WHERE id = p_campaign_id
    AND org_id = v_org_id;

  IF v_campaign IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Campaign not found');
  END IF;

  -- Guard: must be in ready status
  IF v_campaign.status <> 'ready' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Campaign must be in ready status to modify recipients');
  END IF;

  -- Update recipient
  UPDATE public.sms_campaign_recipients
  SET excluded = p_excluded,
      status = CASE WHEN p_excluded THEN 'excluded' ELSE 'pending' END
  WHERE id = p_recipient_id
    AND campaign_id = p_campaign_id;

  GET DIAGNOSTICS v_updated = ROW_COUNT;

  IF v_updated = 0 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Recipient not found');
  END IF;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.exclude_campaign_recipient(
  p_campaign_id uuid,
  p_recipient_id uuid,
  p_excluded boolean
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid uuid;
BEGIN
  v_uid := auth.uid();
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;

  RETURN private.exclude_campaign_recipient(v_uid, p_campaign_id, p_recipient_id, p_excluded);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.exclude_campaign_recipient(uuid, uuid, boolean) FROM anon;
GRANT EXECUTE ON FUNCTION public.exclude_campaign_recipient(uuid, uuid, boolean) TO authenticated;
