-- Private implementation
CREATE OR REPLACE FUNCTION private.submit_feature_request(
  p_caller_auth_uid uuid,
  p_content text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_staff_user_id uuid;
  v_org_id uuid;
BEGIN
  SELECT su.id, su.org_id INTO v_staff_user_id, v_org_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_deleted = false;

  IF v_staff_user_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user not found');
  END IF;

  INSERT INTO public.feature_requests (staff_user_id, org_id, content)
  VALUES (v_staff_user_id, v_org_id, p_content);

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.submit_feature_request(
  p_content text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.submit_feature_request(v_auth_uid, p_content);
END;
$$;
