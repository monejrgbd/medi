-- Private implementation
CREATE OR REPLACE FUNCTION private.create_referral(
  p_caller_auth_uid uuid,
  p_patient_id uuid,
  p_specialty text,
  p_referral_note text,
  p_included_visit_ids uuid[],
  p_included_attachment_ids uuid[] DEFAULT NULL,
  p_to_location_id uuid DEFAULT NULL,
  p_to_email text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_caller_staff_id uuid;
  v_caller_org_id uuid;
  v_caller_location_id uuid;
  v_owner_id uuid;
  v_is_doctor boolean := false;
  v_clean_specialty text;
  v_clean_note text;
  v_clean_email text;
  v_patient record;
  v_to_org_id uuid;
  v_referral_id uuid;
  v_edge_url text;
  v_secret text;
  v_visit_count int;
  v_attachment_count int;
BEGIN
  -- Sanitize specialty
  v_clean_specialty := regexp_replace(trim(COALESCE(p_specialty, '')), '<[^>]*>', '', 'g');
  IF length(v_clean_specialty) = 0 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Specialty is required');
  END IF;
  IF length(v_clean_specialty) > 50 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Specialty exceeds maximum length');
  END IF;

  -- Sanitize referral note
  v_clean_note := regexp_replace(trim(COALESCE(p_referral_note, '')), '<[^>]*>', '', 'g');
  IF length(v_clean_note) = 0 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Referral note is required');
  END IF;
  IF length(v_clean_note) > 5000 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Referral note exceeds maximum length');
  END IF;

  -- Validate destination: must provide one of to_location_id or to_email (not both, not neither)
  IF p_to_location_id IS NOT NULL AND p_to_email IS NOT NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Provide either a destination location or email, not both');
  END IF;
  IF p_to_location_id IS NULL AND p_to_email IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'A destination location or email is required');
  END IF;

  -- Validate email if provided
  IF p_to_email IS NOT NULL THEN
    v_clean_email := lower(trim(p_to_email));
    IF length(v_clean_email) > 254 THEN
      RETURN jsonb_build_object('success', false, 'error', 'Email exceeds maximum length');
    END IF;
    IF v_clean_email !~ '^[^@\s]+@[^@\s]+\.[^@\s]+$' THEN
      RETURN jsonb_build_object('success', false, 'error', 'Invalid email address');
    END IF;
  END IF;

  -- Validate included_visit_ids
  IF p_included_visit_ids IS NULL OR array_length(p_included_visit_ids, 1) IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'At least one visit must be included');
  END IF;
  IF array_length(p_included_visit_ids, 1) > 50 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Cannot include more than 50 visits');
  END IF;

  -- Validate included_attachment_ids if provided
  IF p_included_attachment_ids IS NOT NULL AND array_length(p_included_attachment_ids, 1) > 50 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Cannot include more than 50 attachments');
  END IF;

  -- Get caller staff info
  SELECT su.id, su.org_id
  INTO v_caller_staff_id, v_caller_org_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_caller_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff account not found');
  END IF;

  -- Authorization: must be a doctor at the org
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_caller_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can create referrals
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'doctor'
    ) INTO v_is_doctor;

    IF NOT v_is_doctor THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Get caller location (most recent doctor role for from_location_id)
  SELECT sr.location_id INTO v_caller_location_id
  FROM public.staff_roles sr
  WHERE sr.staff_user_id = v_caller_staff_id
    AND sr.role = 'doctor'
  ORDER BY sr.staff_user_id
  LIMIT 1;

  -- Validate all included visits exist and belong to caller's org
  SELECT count(*) INTO v_visit_count
  FROM public.visits v
  WHERE v.id = ANY(p_included_visit_ids)
    AND v.org_id = v_caller_org_id;

  IF v_visit_count <> array_length(p_included_visit_ids, 1) THEN
    RETURN jsonb_build_object('success', false, 'error', 'One or more visits not found or not in your organization');
  END IF;

  -- Validate all included attachments exist and belong to caller's org
  IF p_included_attachment_ids IS NOT NULL AND array_length(p_included_attachment_ids, 1) > 0 THEN
    SELECT count(*) INTO v_attachment_count
    FROM public.visit_attachments va
    JOIN public.visits v ON v.id = va.visit_id
    WHERE va.id = ANY(p_included_attachment_ids)
      AND v.org_id = v_caller_org_id;

    IF v_attachment_count <> array_length(p_included_attachment_ids, 1) THEN
      RETURN jsonb_build_object('success', false, 'error', 'One or more attachments not found or not in your organization');
    END IF;
  END IF;

  -- Get patient info (org-scoped to prevent cross-org patient leak)
  SELECT p.first_name, p.last_name, p.birthday
  INTO v_patient
  FROM public.patients p
  WHERE p.id = p_patient_id
    AND p.org_id = v_caller_org_id;

  IF v_patient IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Patient not found');
  END IF;

  -- If to_location_id provided, lookup to_org_id
  IF p_to_location_id IS NOT NULL THEN
    SELECT l.org_id INTO v_to_org_id
    FROM public.locations l
    WHERE l.id = p_to_location_id;

    IF v_to_org_id IS NULL THEN
      RETURN jsonb_build_object('success', false, 'error', 'Destination location not found');
    END IF;
  END IF;

  -- Set has_referral = true on all included visits
  UPDATE public.visits
  SET has_referral = true
  WHERE id = ANY(p_included_visit_ids);

  -- Insert referral
  INSERT INTO public.referrals (
    from_doctor_id, from_location_id, from_org_id,
    to_org_id, to_location_id, to_email,
    specialty, referral_note,
    included_visit_ids, included_attachment_ids,
    patient_id, patient_name, patient_birthday,
    status
  ) VALUES (
    v_caller_staff_id, v_caller_location_id, v_caller_org_id,
    v_to_org_id, p_to_location_id, v_clean_email,
    v_clean_specialty, v_clean_note,
    p_included_visit_ids, p_included_attachment_ids,
    p_patient_id, v_patient.first_name || ' ' || v_patient.last_name, v_patient.birthday,
    'sent'
  )
  RETURNING id INTO v_referral_id;

  -- If to_email: fire async HTTP to generate-referral-pdf edge function
  IF v_clean_email IS NOT NULL THEN
    SELECT decrypted_secret INTO v_edge_url
    FROM vault.decrypted_secrets WHERE name = 'edge_function_url';

    SELECT decrypted_secret INTO v_secret
    FROM vault.decrypted_secrets WHERE name = 'internal_edge_secret';

    IF v_edge_url IS NOT NULL AND v_edge_url <> '' AND v_secret IS NOT NULL AND v_secret <> '' THEN
      PERFORM net.http_post(
        url := v_edge_url || '/generate-referral-pdf',
        headers := jsonb_build_object(
          'Content-Type', 'application/json',
          'x-internal-secret', v_secret
        ),
        body := jsonb_build_object(
          'referral_id', v_referral_id,
          'to_email', v_clean_email
        )
      );
    END IF;
  END IF;

  -- Audit trail
  INSERT INTO public.audit_trail (org_id, entity_type, entity_id, actor_id, actor_type, action, details)
  VALUES (
    v_caller_org_id,
    'referral',
    v_referral_id,
    v_caller_staff_id,
    CASE WHEN v_owner_id = p_caller_auth_uid THEN 'owner' ELSE 'doctor' END,
    'referral_created',
    jsonb_build_object(
      'specialty', v_clean_specialty,
      'destination', COALESCE(p_to_location_id::text, v_clean_email),
      'patient_id', p_patient_id,
      'visit_count', array_length(p_included_visit_ids, 1)
    )
  );

  RETURN jsonb_build_object('success', true, 'referral_id', v_referral_id);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.create_referral(
  p_patient_id uuid,
  p_specialty text,
  p_referral_note text,
  p_included_visit_ids uuid[],
  p_included_attachment_ids uuid[] DEFAULT NULL,
  p_to_location_id uuid DEFAULT NULL,
  p_to_email text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.create_referral(
    v_auth_uid, p_patient_id, p_specialty, p_referral_note,
    p_included_visit_ids, p_included_attachment_ids,
    p_to_location_id, p_to_email
  );
END;
$$;

REVOKE EXECUTE ON FUNCTION public.create_referral(uuid, text, text, uuid[], uuid[], uuid, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.create_referral(uuid, text, text, uuid[], uuid[], uuid, text) TO authenticated;

REVOKE ALL ON FUNCTION public.create_referral(uuid, text, text, uuid[], uuid[], uuid, text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.create_referral(uuid, text, text, uuid[], uuid[], uuid, text) TO authenticated;
