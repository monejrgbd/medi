-- Private implementation
CREATE OR REPLACE FUNCTION private.save_summary(
  p_caller_role text,
  p_visit_id uuid,
  p_summary text,
  p_structured_card jsonb DEFAULT NULL,
  p_diagnostic text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  UPDATE public.visits
  SET ai_summary = p_summary,
      ai_structured_card = p_structured_card,
      ai_diagnostic = p_diagnostic,
      ai_completed_at = now(),
      updated_at = now()
  WHERE id = p_visit_id;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper (service-role only)
CREATE OR REPLACE FUNCTION public.save_summary(
  p_visit_id uuid,
  p_summary text,
  p_structured_card jsonb DEFAULT NULL,
  p_diagnostic text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  IF auth.role() <> 'service_role' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  RETURN private.save_summary(auth.role(), p_visit_id, p_summary, p_structured_card, p_diagnostic);
END;
$$;
