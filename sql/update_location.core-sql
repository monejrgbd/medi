-- Private implementation
CREATE OR REPLACE FUNCTION private.update_location(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_name text DEFAULT NULL,
  p_address text DEFAULT NULL,
  p_specialty text DEFAULT NULL,
  p_operating_hours jsonb DEFAULT NULL,
  p_ai_model text DEFAULT NULL,
  p_display_format text DEFAULT NULL,
  p_referral_email text DEFAULT NULL,
  p_tablet_count int DEFAULT NULL,
  p_timezone text DEFAULT NULL,
  p_logo_url text DEFAULT NULL,
  p_nurse_enabled boolean DEFAULT NULL,
  p_vaccines_enabled boolean DEFAULT NULL,
  p_vitals_enabled boolean DEFAULT NULL,
  p_ai_custom_instructions text DEFAULT NULL,
  p_ai_message_limit integer DEFAULT NULL,
  p_skip_ai boolean DEFAULT NULL,
  p_review_sms_enabled boolean DEFAULT NULL,
  p_diagnostic_enabled boolean DEFAULT NULL,
  p_queue_type text DEFAULT NULL,
  p_raven_api_key text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_is_manager boolean := false;
BEGIN
  -- Get location's org
  SELECT l.org_id INTO v_org_id
  FROM public.locations l
  WHERE l.id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Check if caller is owner
  SELECT owner_id INTO v_owner_id
  FROM public.organizations
  WHERE id = v_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    -- Owner can update any location
    NULL;
  ELSE
    -- Check if caller is manager at this location
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      JOIN public.staff_users su ON su.id = sr.staff_user_id
      WHERE su.auth_uid = p_caller_auth_uid
        AND sr.location_id = p_location_id
        AND sr.role = 'manager'
        AND su.is_active = true
        AND su.is_deleted = false
    ) INTO v_is_manager;

    IF NOT v_is_manager THEN
      RETURN jsonb_build_object('success', false, 'error', 'Only owner or manager can update locations');
    END IF;
  END IF;

  UPDATE public.locations SET
    name = COALESCE(p_name, name),
    address = COALESCE(p_address, address),
    specialty = COALESCE(p_specialty, specialty),
    operating_hours = COALESCE(p_operating_hours, operating_hours),
    ai_model = COALESCE(p_ai_model, ai_model),
    display_format = COALESCE(p_display_format, display_format),
    referral_email = COALESCE(p_referral_email, referral_email),
    tablet_count = COALESCE(p_tablet_count, tablet_count),
    timezone = COALESCE(p_timezone, timezone),
    logo_url = COALESCE(p_logo_url, logo_url),
    nurse_enabled = COALESCE(p_nurse_enabled, nurse_enabled),
    vaccines_enabled = COALESCE(p_vaccines_enabled, vaccines_enabled),
    vitals_enabled = COALESCE(p_vitals_enabled, vitals_enabled),
    ai_custom_instructions = CASE WHEN p_ai_custom_instructions IS NOT NULL THEN NULLIF(trim(p_ai_custom_instructions), '') ELSE ai_custom_instructions END,
    ai_message_limit = CASE WHEN p_ai_message_limit = 0 THEN NULL WHEN p_ai_message_limit IS NOT NULL THEN p_ai_message_limit ELSE ai_message_limit END,
    skip_ai = COALESCE(p_skip_ai, skip_ai),
    review_sms_enabled = COALESCE(p_review_sms_enabled, review_sms_enabled),
    diagnostic_enabled = COALESCE(p_diagnostic_enabled, diagnostic_enabled),
    queue_type = COALESCE(p_queue_type, queue_type),
    raven_api_key = CASE WHEN p_raven_api_key IS NOT NULL THEN NULLIF(trim(p_raven_api_key), '') ELSE raven_api_key END
  WHERE id = p_location_id;

  -- Auto-initialize org vitals when vitals_enabled is turned on
  IF p_vitals_enabled = true THEN
    IF NOT EXISTS(SELECT 1 FROM public.org_vital_configs WHERE org_id = v_org_id) THEN
      PERFORM private.initialize_org_default_vitals(p_caller_auth_uid, v_org_id);
    END IF;
  END IF;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
-- Drop old signatures before creating new one (parameter count changed)
DROP FUNCTION IF EXISTS public.update_location(uuid, text, text, text, jsonb, text, text, text, int, text, text, boolean, boolean, boolean, text, integer);
DROP FUNCTION IF EXISTS public.update_location(uuid, text, text, text, jsonb, text, text, text, int, text, text, boolean, boolean, boolean, text, integer, boolean);
DROP FUNCTION IF EXISTS public.update_location(uuid, text, text, text, jsonb, text, text, text, int, text, text, boolean, boolean, boolean, text, integer, boolean, boolean, boolean);

CREATE OR REPLACE FUNCTION public.update_location(
  p_location_id uuid,
  p_name text DEFAULT NULL,
  p_address text DEFAULT NULL,
  p_specialty text DEFAULT NULL,
  p_operating_hours jsonb DEFAULT NULL,
  p_ai_model text DEFAULT NULL,
  p_display_format text DEFAULT NULL,
  p_referral_email text DEFAULT NULL,
  p_tablet_count int DEFAULT NULL,
  p_timezone text DEFAULT NULL,
  p_logo_url text DEFAULT NULL,
  p_nurse_enabled boolean DEFAULT NULL,
  p_vaccines_enabled boolean DEFAULT NULL,
  p_vitals_enabled boolean DEFAULT NULL,
  p_ai_custom_instructions text DEFAULT NULL,
  p_ai_message_limit integer DEFAULT NULL,
  p_skip_ai boolean DEFAULT NULL,
  p_review_sms_enabled boolean DEFAULT NULL,
  p_diagnostic_enabled boolean DEFAULT NULL,
  p_queue_type text DEFAULT NULL,
  p_raven_api_key text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.update_location(v_auth_uid, p_location_id, p_name, p_address, p_specialty, p_operating_hours, p_ai_model, p_display_format, p_referral_email, p_tablet_count, p_timezone, p_logo_url, p_nurse_enabled, p_vaccines_enabled, p_vitals_enabled, p_ai_custom_instructions, p_ai_message_limit, p_skip_ai, p_review_sms_enabled, p_diagnostic_enabled, p_queue_type, p_raven_api_key);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.update_location(uuid, text, text, text, jsonb, text, text, text, int, text, text, boolean, boolean, boolean, text, integer, boolean, boolean, boolean, text, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.update_location(uuid, text, text, text, jsonb, text, text, text, int, text, text, boolean, boolean, boolean, text, integer, boolean, boolean, boolean, text, text) TO authenticated;
