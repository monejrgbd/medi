-- Private implementation
CREATE OR REPLACE FUNCTION private.update_location(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_name text DEFAULT NULL,
  p_address text DEFAULT NULL,
  p_specialty text DEFAULT NULL,
  p_operating_hours jsonb DEFAULT NULL,
  p_ai_model text DEFAULT NULL,
  p_display_format text DEFAULT NULL,
  p_referral_email text DEFAULT NULL,
  p_tablet_count int DEFAULT NULL,
  p_timezone text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_is_manager boolean := false;
BEGIN
  -- Get location's org
  SELECT l.org_id INTO v_org_id
  FROM public.locations l
  WHERE l.id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Check if caller is owner
  SELECT owner_id INTO v_owner_id
  FROM public.organizations
  WHERE id = v_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    -- Owner can update any location
    NULL;
  ELSE
    -- Check if caller is manager at this location
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      JOIN public.staff_users su ON su.id = sr.staff_user_id
      WHERE su.auth_uid = p_caller_auth_uid
        AND sr.location_id = p_location_id
        AND sr.role = 'manager'
        AND su.is_active = true
        AND su.is_deleted = false
    ) INTO v_is_manager;

    IF NOT v_is_manager THEN
      RETURN jsonb_build_object('success', false, 'error', 'Only owner or manager can update locations');
    END IF;
  END IF;

  UPDATE public.locations SET
    name = COALESCE(p_name, name),
    address = COALESCE(p_address, address),
    specialty = COALESCE(p_specialty, specialty),
    operating_hours = COALESCE(p_operating_hours, operating_hours),
    ai_model = COALESCE(p_ai_model, ai_model),
    display_format = COALESCE(p_display_format, display_format),
    referral_email = COALESCE(p_referral_email, referral_email),
    tablet_count = COALESCE(p_tablet_count, tablet_count),
    timezone = COALESCE(p_timezone, timezone)
  WHERE id = p_location_id;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.update_location(
  p_location_id uuid,
  p_name text DEFAULT NULL,
  p_address text DEFAULT NULL,
  p_specialty text DEFAULT NULL,
  p_operating_hours jsonb DEFAULT NULL,
  p_ai_model text DEFAULT NULL,
  p_display_format text DEFAULT NULL,
  p_referral_email text DEFAULT NULL,
  p_tablet_count int DEFAULT NULL,
  p_timezone text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.update_location(v_auth_uid, p_location_id, p_name, p_address, p_specialty, p_operating_hours, p_ai_model, p_display_format, p_referral_email, p_tablet_count, p_timezone);
END;
$$;
