-- Private implementation
CREATE OR REPLACE FUNCTION private.handle_collision_result(
  p_caller_auth_uid uuid,
  p_visit_id uuid,
  p_phone_matches_existing boolean,
  p_shared_phone boolean DEFAULT false
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_is_receptionist boolean := false;
  v_verified_phone text;
  v_existing_patient record;
  v_new_patient_id uuid;
  v_candidate_id uuid;
BEGIN
  -- Get visit details
  SELECT v.id, v.status, v.location_id, v.org_id, v.patient_id
  INTO v_visit
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  IF v_visit.status <> 'pending_approval' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit is not pending approval');
  END IF;

  -- Get caller staff id
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  -- Authorization: owner or receptionist at visit location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_visit.org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL;
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'receptionist'
        AND sr.location_id = v_visit.location_id
    ) INTO v_is_receptionist;

    IF NOT v_is_receptionist THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Read verified phone from phone_verifications
  SELECT pv.phone INTO v_verified_phone
  FROM public.phone_verifications pv
  WHERE pv.visit_id = p_visit_id
    AND pv.verified_at IS NOT NULL
  ORDER BY pv.verified_at DESC
  LIMIT 1;

  IF v_verified_phone IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'No verified phone found for this visit');
  END IF;

  -- Get existing patient info
  SELECT p.id, p.first_name, p.last_name, p.birthday, p.org_id, p.phone
  INTO v_existing_patient
  FROM public.patients p
  WHERE p.id = v_visit.patient_id;

  IF p_phone_matches_existing THEN
    IF p_shared_phone THEN
      -- Shared phone: block
      RETURN jsonb_build_object(
        'success', false,
        'error', 'shared_phone_blocked',
        'message', 'This name, birthday, and phone combination is blocked. Handle manually.'
      );
    END IF;

    -- Find the collision candidate whose phone matches the verified phone
    SELECT p.id INTO v_candidate_id
    FROM public.patients p
    WHERE p.org_id = v_existing_patient.org_id
      AND lower(p.first_name) = lower(v_existing_patient.first_name)
      AND lower(p.last_name) = lower(v_existing_patient.last_name)
      AND p.birthday = v_existing_patient.birthday
      AND p.id <> v_visit.patient_id
      AND NOT p.is_orphaned
      AND p.phone = v_verified_phone
    LIMIT 1;

    IF v_candidate_id IS NULL THEN
      RETURN jsonb_build_object('success', false, 'error', 'Collision candidate no longer available');
    END IF;

    -- Same person confirmed: mark candidate as verified, clear collision flag
    UPDATE public.patients
    SET phone_verified = true,
        updated_at = now()
    WHERE id = v_candidate_id;

    -- Reassign visit to the confirmed candidate
    UPDATE public.visits
    SET patient_id = v_candidate_id
    WHERE id = p_visit_id;

    -- Set audit context for trigger
    PERFORM set_config('app.audit_actor_id', COALESCE(v_caller_staff_id::text, p_caller_auth_uid::text), true);
    PERFORM set_config('app.audit_actor_type', 'receptionist', true);
    PERFORM set_config('app.audit_action', 'collision_confirmed_same_person', true);

    -- Approve visit
    UPDATE public.visits
    SET status = 'still_answering_ai',
        ai_started_at = now()
    WHERE id = p_visit_id;

    -- Audit trail
    INSERT INTO public.audit_trail (org_id, location_id, actor_id, actor_type, action, entity_type, entity_id, details)
    VALUES (
      v_visit.org_id,
      v_visit.location_id,
      COALESCE(v_caller_staff_id, p_caller_auth_uid),
      'receptionist',
      'collision_confirmed_same_person',
      'visit',
      p_visit_id,
      jsonb_build_object('candidate_id', v_candidate_id, 'phone_masked', '***-***-' || right(v_verified_phone, 4))
    );

    RETURN jsonb_build_object('success', true);
  ELSE
    -- Phone doesn't match: collision confirmed — different person
    -- Flag existing patient
    UPDATE public.patients
    SET collision_flag = true,
        updated_at = now()
    WHERE id = v_existing_patient.id;

    -- Create new patient with verified phone
    INSERT INTO public.patients (org_id, first_name, last_name, birthday, phone, phone_verified, collision_flag)
    VALUES (
      v_existing_patient.org_id,
      v_existing_patient.first_name,
      v_existing_patient.last_name,
      v_existing_patient.birthday,
      v_verified_phone,
      true,
      true
    )
    RETURNING id INTO v_new_patient_id;

    -- Reassign visit to new patient
    UPDATE public.visits
    SET patient_id = v_new_patient_id
    WHERE id = p_visit_id;

    -- Set audit context for trigger
    PERFORM set_config('app.audit_actor_id', COALESCE(v_caller_staff_id::text, p_caller_auth_uid::text), true);
    PERFORM set_config('app.audit_actor_type', 'receptionist', true);
    PERFORM set_config('app.audit_action', 'collision_confirmed_different_person', true);

    -- Approve visit
    UPDATE public.visits
    SET status = 'still_answering_ai',
        ai_started_at = now()
    WHERE id = p_visit_id;

    -- Audit trail
    INSERT INTO public.audit_trail (org_id, location_id, actor_id, actor_type, action, entity_type, entity_id, details)
    VALUES (
      v_visit.org_id,
      v_visit.location_id,
      COALESCE(v_caller_staff_id, p_caller_auth_uid),
      'receptionist',
      'collision_confirmed_different_person',
      'visit',
      p_visit_id,
      jsonb_build_object(
        'existing_patient_id', v_existing_patient.id,
        'new_patient_id', v_new_patient_id,
        'phone_masked', '***-***-' || right(v_verified_phone, 4)
      )
    );

    RETURN jsonb_build_object('success', true);
  END IF;
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.handle_collision_result(
  p_visit_id uuid,
  p_phone_matches_existing boolean,
  p_shared_phone boolean DEFAULT false
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.handle_collision_result(v_auth_uid, p_visit_id, p_phone_matches_existing, p_shared_phone);
END;
$$;
