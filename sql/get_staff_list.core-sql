-- Private implementation
CREATE OR REPLACE FUNCTION private.get_staff_list(
  p_caller_auth_uid uuid,
  p_org_id uuid,
  p_location_id uuid DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_owner_id uuid;
  v_is_owner boolean;
  v_caller_location_id uuid;
  v_result jsonb;
BEGIN
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = p_org_id;
  v_is_owner := (v_owner_id = p_caller_auth_uid);

  -- If not owner, check if manager and scope to their location
  IF NOT v_is_owner THEN
    SELECT sr.location_id INTO v_caller_location_id
    FROM public.staff_roles sr
    JOIN public.staff_users su ON su.id = sr.staff_user_id
    WHERE su.auth_uid = p_caller_auth_uid
      AND sr.role = 'manager'
      AND su.is_active = true AND su.is_deleted = false
    LIMIT 1;

    IF v_caller_location_id IS NULL THEN
      RETURN '[]'::jsonb;
    END IF;

    -- Manager can only see staff at their location
    p_location_id := v_caller_location_id;
  END IF;

  WITH staff_roles_agg AS (
    SELECT
      sr.staff_user_id,
      COALESCE(jsonb_agg(jsonb_build_object(
        'role', sr.role,
        'location_id', sr.location_id,
        'location_name', l.name
      )), '[]'::jsonb) AS roles
    FROM public.staff_roles sr
    JOIN public.locations l ON l.id = sr.location_id
    JOIN public.staff_users su ON su.id = sr.staff_user_id
    WHERE su.org_id = p_org_id AND su.is_deleted = false
    GROUP BY sr.staff_user_id
  )
  SELECT COALESCE(jsonb_agg(staff_row ORDER BY su.created_at), '[]'::jsonb) INTO v_result
  FROM public.staff_users su
  LEFT JOIN staff_roles_agg sra ON sra.staff_user_id = su.id
  CROSS JOIN LATERAL (
    SELECT jsonb_build_object(
      'id', su.id,
      'full_name', su.full_name,
      'username', su.username,
      'is_active', su.is_active,
      'is_deleted', su.is_deleted,
      'created_at', su.created_at,
      'roles', COALESCE(sra.roles, '[]'::jsonb)
    ) AS staff_row
  ) lr
  WHERE su.org_id = p_org_id
    AND su.is_deleted = false
    AND su.username != 'owner'
    AND (p_location_id IS NULL OR su.id IN (
      SELECT sr2.staff_user_id FROM public.staff_roles sr2 WHERE sr2.location_id = p_location_id
    ));

  RETURN v_result;
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_staff_list(
  p_org_id uuid,
  p_location_id uuid DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.get_staff_list(v_auth_uid, p_org_id, p_location_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.get_staff_list(uuid, uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.get_staff_list(uuid, uuid) TO authenticated;
