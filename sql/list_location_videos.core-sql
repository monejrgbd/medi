-- list_location_videos: owner fetches ordered playlist for the config UI.

CREATE OR REPLACE FUNCTION private.list_location_videos(
  p_caller_auth_uid uuid,
  p_location_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_result jsonb;
BEGIN
  SELECT l.org_id INTO v_org_id FROM public.locations l WHERE l.id = p_location_id;
  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found.');
  END IF;

  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;
  IF p_caller_auth_uid IS NULL OR p_caller_auth_uid <> v_owner_id THEN
    RETURN jsonb_build_object('success', false, 'error', 'Only the owner can view TV videos.');
  END IF;

  SELECT COALESCE(jsonb_agg(
           jsonb_build_object(
             'id', lv.id,
             'file_name', lv.file_name,
             'file_size', lv.file_size,
             'mime_type', lv.mime_type,
             'sort_order', lv.sort_order,
             'storage_path', lv.storage_path,
             'created_at', lv.created_at
           )
           ORDER BY lv.sort_order
         ), '[]'::jsonb)
  INTO v_result
  FROM public.location_videos lv
  WHERE lv.location_id = p_location_id;

  RETURN jsonb_build_object('success', true, 'videos', v_result);
END;
$$;

CREATE OR REPLACE FUNCTION public.list_location_videos(
  p_location_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid;
BEGIN
  v_auth_uid := auth.uid();
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.list_location_videos(v_auth_uid, p_location_id);
END;
$$;

REVOKE ALL ON FUNCTION public.list_location_videos(uuid) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.list_location_videos(uuid) TO authenticated;
