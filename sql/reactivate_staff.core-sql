-- Private implementation
CREATE OR REPLACE FUNCTION private.reactivate_staff(
  p_caller_auth_uid uuid,
  p_staff_user_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_target_auth_uid uuid;
  v_is_manager boolean := false;
BEGIN
  SELECT su.org_id, su.auth_uid INTO v_org_id, v_target_auth_uid
  FROM public.staff_users su
  WHERE su.id = p_staff_user_id AND su.is_deleted = false AND su.is_active = false;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user not found or already active');
  END IF;

  -- Authorization: owner or manager at a shared location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can reactivate anyone
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      JOIN public.staff_users su ON su.id = sr.staff_user_id
      WHERE su.auth_uid = p_caller_auth_uid
        AND sr.role = 'manager'
        AND su.is_active = true
        AND su.is_deleted = false
        AND sr.location_id IN (
          SELECT sr2.location_id FROM public.staff_roles sr2
          WHERE sr2.staff_user_id = p_staff_user_id
        )
    ) INTO v_is_manager;

    IF NOT v_is_manager THEN
      RETURN jsonb_build_object('success', false, 'error', 'Only owner or manager can reactivate staff');
    END IF;
  END IF;

  -- Reactivate
  UPDATE public.staff_users
  SET is_active = true
  WHERE id = p_staff_user_id;

  -- Unban auth user to allow login
  IF v_target_auth_uid IS NOT NULL THEN
    UPDATE auth.users SET banned_until = NULL
    WHERE id = v_target_auth_uid;
  END IF;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.reactivate_staff(
  p_staff_user_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.reactivate_staff(v_auth_uid, p_staff_user_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.reactivate_staff(uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.reactivate_staff(uuid) TO authenticated;
