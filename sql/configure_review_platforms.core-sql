-- Private implementation
CREATE OR REPLACE FUNCTION private.configure_review_platforms(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_platforms jsonb
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_location record;
  v_org record;
  v_caller_staff_id uuid;
  v_is_owner boolean := false;
  v_is_manager boolean := false;
  v_platform jsonb;
  v_name text;
  v_url text;
  v_provided_names text[];
  v_first_platform_id uuid;
BEGIN
  -- Get location
  SELECT l.id, l.org_id INTO v_location
  FROM public.locations l WHERE l.id = p_location_id;

  IF v_location IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Get org
  SELECT o.id, o.owner_id INTO v_org
  FROM public.organizations o WHERE o.id = v_location.org_id;

  -- Check auth: owner or manager
  IF v_org.owner_id = p_caller_auth_uid THEN
    v_is_owner := true;
  ELSE
    SELECT su.id INTO v_caller_staff_id
    FROM public.staff_users su
    WHERE su.auth_uid = p_caller_auth_uid
      AND su.org_id = v_location.org_id
      AND su.is_active = true
      AND su.is_deleted = false;

    IF v_caller_staff_id IS NOT NULL THEN
      SELECT true INTO v_is_manager
      FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.location_id = p_location_id
        AND sr.role = 'manager';
    END IF;
  END IF;

  IF NOT v_is_owner AND NOT v_is_manager THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Validate and collect provided platform names
  v_provided_names := ARRAY[]::text[];

  FOR v_platform IN SELECT * FROM jsonb_array_elements(p_platforms)
  LOOP
    v_name := v_platform->>'platform_name';
    v_url := v_platform->>'platform_url';

    -- Validate platform name
    IF v_name NOT IN ('google','yelp','healthgrades','zocdoc','vitals','ratemds','facebook') THEN
      RETURN jsonb_build_object('success', false, 'error', 'Invalid platform: ' || v_name);
    END IF;

    -- Validate URL
    IF v_url IS NULL OR length(v_url) > 500 OR left(v_url, 8) <> 'https://' THEN
      RETURN jsonb_build_object('success', false, 'error', 'Platform URL must start with https:// and be under 500 characters');
    END IF;

    v_provided_names := array_append(v_provided_names, v_name);

    -- Upsert platform
    INSERT INTO public.review_platforms (org_id, location_id, platform_name, platform_url, is_active)
    VALUES (v_location.org_id, p_location_id, v_name, v_url, true)
    ON CONFLICT (location_id, platform_name)
    DO UPDATE SET platform_url = EXCLUDED.platform_url, is_active = true;
  END LOOP;

  -- Deactivate platforms not in the provided list
  UPDATE public.review_platforms
  SET is_active = false
  WHERE location_id = p_location_id
    AND platform_name <> ALL(v_provided_names);

  -- Auto-create review_rotation if none exists and we have at least one platform
  IF array_length(v_provided_names, 1) > 0 THEN
    SELECT rp.id INTO v_first_platform_id
    FROM public.review_platforms rp
    WHERE rp.location_id = p_location_id AND rp.is_active = true
    ORDER BY rp.created_at ASC
    LIMIT 1;

    INSERT INTO public.review_rotation (location_id, org_id, current_platform_id)
    VALUES (p_location_id, v_location.org_id, v_first_platform_id)
    ON CONFLICT (location_id) DO UPDATE
    SET current_platform_id = CASE
      -- If current platform was deactivated, switch to first active one
      WHEN NOT EXISTS (
        SELECT 1 FROM public.review_platforms rp
        WHERE rp.id = public.review_rotation.current_platform_id AND rp.is_active = true
      ) THEN v_first_platform_id
      ELSE public.review_rotation.current_platform_id
    END;
  END IF;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.configure_review_platforms(
  p_location_id uuid,
  p_platforms jsonb
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.configure_review_platforms(v_auth_uid, p_location_id, p_platforms);
END;
$$;

REVOKE ALL ON FUNCTION public.configure_review_platforms(uuid, jsonb) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.configure_review_platforms(uuid, jsonb) TO authenticated;
