-- Private implementation
CREATE OR REPLACE FUNCTION private.deny_patient(
  p_caller_auth_uid uuid,
  p_visit_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_is_receptionist boolean := false;
  v_edge_url text;
  v_secret text;
BEGIN
  -- Get visit details
  SELECT v.* INTO v_visit
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  IF v_visit.status <> 'pending_approval' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit is not pending approval');
  END IF;

  -- Get caller staff id (scoped to visit's org)
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.org_id = v_visit.org_id
    AND su.is_active = true
    AND su.is_deleted = false;

  -- Authorization: owner or receptionist at visit location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_visit.org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL;
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'receptionist'
        AND sr.location_id = v_visit.location_id
    ) INTO v_is_receptionist;

    IF NOT v_is_receptionist THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Set audit context
  PERFORM set_config('app.audit_actor_id', COALESCE(v_caller_staff_id::text, p_caller_auth_uid::text), true);
  PERFORM set_config('app.audit_actor_type', 'receptionist', true);
  PERFORM set_config('app.audit_action', 'denied', true);

  -- Update visit status and mark as denied
  UPDATE public.visits
  SET status = 'left',
      patient_denied = true
  WHERE id = p_visit_id;

  SELECT decrypted_secret INTO v_edge_url
  FROM vault.decrypted_secrets WHERE name = 'edge_function_url';

  SELECT decrypted_secret INTO v_secret
  FROM vault.decrypted_secrets WHERE name = 'internal_edge_secret';

  IF v_edge_url IS NOT NULL AND v_edge_url <> '' AND v_secret IS NOT NULL AND v_secret <> '' THEN
    PERFORM net.http_post(
      url := v_edge_url || '/broadcast-visit-update',
      headers := jsonb_build_object(
        'Content-Type', 'application/json',
        'x-internal-secret', v_secret
      ),
      body := jsonb_build_object(
        'visit_id', p_visit_id,
        'session_token', v_visit.session_token,
        'old_status', 'pending_approval',
        'new_status', 'denied',
        'denied', true
      )
    );
  END IF;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.deny_patient(
  p_visit_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.deny_patient(v_auth_uid, p_visit_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.deny_patient(uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.deny_patient(uuid) TO authenticated;
