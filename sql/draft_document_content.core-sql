-- Private implementation
CREATE OR REPLACE FUNCTION private.draft_document_content(
  p_caller_auth_uid uuid,
  p_document_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_caller_staff_id uuid;
  v_caller_org_id uuid;
  v_owner_id uuid;
  v_has_role boolean := false;
  v_doc record;
  v_edge_url text;
  v_edge_secret text;
  v_anon_key text;
BEGIN
  -- Get caller staff info
  SELECT su.id, su.org_id
  INTO v_caller_staff_id, v_caller_org_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_caller_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff account not found');
  END IF;

  -- Load document
  SELECT cd.id, cd.org_id, cd.location_id, cd.status, cd.created_by
  INTO v_doc
  FROM public.clinical_documents cd
  WHERE cd.id = p_document_id;

  IF v_doc IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Document not found');
  END IF;

  -- Verify document belongs to caller's org
  IF v_doc.org_id <> v_caller_org_id THEN
    RETURN jsonb_build_object('success', false, 'error', 'Document not found');
  END IF;

  -- Status must be 'draft' or 'editing' (can re-draft)
  IF v_doc.status NOT IN ('draft', 'editing') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Document cannot be drafted in current status');
  END IF;

  -- Authorization: owner OR doctor OR the staff who created it
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_caller_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can draft
  ELSIF v_doc.created_by = v_caller_staff_id THEN
    NULL; -- Creator can re-draft
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'doctor'
    ) INTO v_has_role;

    IF NOT v_has_role THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Set status to 'drafting'
  UPDATE public.clinical_documents
  SET status = 'drafting',
      updated_at = now()
  WHERE id = p_document_id;

  -- Read vault secrets
  SELECT decrypted_secret INTO v_edge_url
  FROM vault.decrypted_secrets
  WHERE name = 'edge_function_url';

  SELECT decrypted_secret INTO v_edge_secret
  FROM vault.decrypted_secrets
  WHERE name = 'internal_edge_secret';

  SELECT decrypted_secret INTO v_anon_key
  FROM vault.decrypted_secrets
  WHERE name = 'supabase_anon_key';

  IF v_edge_url IS NULL OR v_edge_secret IS NULL OR v_anon_key IS NULL THEN
    -- Roll back status on config error
    UPDATE public.clinical_documents
    SET status = 'draft',
        updated_at = now()
    WHERE id = p_document_id;

    RETURN jsonb_build_object('success', false, 'error', 'Configuration missing');
  END IF;

  -- Fire-and-forget to generate-document-content edge function
  PERFORM net.http_post(
    url := v_edge_url || '/generate-document-content',
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
      'Authorization', 'Bearer ' || v_anon_key,
      'x-internal-secret', v_edge_secret
    ),
    body := jsonb_build_object(
      'document_id', p_document_id
    )
  );

  -- Audit trail
  INSERT INTO public.audit_trail (org_id, location_id, entity_type, entity_id, actor_id, actor_type, action, details)
  VALUES (
    v_caller_org_id,
    v_doc.location_id,
    'clinical_document',
    p_document_id,
    v_caller_staff_id,
    CASE WHEN v_owner_id = p_caller_auth_uid THEN 'owner' ELSE 'staff' END,
    'document_draft_requested',
    jsonb_build_object(
      'previous_status', v_doc.status
    )
  );

  RETURN jsonb_build_object('success', true, 'document_id', p_document_id);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.draft_document_content(
  p_document_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.draft_document_content(v_auth_uid, p_document_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.draft_document_content(uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.draft_document_content(uuid) TO authenticated;

REVOKE ALL ON FUNCTION public.draft_document_content(uuid) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.draft_document_content(uuid) TO authenticated;
