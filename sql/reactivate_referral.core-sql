-- Private implementation
CREATE OR REPLACE FUNCTION private.reactivate_referral(
  p_caller_auth_uid uuid,
  p_referral_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_referral record;
  v_caller_staff_id uuid;
  v_caller_org_id uuid;
BEGIN
  -- Get referral details
  SELECT r.id, r.status, r.from_org_id
  INTO v_referral
  FROM public.referrals r
  WHERE r.id = p_referral_id;

  IF v_referral IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Referral not found');
  END IF;

  -- Guard: status must be expired
  IF v_referral.status <> 'expired' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Only expired referrals can be reactivated');
  END IF;

  -- Auth: staff at from_org_id only (the referring org reactivates)
  SELECT su.id, su.org_id INTO v_caller_staff_id, v_caller_org_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false
    AND su.org_id = v_referral.from_org_id;

  IF v_caller_org_id IS NULL THEN
    -- Check if caller is owner of from_org
    IF NOT EXISTS (
      SELECT 1 FROM public.organizations o
      WHERE o.owner_id = p_caller_auth_uid
        AND o.id = v_referral.from_org_id
    ) THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Update referral
  UPDATE public.referrals
  SET status = 'sent',
      expired_at = NULL
  WHERE id = p_referral_id;

  -- Audit trail
  INSERT INTO public.audit_trail (org_id, entity_type, entity_id, actor_id, actor_type, action, details)
  VALUES (
    v_referral.from_org_id,
    'referral',
    p_referral_id,
    COALESCE(v_caller_staff_id, p_caller_auth_uid),
    CASE WHEN EXISTS (SELECT 1 FROM public.organizations WHERE owner_id = p_caller_auth_uid AND id = v_referral.from_org_id) THEN 'owner' ELSE 'staff' END,
    'referral_reactivated',
    jsonb_build_object('previous_status', 'expired')
  );

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.reactivate_referral(
  p_referral_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.reactivate_referral(v_auth_uid, p_referral_id);
END;
$$;

REVOKE ALL ON FUNCTION public.reactivate_referral(uuid) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.reactivate_referral(uuid) TO authenticated;
