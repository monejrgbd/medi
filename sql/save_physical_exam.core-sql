-- Private implementation
CREATE OR REPLACE FUNCTION private.save_physical_exam(
  p_caller_auth_uid uuid,
  p_document_id uuid,
  p_physical_exam_raw text,
  p_physical_exam_mode text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_caller_staff_id uuid;
  v_caller_org_id uuid;
  v_owner_id uuid;
  v_has_role boolean := false;
  v_document record;
  v_sanitized text;
BEGIN
  -- Get caller staff info
  SELECT su.id, su.org_id
  INTO v_caller_staff_id, v_caller_org_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_caller_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff account not found');
  END IF;

  -- Load document, verify belongs to caller's org
  SELECT cd.id, cd.org_id, cd.location_id, cd.document_type, cd.status
  INTO v_document
  FROM public.clinical_documents cd
  WHERE cd.id = p_document_id
    AND cd.org_id = v_caller_org_id;

  IF v_document IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Document not found');
  END IF;

  -- Validate document_type is SOAP note
  IF v_document.document_type <> 'clinical_note_soap' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Physical exam is only available for SOAP notes');
  END IF;

  -- Status must be draft, drafting, drafted, or editing
  IF v_document.status NOT IN ('draft', 'drafting', 'drafted', 'editing') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Document status does not allow editing');
  END IF;

  -- Authorization: owner OR doctor at the document's location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_caller_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner allowed
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.location_id = v_document.location_id
        AND sr.role = 'doctor'
    ) INTO v_has_role;

    IF NOT v_has_role THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Validate physical_exam_mode
  IF p_physical_exam_mode NOT IN ('voice', 'buttons', 'text') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid physical exam mode');
  END IF;

  -- Sanitize: strip HTML tags, max 5000 chars
  v_sanitized := regexp_replace(COALESCE(p_physical_exam_raw, ''), '<[^>]*>', '', 'g');
  v_sanitized := left(v_sanitized, 5000);

  -- Update document
  UPDATE public.clinical_documents
  SET physical_exam_raw = v_sanitized,
      physical_exam_mode = p_physical_exam_mode,
      updated_at = now()
  WHERE id = p_document_id;

  -- Audit trail
  INSERT INTO public.audit_trail (org_id, location_id, entity_type, entity_id, actor_id, actor_type, action, details)
  VALUES (
    v_caller_org_id,
    v_document.location_id,
    'clinical_document',
    p_document_id,
    v_caller_staff_id,
    CASE WHEN v_owner_id = p_caller_auth_uid THEN 'owner' ELSE 'staff' END,
    'physical_exam_saved',
    jsonb_build_object(
      'mode', p_physical_exam_mode
    )
  );

  RETURN jsonb_build_object('success', true, 'document_id', p_document_id);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.save_physical_exam(
  p_document_id uuid,
  p_physical_exam_raw text,
  p_physical_exam_mode text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.save_physical_exam(
    v_auth_uid, p_document_id, p_physical_exam_raw, p_physical_exam_mode
  );
END;
$$;

REVOKE ALL ON FUNCTION public.save_physical_exam(uuid, text, text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.save_physical_exam(uuid, text, text) TO authenticated;
