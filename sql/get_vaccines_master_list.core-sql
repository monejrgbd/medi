-- Private implementation
CREATE OR REPLACE FUNCTION private.get_vaccines_master_list(
  p_caller_auth_uid uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_vaccines jsonb;
BEGIN
  SELECT COALESCE(jsonb_agg(row_to_json(q)), '[]'::jsonb)
  INTO v_vaccines
  FROM (
    SELECT v.id, v.name, v.code, v.dose_series
    FROM public.vaccines v
    ORDER BY v.name
  ) q;

  RETURN jsonb_build_object('success', true, 'vaccines', v_vaccines);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_vaccines_master_list()
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.get_vaccines_master_list(v_auth_uid);
END;
$$;

REVOKE ALL ON FUNCTION public.get_vaccines_master_list() FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.get_vaccines_master_list() TO authenticated;
