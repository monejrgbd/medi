-- Private implementation
CREATE OR REPLACE FUNCTION private.staff_check_in(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_role text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_staff_user_id uuid;
  v_org_id uuid;
  v_has_role boolean;
BEGIN
  -- Only doctors and receptionists can check in
  IF p_role NOT IN ('doctor', 'receptionist') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Only doctors and receptionists can check in');
  END IF;

  -- Get staff user
  SELECT su.id, su.org_id INTO v_staff_user_id, v_org_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_staff_user_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user not found');
  END IF;

  -- Verify caller has this role at this location (or is owner)
  SELECT EXISTS(
    SELECT 1 FROM public.staff_roles sr
    WHERE sr.staff_user_id = v_staff_user_id
      AND sr.location_id = p_location_id
      AND sr.role = p_role
  ) INTO v_has_role;

  -- Owner bypass
  IF NOT v_has_role THEN
    IF NOT EXISTS(SELECT 1 FROM public.organizations WHERE id = v_org_id AND owner_id = p_caller_auth_uid) THEN
      RETURN jsonb_build_object('success', false, 'error', 'You do not have this role at this location');
    END IF;
  END IF;

  -- Auto-check out of any other location
  UPDATE public.staff_checkins
  SET checked_out_at = now()
  WHERE staff_user_id = v_staff_user_id
    AND checked_out_at IS NULL;

  -- Create new checkin
  INSERT INTO public.staff_checkins (staff_user_id, location_id, role)
  VALUES (v_staff_user_id, p_location_id, p_role);

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.staff_check_in(
  p_location_id uuid,
  p_role text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.staff_check_in(v_auth_uid, p_location_id, p_role);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.staff_check_in(uuid, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.staff_check_in(uuid, text) TO authenticated;
