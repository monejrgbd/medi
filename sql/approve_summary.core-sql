-- Private implementation
CREATE OR REPLACE FUNCTION private.approve_summary(
  p_visit_id uuid,
  p_session_token uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
BEGIN
  -- Look up visit
  SELECT v.id, v.status, v.session_token, v.created_at, v.patient_id, v.checkin_mode
  INTO v_visit
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  IF v_visit.session_token <> p_session_token THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid session');
  END IF;

  IF v_visit.status <> 'still_answering_ai' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit is not in AI conversation state');
  END IF;

  -- 24-hour session expiry
  IF v_visit.created_at < now() - interval '24 hours' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Session expired');
  END IF;

  -- Set audit context for trigger
  PERFORM set_config('app.audit_actor_id', v_visit.patient_id::text, true);
  PERFORM set_config('app.audit_actor_type', 'patient', true);
  PERFORM set_config('app.audit_action', 'summary_approved', true);

  -- Branch on snapshotted check-in mode:
  --   approve_to_start  -> straight to doctor queue (current behavior)
  --   approve_on_arrival / self_service_on_arrival -> arrival gate first; entered_queue_at
  --     is stamped later by confirm_arrival so queue order anchors on physical arrival.
  IF v_visit.checkin_mode = 'approve_to_start' THEN
    UPDATE public.visits
    SET status = 'waiting_doctor_claim',
        entered_queue_at = now(),
        patient_approved = true,
        patient_approved_at = now(),
        updated_at = now()
    WHERE id = p_visit_id;
  ELSE
    UPDATE public.visits
    SET status = 'awaiting_arrival',
        patient_approved = true,
        patient_approved_at = now(),
        updated_at = now()
    WHERE id = p_visit_id;
  END IF;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper (anon-callable)
CREATE OR REPLACE FUNCTION public.approve_summary(
  p_visit_id uuid,
  p_session_token uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  RETURN private.approve_summary(p_visit_id, p_session_token);
END;
$$;
