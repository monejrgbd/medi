-- Private implementation
CREATE OR REPLACE FUNCTION private.check_credits(
  p_org_id uuid
)
RETURNS numeric
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_total numeric;
  v_used numeric;
  v_recharge_limit int;
  v_recharge_used numeric;
BEGIN
  SELECT credits_total, credits_used, recharge_limit, recharge_used
  INTO v_total, v_used, v_recharge_limit, v_recharge_used
  FROM public.organizations
  WHERE id = p_org_id;

  IF v_total IS NULL THEN
    RETURN 0;
  END IF;

  RETURN GREATEST(v_total - v_used, 0)
       + GREATEST(COALESCE(v_recharge_limit - v_recharge_used, 0), 0);
END;
$$;

-- Public wrapper (service-role only — prevents leaking credit balance to anon callers)
CREATE OR REPLACE FUNCTION public.check_credits(
  p_org_id uuid
)
RETURNS numeric
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  IF auth.role() <> 'service_role' THEN
    RETURN NULL;
  END IF;

  RETURN private.check_credits(p_org_id);
END;
$$;
