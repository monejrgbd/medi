CREATE EXTENSION IF NOT EXISTS pg_cron;

SELECT cron.schedule('ai_timeout_check', '* * * * *', $$
  UPDATE public.visits
  SET status = 'waiting_doctor_claim', timeout_flagged = true,
      entered_queue_at = now(), updated_at = now()
  WHERE status = 'still_answering_ai' AND ai_started_at < now() - interval '30 minutes';
$$);
