-- Private implementation
CREATE OR REPLACE FUNCTION private.checkin_patient(
  p_location_id uuid,
  p_first_name text,
  p_last_name text,
  p_birthday date
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_clean_first text;
  v_clean_last text;
  v_patient record;
  v_active_visit record;
  v_has_previous boolean;
  v_new_patient_id uuid;
  v_new_visit record;
  v_match_type text;
BEGIN
  -- Input validation: strip HTML, trim, enforce length
  v_clean_first := substring(trim(regexp_replace(p_first_name, '<[^>]*>', '', 'g')), 1, 100);
  v_clean_last := substring(trim(regexp_replace(p_last_name, '<[^>]*>', '', 'g')), 1, 100);

  IF v_clean_first = '' OR v_clean_last = '' THEN
    RETURN jsonb_build_object('success', false, 'error', 'First and last name are required');
  END IF;

  -- Validate characters: letters, spaces, hyphens, apostrophes only
  IF v_clean_first !~ '^[a-zA-ZÀ-ÿ\s\-'']+$' THEN
    RETURN jsonb_build_object('success', false, 'error', 'First name contains invalid characters');
  END IF;

  IF v_clean_last !~ '^[a-zA-ZÀ-ÿ\s\-'']+$' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Last name contains invalid characters');
  END IF;

  -- Validate birthday
  IF p_birthday IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Birthday is required');
  END IF;

  IF p_birthday >= CURRENT_DATE THEN
    RETURN jsonb_build_object('success', false, 'error', 'Birthday must be in the past');
  END IF;

  IF p_birthday < '1900-01-01'::date THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid birthday');
  END IF;

  -- Validate location exists and get org_id
  SELECT l.org_id INTO v_org_id
  FROM public.locations l
  WHERE l.id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Look up existing patient (exact match on name + birthday within org)
  SELECT p.* INTO v_patient
  FROM public.patients p
  WHERE p.org_id = v_org_id
    AND lower(p.first_name) = lower(v_clean_first)
    AND lower(p.last_name) = lower(v_clean_last)
    AND p.birthday = p_birthday
  LIMIT 1;

  IF v_patient IS NOT NULL THEN
    -- Existing patient found
    -- Check collision flag
    IF v_patient.collision_flag THEN
      RETURN jsonb_build_object(
        'success', true,
        'match_type', 'phone_required',
        'has_previous_visits', false
      );
    END IF;

    -- Check for concurrent active session
    SELECT v.* INTO v_active_visit
    FROM public.visits v
    WHERE v.patient_id = v_patient.id
      AND v.status NOT IN ('completed', 'left')
    ORDER BY v.created_at DESC
    LIMIT 1;

    IF v_active_visit IS NOT NULL THEN
      RETURN jsonb_build_object(
        'success', true,
        'match_type', 'active_session',
        'session_token', v_active_visit.session_token,
        'has_previous_visits', true
      );
    END IF;

    -- Returning patient: check if they have prior completed visits
    SELECT EXISTS(
      SELECT 1 FROM public.visits v
      WHERE v.patient_id = v_patient.id
        AND v.status = 'completed'
    ) INTO v_has_previous;

    -- Create new visit for returning patient
    INSERT INTO public.visits (org_id, location_id, patient_id, has_previous_visits)
    VALUES (v_org_id, p_location_id, v_patient.id, v_has_previous)
    RETURNING * INTO v_new_visit;

    RETURN jsonb_build_object(
      'success', true,
      'match_type', 'returning',
      'session_token', v_new_visit.session_token,
      'has_previous_visits', v_has_previous
    );
  END IF;

  -- No match: new patient
  BEGIN
    INSERT INTO public.patients (org_id, first_name, last_name, birthday)
    VALUES (v_org_id, v_clean_first, v_clean_last, p_birthday)
    RETURNING id INTO v_new_patient_id;
  EXCEPTION WHEN unique_violation THEN
    -- Race condition: concurrent insert with same name+birthday
    -- Re-query the existing patient and proceed as returning
    SELECT p.id INTO v_new_patient_id
    FROM public.patients p
    WHERE p.org_id = v_org_id
      AND lower(p.first_name) = lower(v_clean_first)
      AND lower(p.last_name) = lower(v_clean_last)
      AND p.birthday = p_birthday
    LIMIT 1;

    IF v_new_patient_id IS NULL THEN
      RETURN jsonb_build_object('success', false, 'error', 'Unable to create patient record');
    END IF;

    -- Check for active session on this race-condition patient
    SELECT v.* INTO v_active_visit
    FROM public.visits v
    WHERE v.patient_id = v_new_patient_id
      AND v.status NOT IN ('completed', 'left')
    ORDER BY v.created_at DESC
    LIMIT 1;

    IF v_active_visit IS NOT NULL THEN
      RETURN jsonb_build_object(
        'success', true,
        'match_type', 'active_session',
        'session_token', v_active_visit.session_token,
        'has_previous_visits', true
      );
    END IF;

    -- Create visit for the race-condition patient
    INSERT INTO public.visits (org_id, location_id, patient_id, has_previous_visits)
    VALUES (v_org_id, p_location_id, v_new_patient_id, false)
    RETURNING * INTO v_new_visit;

    RETURN jsonb_build_object(
      'success', true,
      'match_type', 'returning',
      'session_token', v_new_visit.session_token,
      'has_previous_visits', false
    );
  END;

  -- Create new visit for new patient
  INSERT INTO public.visits (org_id, location_id, patient_id, has_previous_visits)
  VALUES (v_org_id, p_location_id, v_new_patient_id, false)
  RETURNING * INTO v_new_visit;

  RETURN jsonb_build_object(
    'success', true,
    'match_type', 'new',
    'session_token', v_new_visit.session_token,
    'has_previous_visits', false
  );
END;
$$;

-- Public wrapper (anon-callable, no auth.uid() capture)
CREATE OR REPLACE FUNCTION public.checkin_patient(
  p_location_id uuid,
  p_first_name text,
  p_last_name text,
  p_birthday date
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  RETURN private.checkin_patient(p_location_id, p_first_name, p_last_name, p_birthday);
END;
$$;
