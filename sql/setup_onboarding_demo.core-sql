-- Private implementation
CREATE OR REPLACE FUNCTION private.setup_onboarding_demo(
  p_caller_auth_uid uuid,
  p_location_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_staff_user_id uuid;
  v_full_name text;
BEGIN
  -- Verify caller is org owner
  SELECT id INTO v_org_id
  FROM public.organizations
  WHERE owner_id = p_caller_auth_uid;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not an organization owner');
  END IF;

  -- Verify location belongs to this org
  IF NOT EXISTS (
    SELECT 1 FROM public.locations
    WHERE id = p_location_id AND org_id = v_org_id
  ) THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Check if owner already has a staff_users record
  SELECT id INTO v_staff_user_id
  FROM public.staff_users
  WHERE auth_uid = p_caller_auth_uid
    AND org_id = v_org_id
    AND is_deleted = false;

  -- Create staff_users record if needed (using existing auth account, NOT creating new auth.users)
  IF v_staff_user_id IS NULL THEN
    -- Get full_name from auth.users metadata
    SELECT COALESCE(
      raw_user_meta_data->>'full_name',
      email
    ) INTO v_full_name
    FROM auth.users
    WHERE id = p_caller_auth_uid;

    INSERT INTO public.staff_users (org_id, auth_uid, full_name, username)
    VALUES (v_org_id, p_caller_auth_uid, COALESCE(v_full_name, 'Owner'), 'owner')
    RETURNING id INTO v_staff_user_id;
  END IF;

  -- Assign receptionist role at this location if not already assigned
  INSERT INTO public.staff_roles (staff_user_id, location_id, role)
  VALUES (v_staff_user_id, p_location_id, 'receptionist')
  ON CONFLICT (staff_user_id, location_id, role) DO NOTHING;

  -- Check in as receptionist if not already checked in
  IF NOT EXISTS (
    SELECT 1 FROM public.staff_checkins
    WHERE staff_user_id = v_staff_user_id
      AND location_id = p_location_id
      AND role = 'receptionist'
      AND checked_out_at IS NULL
  ) THEN
    -- Check out from any other location first
    UPDATE public.staff_checkins
    SET checked_out_at = now()
    WHERE staff_user_id = v_staff_user_id
      AND checked_out_at IS NULL;

    INSERT INTO public.staff_checkins (staff_user_id, location_id, role)
    VALUES (v_staff_user_id, p_location_id, 'receptionist');
  END IF;

  RETURN jsonb_build_object('success', true, 'staff_user_id', v_staff_user_id);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.setup_onboarding_demo(p_location_id uuid)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.setup_onboarding_demo(v_auth_uid, p_location_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.setup_onboarding_demo(uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.setup_onboarding_demo(uuid) TO authenticated;
