-- Private implementation — called by hourly pg_cron
CREATE OR REPLACE FUNCTION private.cleanup_demo_data()
RETURNS void
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_demo_org_id uuid := 'a24d1aa1-2ae0-4022-b242-9a7dc30fc4b0';
  v_cutoff timestamptz := now() - interval '2 hours';
  v_visit_ids uuid[];
BEGIN
  -- Collect visit IDs to delete
  SELECT array_agg(id) INTO v_visit_ids
  FROM public.visits
  WHERE org_id = v_demo_org_id
    AND created_at < v_cutoff;

  IF v_visit_ids IS NOT NULL AND array_length(v_visit_ids, 1) > 0 THEN
    -- Cascade through ALL dependent tables before deleting visits
    DELETE FROM public.visit_messages WHERE visit_id = ANY(v_visit_ids);
    DELETE FROM public.visit_notes WHERE visit_id = ANY(v_visit_ids);
    DELETE FROM public.visit_attachments WHERE visit_id = ANY(v_visit_ids);
    DELETE FROM public.visit_addendums WHERE visit_id = ANY(v_visit_ids);
    DELETE FROM public.follow_ups WHERE visit_id = ANY(v_visit_ids);
    DELETE FROM public.credits_log WHERE visit_id = ANY(v_visit_ids);
    DELETE FROM public.reviews WHERE visit_id = ANY(v_visit_ids);
    DELETE FROM public.phone_verifications WHERE visit_id = ANY(v_visit_ids);

    -- Delete self-reported referrals linked to demo visits (before unlinking)
    DELETE FROM public.referrals
    WHERE source = 'self_reported'
      AND linked_visit_id = ANY(v_visit_ids);

    -- Referrals: clear linked_visit_id references
    UPDATE public.referrals
    SET linked_visit_id = NULL
    WHERE linked_visit_id = ANY(v_visit_ids);

    -- audit_trail references visits by entity_id (text)
    DELETE FROM public.audit_trail
    WHERE org_id = v_demo_org_id
      AND entity_id = ANY(v_visit_ids);

    DELETE FROM public.sms_log
    WHERE visit_id = ANY(v_visit_ids);

    -- Pre check in tokens reference visits via visit_id FK
    DELETE FROM public.pre_checkin_tokens
    WHERE visit_id = ANY(v_visit_ids);

    -- Clinical documents: delete access log, delivery log, PDFs in storage, then the documents themselves
    DELETE FROM public.document_access_log
    WHERE document_id IN (
      SELECT id FROM public.clinical_documents WHERE visit_id = ANY(v_visit_ids)
    );
    DELETE FROM public.document_delivery_log
    WHERE document_id IN (
      SELECT id FROM public.clinical_documents WHERE visit_id = ANY(v_visit_ids)
    );
    DELETE FROM public.clinical_documents WHERE visit_id = ANY(v_visit_ids);

    -- Delete the visits themselves
    DELETE FROM public.visits WHERE id = ANY(v_visit_ids);
  END IF;

  -- Orphaned clinical documents from the demo org (no visit or older than cutoff)
  DELETE FROM public.document_access_log
  WHERE document_id IN (
    SELECT id FROM public.clinical_documents
    WHERE org_id = v_demo_org_id AND created_at < v_cutoff
  );
  DELETE FROM public.document_delivery_log
  WHERE document_id IN (
    SELECT id FROM public.clinical_documents
    WHERE org_id = v_demo_org_id AND created_at < v_cutoff
  );
  DELETE FROM public.clinical_documents
  WHERE org_id = v_demo_org_id AND created_at < v_cutoff;

  -- Note: PDFs in the clinical-documents storage bucket are NOT deleted here.
  -- Supabase blocks direct DELETE on storage.objects via the protect_delete trigger.
  -- Orphaned PDFs accumulate in demo storage. Matches existing patterns (logos,
  -- attachments are also not cleaned up in SQL). A separate storage janitor using
  -- the Storage HTTP API can clean these up on a longer cadence if needed.

  -- Delete orphan patient child records then patients
  DELETE FROM public.patient_pets WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  DELETE FROM public.patient_medications WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  DELETE FROM public.patient_allergies WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  DELETE FROM public.patient_chronic_conditions WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  -- Additional orphan tables that reference patients and must be cleared first
  DELETE FROM public.patient_notes WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  DELETE FROM public.patient_vaccines WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  DELETE FROM public.patient_vitals WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  DELETE FROM public.sms_campaign_recipients WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  DELETE FROM public.clinical_documents WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  DELETE FROM public.sms_log WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  DELETE FROM public.follow_ups WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  DELETE FROM public.doctor_note_preferences WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  DELETE FROM public.phone_verifications WHERE patient_id IN (
    SELECT id FROM public.patients WHERE org_id = v_demo_org_id
      AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = patients.id)
  );
  DELETE FROM public.patients p
  WHERE p.org_id = v_demo_org_id
    AND NOT EXISTS (SELECT 1 FROM public.visits v WHERE v.patient_id = p.id);

  -- NOTE: demo_access rows are NOT deleted — kept as leads for outreach
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.cleanup_demo_data()
RETURNS void
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  PERFORM private.cleanup_demo_data();
END;
$$;
