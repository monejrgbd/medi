-- Private implementation
CREATE OR REPLACE FUNCTION private.approve_patient(
  p_caller_auth_uid uuid,
  p_visit_id uuid,
  p_is_follow_up boolean DEFAULT false,
  p_follow_up_of_visit_id uuid DEFAULT NULL,
  p_follow_up_id uuid DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_org_id uuid;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_is_receptionist boolean := false;
  v_loc_skip_ai boolean;
  v_loc_forms_before_queue boolean;
  v_skip_requested boolean;
BEGIN
  -- Get visit details
  SELECT v.* INTO v_visit
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  IF v_visit.status <> 'pending_approval' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit is not pending approval');
  END IF;

  -- Block approval while the patient is still confirming their phone via OTP.
  -- Otherwise an unverified phone match could link the visit to the wrong patient record.
  -- No-phone visits have phone_verification_pending = FALSE, so they are unaffected.
  IF v_visit.phone_verification_pending THEN
    RETURN jsonb_build_object('success', false, 'error', 'phone_verification_pending');
  END IF;

  -- Get caller staff id (scoped to visit's org)
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.org_id = v_visit.org_id
    AND su.is_active = true
    AND su.is_deleted = false;

  -- Authorization: owner or receptionist at visit location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_visit.org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can approve
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'receptionist'
        AND sr.location_id = v_visit.location_id
    ) INTO v_is_receptionist;

    IF NOT v_is_receptionist THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Reject approval attempts in self-service mode (no receptionist approval step)
  IF v_visit.checkin_mode = 'self_service_on_arrival' THEN
    RETURN jsonb_build_object('success', false, 'error', 'This visit does not require approval');
  END IF;

  -- Mode 2: patient already chatted remotely and clicked "I have arrived".
  -- entered_queue_at was stamped at arrival time and must NOT be overwritten
  -- here, since arrival time is the canonical queue-order anchor for this mode.
  IF v_visit.checkin_mode = 'approve_on_arrival' THEN
    PERFORM set_config('app.audit_actor_id', COALESCE(v_caller_staff_id::text, p_caller_auth_uid::text), true);
    PERFORM set_config('app.audit_actor_type', CASE WHEN v_owner_id = p_caller_auth_uid THEN 'owner' ELSE 'receptionist' END, true);
    PERFORM set_config('app.audit_action', 'approved_on_arrival', true);

    UPDATE public.visits
    SET status = 'waiting_doctor_claim',
        updated_at = now()
    WHERE id = p_visit_id;

    RETURN jsonb_build_object('success', true, 'mode', 'approve_on_arrival');
  END IF;

  -- Mode 1 (approve_to_start): existing behavior — approval gates chat start.
  -- Resolve intake depth: skip AI? run the prescreening form first (forms only)?
  SELECT COALESCE(l.skip_ai, false), COALESCE(l.forms_before_queue, false)
  INTO v_loc_skip_ai, v_loc_forms_before_queue
  FROM public.locations l WHERE l.id = v_visit.location_id;

  v_skip_requested := v_loc_skip_ai
    OR (v_visit.demo_features IS NOT NULL AND COALESCE((v_visit.demo_features->>'skipAi')::boolean, false));

  -- Express (skip AI, no form): straight to the doctor queue (current behavior).
  IF v_skip_requested AND NOT v_loc_forms_before_queue THEN
    UPDATE public.visits
    SET status = 'waiting_doctor_claim',
        entered_queue_at = now(),
        ai_skipped = true
    WHERE id = p_visit_id;

    PERFORM set_config('app.audit_actor_id', COALESCE(v_caller_staff_id::text, p_caller_auth_uid::text), true);
    PERFORM set_config('app.audit_actor_type', CASE WHEN v_owner_id = p_caller_auth_uid THEN 'owner' ELSE 'receptionist' END, true);
    PERFORM set_config('app.audit_action', CASE WHEN v_loc_skip_ai THEN 'approved_skip_ai' ELSE 'approved_skip_ai_demo' END, true);

    RETURN jsonb_build_object('success', true, 'ai_skipped', true);
  END IF;

  -- Set audit context for trigger
  PERFORM set_config('app.audit_actor_id', COALESCE(v_caller_staff_id::text, p_caller_auth_uid::text), true);
  PERFORM set_config('app.audit_actor_type', CASE WHEN v_owner_id = p_caller_auth_uid THEN 'owner' ELSE 'receptionist' END, true);
  PERFORM set_config('app.audit_action', CASE WHEN v_skip_requested THEN 'approved_forms_only' ELSE 'approved' END, true);

  -- AI path: still_answering_ai -> chat. Forms only (skip AI + forms_before_queue):
  -- still_answering_ai with ai_skipped=true; the client runs the prescreening
  -- form and advance_after_prescreening moves it to the queue with no chat.
  UPDATE public.visits
  SET status = 'still_answering_ai',
      ai_started_at = now(),
      ai_skipped = v_skip_requested
  WHERE id = p_visit_id;

  -- Handle follow-up linkage
  IF p_is_follow_up AND p_follow_up_of_visit_id IS NOT NULL THEN
    -- Validate prior visit exists, is completed, same patient
    IF EXISTS (SELECT 1 FROM public.visits WHERE id = p_follow_up_of_visit_id
               AND status = 'completed' AND patient_id = v_visit.patient_id) THEN
      UPDATE public.visits
      SET is_follow_up = true, follow_up_of = p_follow_up_of_visit_id
      WHERE id = p_visit_id;
    END IF;
    -- Mark the follow-up record as completed (with org_id guard)
    IF p_follow_up_id IS NOT NULL THEN
      UPDATE public.follow_ups SET status = 'completed'
      WHERE id = p_follow_up_id AND status = 'active' AND org_id = v_visit.org_id;

      IF FOUND THEN
        INSERT INTO public.audit_trail (org_id, entity_type, entity_id, actor_id, actor_type, action, details)
        VALUES (v_visit.org_id, 'follow_up', p_follow_up_id,
                COALESCE(v_caller_staff_id, p_caller_auth_uid),
                CASE WHEN v_owner_id = p_caller_auth_uid THEN 'owner' ELSE 'receptionist' END, 'completed',
                jsonb_build_object('completed_via', 'approve_patient', 'visit_id', p_visit_id));
      END IF;
    END IF;
  END IF;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.approve_patient(
  p_visit_id uuid,
  p_is_follow_up boolean DEFAULT false,
  p_follow_up_of_visit_id uuid DEFAULT NULL,
  p_follow_up_id uuid DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.approve_patient(v_auth_uid, p_visit_id, p_is_follow_up, p_follow_up_of_visit_id, p_follow_up_id);
END;
$$;

REVOKE ALL ON FUNCTION public.approve_patient(uuid, boolean, uuid, uuid) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.approve_patient(uuid, boolean, uuid, uuid) TO authenticated;
