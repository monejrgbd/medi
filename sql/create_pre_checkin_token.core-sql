-- Drop old signatures
DROP FUNCTION IF EXISTS private.create_pre_checkin_token(uuid, uuid, text, text);
DROP FUNCTION IF EXISTS public.create_pre_checkin_token(uuid, text, text);
DROP FUNCTION IF EXISTS private.create_pre_checkin_token(uuid, uuid, text, text, text, boolean);
DROP FUNCTION IF EXISTS public.create_pre_checkin_token(uuid, text, text, text, boolean);
DROP FUNCTION IF EXISTS private.create_pre_checkin_token(uuid, uuid, text, text, text, boolean, text, text);
DROP FUNCTION IF EXISTS public.create_pre_checkin_token(uuid, text, text, text, boolean, text, text);

-- Private implementation
CREATE OR REPLACE FUNCTION private.create_pre_checkin_token(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_first_name text,
  p_last_name text,
  p_ai_model text DEFAULT NULL,
  p_skip_ai boolean DEFAULT false,
  p_ai_session_instructions text DEFAULT NULL,
  p_name_match_mode text DEFAULT 'name',
  p_checkin_mode_override text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_caller_staff_id uuid;
  v_caller_org_id uuid;
  v_owner_id uuid;
  v_is_receptionist boolean := false;
  v_clean_first text;
  v_clean_last text;
  v_clean_instructions text;
  v_location_exists boolean;
  v_token_id uuid;
  v_token uuid;
BEGIN
  -- Validate name_match_mode
  IF p_name_match_mode NOT IN ('name', 'none') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid name match mode');
  END IF;

  -- Sanitize names (conditional on mode)
  IF p_name_match_mode = 'name' THEN
    v_clean_first := regexp_replace(trim(COALESCE(p_first_name, '')), '<[^>]*>', '', 'g');
    v_clean_last := regexp_replace(trim(COALESCE(p_last_name, '')), '<[^>]*>', '', 'g');

    IF length(v_clean_first) = 0 OR length(v_clean_last) = 0 THEN
      RETURN jsonb_build_object('success', false, 'error', 'First and last name are required');
    END IF;
    IF length(v_clean_first) > 100 OR length(v_clean_last) > 100 THEN
      RETURN jsonb_build_object('success', false, 'error', 'Name exceeds maximum length');
    END IF;
  ELSE
    v_clean_first := NULL;
    v_clean_last := NULL;
  END IF;

  -- Sanitize session instructions
  v_clean_instructions := left(trim(regexp_replace(COALESCE(p_ai_session_instructions, ''), '<[^>]*>', '', 'g')), 2000);
  IF length(v_clean_instructions) = 0 THEN
    v_clean_instructions := NULL;
  END IF;

  -- Validate ai_model
  IF p_ai_model IS NOT NULL AND p_ai_model NOT IN ('standard', 'advanced', 'precision', 'premium') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid AI model');
  END IF;

  -- Validate checkin_mode_override
  IF p_checkin_mode_override IS NOT NULL
     AND p_checkin_mode_override NOT IN ('approve_to_start', 'approve_on_arrival', 'self_service_on_arrival') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid check-in mode');
  END IF;

  -- Resolve caller
  SELECT su.id, su.org_id INTO v_caller_staff_id, v_caller_org_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_caller_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user not found');
  END IF;

  -- Authorization: owner or receptionist at location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_caller_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can create tokens
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'receptionist'
        AND sr.location_id = p_location_id
    ) INTO v_is_receptionist;

    IF NOT v_is_receptionist THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Check location exists and belongs to org
  SELECT EXISTS(
    SELECT 1 FROM public.locations l
    WHERE l.id = p_location_id AND l.org_id = v_caller_org_id
  ) INTO v_location_exists;

  IF NOT v_location_exists THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Premium AI budget pre-flight check (read-only, no deduction)
  IF p_ai_model = 'premium' THEN
    DECLARE
      v_org record;
      v_cap numeric;
      v_cost numeric;
      v_net_usage numeric;
      v_topup_remaining numeric;
    BEGIN
      SELECT subscription_plan, billing_cycle_start, credits_total, credits_used
      INTO v_org
      FROM public.organizations WHERE id = v_caller_org_id;

      -- PAyG / trials: check general credit pool
      IF v_org.subscription_plan IN ('pay_as_you_go', 'standard_trial', 'premium_trial') THEN
        v_cost := 4; -- PAyG/trial rate
        IF (v_org.credits_total - v_org.credits_used) < v_cost THEN
          RETURN jsonb_build_object('success', false, 'error', 'No Premium AI budget remaining. Top up from the billing page.');
        END IF;
      ELSE
        -- Subscription plans: per-feature budget
        CASE v_org.subscription_plan
          WHEN 'starter' THEN v_cap := 3.5; v_cost := 3.5;
          WHEN 'professional' THEN v_cap := 15; v_cost := 3;
          WHEN 'business' THEN v_cap := 62.5; v_cost := 2.5;
          WHEN 'enterprise' THEN v_cap := 10000; v_cost := 2.5;
          ELSE v_cap := 0; v_cost := 4;
        END CASE;

        SELECT GREATEST(COALESCE(-SUM(credits_amount), 0), 0) INTO v_net_usage
        FROM public.credits_log
        WHERE org_id = v_caller_org_id AND credit_type = 'premium_ai'
          AND created_at >= COALESCE(v_org.billing_cycle_start, now() - interval '30 days');

        IF v_net_usage + v_cost > v_cap THEN
          -- Check top-ups
          SELECT COALESCE(SUM(credits - used), 0) INTO v_topup_remaining
          FROM public.budget_topups
          WHERE org_id = v_caller_org_id AND feature IN ('premium_ai', 'general') AND credits - used > 0;

          IF v_topup_remaining < v_cost THEN
            RETURN jsonb_build_object('success', false, 'error', 'No Premium AI budget remaining. Top up from the billing page.');
          END IF;
        END IF;
      END IF;
    END;
  END IF;

  -- Create token
  INSERT INTO public.pre_checkin_tokens (org_id, location_id, first_name, last_name, created_by, ai_model_override, skip_ai, ai_session_instructions, name_match_mode, checkin_mode_override)
  VALUES (v_caller_org_id, p_location_id, v_clean_first, v_clean_last, v_caller_staff_id, p_ai_model, COALESCE(p_skip_ai, false), v_clean_instructions, p_name_match_mode, p_checkin_mode_override)
  RETURNING id, token INTO v_token_id, v_token;

  RETURN jsonb_build_object(
    'success', true,
    'token', v_token,
    'token_id', v_token_id
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.create_pre_checkin_token(
  p_location_id uuid,
  p_first_name text,
  p_last_name text,
  p_ai_model text DEFAULT NULL,
  p_skip_ai boolean DEFAULT false,
  p_ai_session_instructions text DEFAULT NULL,
  p_name_match_mode text DEFAULT 'name',
  p_checkin_mode_override text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.create_pre_checkin_token(v_auth_uid, p_location_id, p_first_name, p_last_name, p_ai_model, p_skip_ai, p_ai_session_instructions, p_name_match_mode, p_checkin_mode_override);
END;
$$;

REVOKE ALL ON FUNCTION public.create_pre_checkin_token(uuid, text, text, text, boolean, text, text, text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.create_pre_checkin_token(uuid, text, text, text, boolean, text, text, text) TO authenticated;
