-- Kiosk-safe: anon-callable, visit_id as capability token
CREATE OR REPLACE FUNCTION public.create_self_reported_referral(
  p_visit_id uuid,
  p_referred_by text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_patient record;
  v_clean_referred_by text;
  v_referral_id uuid;
BEGIN
  -- Look up visit
  SELECT v.id, v.org_id, v.location_id, v.patient_id
  INTO v_visit
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_visit.id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  -- Idempotency: check if self_reported referral already exists for this visit
  IF EXISTS (
    SELECT 1 FROM public.referrals
    WHERE linked_visit_id = p_visit_id AND source = 'self_reported'
  ) THEN
    RETURN jsonb_build_object('success', true, 'duplicate', true);
  END IF;

  -- Look up patient
  SELECT p.first_name, p.last_name, p.birthday
  INTO v_patient
  FROM public.patients p
  WHERE p.id = v_visit.patient_id;

  IF v_patient.first_name IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Patient not found');
  END IF;

  -- Sanitize referred_by
  v_clean_referred_by := trim(regexp_replace(COALESCE(p_referred_by, ''), '<[^>]*>', '', 'g'));
  IF length(v_clean_referred_by) > 200 THEN
    v_clean_referred_by := substring(v_clean_referred_by FROM 1 FOR 200);
  END IF;

  -- Insert referral
  INSERT INTO public.referrals (
    source,
    from_doctor_id, from_location_id, from_org_id,
    to_org_id, to_location_id,
    patient_id, patient_name, patient_birthday,
    specialty, referral_note,
    included_visit_ids, linked_visit_id,
    status
  ) VALUES (
    'self_reported',
    NULL, NULL, NULL,
    v_visit.org_id, v_visit.location_id,
    v_visit.patient_id,
    v_patient.first_name || ' ' || v_patient.last_name,
    v_patient.birthday,
    'General',
    COALESCE(NULLIF(v_clean_referred_by, ''), 'Self-reported referral'),
    ARRAY[p_visit_id],
    p_visit_id,
    'patient_arrived'
  )
  RETURNING id INTO v_referral_id;

  RETURN jsonb_build_object('success', true, 'referral_id', v_referral_id);
END;
$$;

REVOKE ALL ON FUNCTION public.create_self_reported_referral(uuid, text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.create_self_reported_referral(uuid, text) TO anon;
GRANT EXECUTE ON FUNCTION public.create_self_reported_referral(uuid, text) TO authenticated;
