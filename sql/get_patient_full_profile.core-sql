-- Private implementation
CREATE OR REPLACE FUNCTION private.get_patient_full_profile(
  p_caller_auth_uid uuid,
  p_patient_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_caller_org_id uuid;
  v_caller_staff_id uuid;
  v_owner_auth_uid uuid;
  v_patient record;
  v_visits jsonb;
  v_notes jsonb;
  v_meds jsonb;
  v_allergies jsonb;
  v_chronic jsonb;
  v_pets jsonb;
  v_referrals jsonb;
  v_follow_ups jsonb;
  v_vitals jsonb;
  v_vaccines jsonb;
BEGIN
  -- Verify caller is active staff or org owner
  SELECT o.id, o.owner_id INTO v_caller_org_id, v_owner_auth_uid
  FROM public.organizations o
  WHERE o.owner_id = p_caller_auth_uid;

  IF v_caller_org_id IS NULL THEN
    SELECT su.org_id, su.id INTO v_caller_org_id, v_caller_staff_id
    FROM public.staff_users su
    WHERE su.auth_uid = p_caller_auth_uid
      AND su.is_active = true
      AND su.is_deleted = false;

    IF v_caller_org_id IS NOT NULL THEN
      SELECT o.owner_id INTO v_owner_auth_uid
      FROM public.organizations o
      WHERE o.id = v_caller_org_id;
    END IF;
  END IF;

  IF v_caller_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Load patient with cross-org guard
  SELECT p.id, p.first_name, p.last_name, p.birthday, p.sex, p.phone, p.phone_verified,
         p.language, p.created_at,
         EXISTS(SELECT 1 FROM public.visits v WHERE v.patient_id = p.id AND v.status = 'completed') AS has_previous_visits
  INTO v_patient
  FROM public.patients p
  WHERE p.id = p_patient_id AND p.org_id = v_caller_org_id;

  IF v_patient IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Patient not found');
  END IF;

  -- Last 50 visits
  SELECT COALESCE(jsonb_agg(row_to_json(vr.*) ORDER BY vr.created_at DESC), '[]'::jsonb)
  INTO v_visits
  FROM (
    SELECT v.id, v.status, v.created_at, v.completed_at,
           v.ai_summary, v.doctor_diagnosis, v.priority,
           l.name AS location_name,
           su.full_name AS claimed_by_name
    FROM public.visits v
    LEFT JOIN public.locations l ON l.id = v.location_id
    LEFT JOIN public.staff_users su ON su.id = v.claimed_by
    WHERE v.patient_id = p_patient_id
    ORDER BY v.created_at DESC
    LIMIT 50
  ) vr;

  -- Patient notes
  SELECT COALESCE(jsonb_agg(row_to_json(n.*) ORDER BY n.created_at DESC), '[]'::jsonb)
  INTO v_notes
  FROM (
    SELECT pn.id, pn.content, pn.is_private, pn.created_at,
           su.full_name AS author_name
    FROM public.patient_notes pn
    LEFT JOIN public.staff_users su ON su.id = pn.doctor_id
    WHERE pn.patient_id = p_patient_id
      AND (pn.is_private = false OR pn.doctor_id = v_caller_staff_id OR v_owner_auth_uid = p_caller_auth_uid)
    ORDER BY pn.created_at DESC
  ) n;

  -- Medications
  SELECT COALESCE(jsonb_agg(jsonb_build_object('name', pm.name, 'active', pm.active)), '[]'::jsonb)
  INTO v_meds
  FROM public.patient_medications pm
  WHERE pm.patient_id = p_patient_id;

  -- Allergies
  SELECT COALESCE(jsonb_agg(jsonb_build_object('name', pa.name, 'active', pa.active)), '[]'::jsonb)
  INTO v_allergies
  FROM public.patient_allergies pa
  WHERE pa.patient_id = p_patient_id;

  -- Chronic conditions
  SELECT COALESCE(jsonb_agg(jsonb_build_object('name', pc.name, 'active', pc.active)), '[]'::jsonb)
  INTO v_chronic
  FROM public.patient_chronic_conditions pc
  WHERE pc.patient_id = p_patient_id;

  -- Pets
  SELECT COALESCE(jsonb_agg(jsonb_build_object('name', pp.name, 'active', pp.active)), '[]'::jsonb)
  INTO v_pets
  FROM public.patient_pets pp
  WHERE pp.patient_id = p_patient_id;

  -- Referrals
  SELECT COALESCE(jsonb_agg(row_to_json(ref.*) ORDER BY ref.created_at DESC), '[]'::jsonb)
  INTO v_referrals
  FROM (
    SELECT r.id, r.specialty, r.status, r.created_at,
           to_org.name AS to_org_name,
           from_org.name AS from_org_name
    FROM public.referrals r
    LEFT JOIN public.organizations to_org ON to_org.id = r.to_org_id
    LEFT JOIN public.organizations from_org ON from_org.id = r.from_org_id
    WHERE r.patient_id = p_patient_id
      AND (r.from_org_id = v_caller_org_id OR r.to_org_id = v_caller_org_id)
    ORDER BY r.created_at DESC
    LIMIT 20
  ) ref;

  -- Follow-ups
  SELECT COALESCE(jsonb_agg(row_to_json(fu.*) ORDER BY fu.created_at DESC), '[]'::jsonb)
  INTO v_follow_ups
  FROM (
    SELECT f.id, f.status, f.due_at, f.ai_instructions, f.created_at,
           su.full_name AS doctor_name
    FROM public.follow_ups f
    LEFT JOIN public.staff_users su ON su.id = f.doctor_id
    WHERE f.patient_id = p_patient_id
    ORDER BY f.created_at DESC
    LIMIT 20
  ) fu;

  -- Vitals
  SELECT COALESCE(jsonb_agg(row_to_json(vq.*)), '[]'::jsonb)
  INTO v_vitals
  FROM (
    SELECT pv.id, pv.measured_at, pv.value, pv.notes,
      COALESCE(vt.name, ovc.custom_name) AS vital_name,
      COALESCE(vt.unit, ovc.custom_unit) AS vital_unit,
      ovc.display_order,
      su.full_name AS recorded_by_name
    FROM public.patient_vitals pv
    JOIN public.org_vital_configs ovc ON ovc.id = pv.vital_config_id
    LEFT JOIN public.vital_types vt ON vt.id = ovc.vital_type_id
    LEFT JOIN public.staff_users su ON su.id = pv.recorded_by
    WHERE pv.patient_id = p_patient_id
      AND pv.org_id = v_caller_org_id
    ORDER BY pv.measured_at DESC, ovc.display_order ASC
    LIMIT 100
  ) vq;

  -- Vaccines
  SELECT COALESCE(jsonb_agg(row_to_json(vc.*)), '[]'::jsonb)
  INTO v_vaccines
  FROM (
    SELECT pvac.id, v.name AS vaccine_name, pvac.dose_number,
      pvac.administered_at, pvac.refused, pvac.refusal_reason,
      pvac.lot_number, pvac.manufacturer, pvac.site, pvac.notes,
      su.full_name AS administered_by_name
    FROM public.patient_vaccines pvac
    JOIN public.vaccines v ON v.id = pvac.vaccine_id
    LEFT JOIN public.staff_users su ON su.id = pvac.administered_by
    WHERE pvac.patient_id = p_patient_id
      AND pvac.org_id = v_caller_org_id
    ORDER BY pvac.administered_at DESC
    LIMIT 100
  ) vc;

  RETURN jsonb_build_object(
    'success', true,
    'patient', jsonb_build_object(
      'id', v_patient.id,
      'first_name', v_patient.first_name,
      'last_name', v_patient.last_name,
      'birthday', v_patient.birthday,
      'sex', v_patient.sex,
      'phone', v_patient.phone,
      'phone_verified', v_patient.phone_verified,
      'language', v_patient.language,
      'has_previous_visits', v_patient.has_previous_visits,
      'created_at', v_patient.created_at
    ),
    'visits', v_visits,
    'notes', v_notes,
    'medications', v_meds,
    'allergies', v_allergies,
    'chronic_conditions', v_chronic,
    'pets', v_pets,
    'referrals', v_referrals,
    'follow_ups', v_follow_ups,
    'vitals', v_vitals,
    'vaccines', v_vaccines
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_patient_full_profile(
  p_patient_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid uuid;
BEGIN
  v_uid := auth.uid();
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;

  RETURN private.get_patient_full_profile(v_uid, p_patient_id);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.get_patient_full_profile(uuid) FROM anon;
GRANT EXECUTE ON FUNCTION public.get_patient_full_profile(uuid) TO authenticated;
