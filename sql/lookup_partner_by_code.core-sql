-- Anon-callable. Looks up a code (either an affiliate code or a partner-attributed approval code)
-- and returns just enough to render a "Referred by [name]" badge on the signup form.
-- Returns null if the code does not exist or is not partner-attributed.
-- Display names are not secret; codes have ~32^8 entropy so enumeration is impractical.
CREATE OR REPLACE FUNCTION public.lookup_partner_by_code(p_code text)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_clean      text;
  v_name       text;
  v_type       text;
BEGIN
  IF p_code IS NULL OR trim(p_code) = '' THEN
    RETURN NULL;
  END IF;
  v_clean := upper(trim(p_code));

  -- 1. Approval code path (premium-trial codes generated by a partner)
  SELECT p.display_name, 'premium_trial'
  INTO v_name, v_type
  FROM public.approval_codes ac
  JOIN public.partners p ON p.id = ac.partner_id
  WHERE ac.code = v_clean
    AND ac.used_by_org_id IS NULL
    AND (ac.expires_at IS NULL OR ac.expires_at > now())
  LIMIT 1;

  IF v_name IS NOT NULL THEN
    RETURN jsonb_build_object('display_name', v_name, 'code_type', v_type);
  END IF;

  -- 2. Affiliate code path (multi-use codes)
  SELECT p.display_name, 'affiliate'
  INTO v_name, v_type
  FROM public.affiliate_codes ac
  JOIN public.partners p ON p.id = ac.partner_id
  WHERE lower(ac.code) = lower(v_clean)
    AND (ac.is_active = true OR ac.deactivated_at > now() - interval '1 hour')
    AND p.status = 'active'
  LIMIT 1;

  IF v_name IS NOT NULL THEN
    RETURN jsonb_build_object('display_name', v_name, 'code_type', v_type);
  END IF;

  RETURN NULL;
END;
$$;

GRANT EXECUTE ON FUNCTION public.lookup_partner_by_code(text) TO anon, authenticated;
