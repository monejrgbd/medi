-- Filtered, paginated commission ledger for the partner dashboard.
CREATE OR REPLACE FUNCTION public.get_partner_commissions(
  p_status text DEFAULT NULL,
  p_limit  int DEFAULT 50,
  p_offset int DEFAULT 0
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid     uuid := auth.uid();
  v_partner uuid;
  v_rows    jsonb;
  v_total   int;
BEGIN
  IF v_uid IS NULL THEN
    RAISE EXCEPTION 'Authentication required';
  END IF;
  SELECT id INTO v_partner FROM public.partners WHERE auth_uid = v_uid;
  IF v_partner IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'not_a_partner');
  END IF;

  IF p_status IS NOT NULL AND p_status NOT IN ('pending','paid','clawed_back') THEN
    RETURN jsonb_build_object('success', false, 'error', 'invalid_status');
  END IF;

  SELECT COUNT(*) INTO v_total
  FROM public.partner_commissions
  WHERE partner_id = v_partner
    AND (p_status IS NULL OR status = p_status);

  SELECT COALESCE(jsonb_agg(to_jsonb(c) ORDER BY c.created_at DESC), '[]'::jsonb)
  INTO v_rows
  FROM (
    SELECT
      id, payment_amount_cents, commission_amount_cents, commission_rate,
      payment_date, eligible_for_payout_at, status, payout_id,
      parent_commission_id, created_at
    FROM public.partner_commissions
    WHERE partner_id = v_partner
      AND (p_status IS NULL OR status = p_status)
    ORDER BY created_at DESC
    LIMIT GREATEST(LEAST(p_limit, 200), 1)
    OFFSET GREATEST(p_offset, 0)
  ) c;

  RETURN jsonb_build_object('success', true, 'total', v_total, 'rows', v_rows);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.get_partner_commissions(text, int, int) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.get_partner_commissions(text, int, int) TO authenticated;
