-- Private implementation
CREATE OR REPLACE FUNCTION private.get_vital_types_master_list(
  p_caller_auth_uid uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_types jsonb;
BEGIN
  -- Just verify caller is authenticated (uid not null is checked in public wrapper)
  SELECT COALESCE(jsonb_agg(row_to_json(q) ORDER BY q.display_order), '[]'::jsonb)
  INTO v_types
  FROM (
    SELECT vt.id, vt.name, vt.unit, vt.min_value, vt.max_value, vt.step_value, vt.display_order
    FROM public.vital_types vt
    ORDER BY vt.display_order
  ) q;

  RETURN jsonb_build_object('success', true, 'vital_types', v_types);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_vital_types_master_list()
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.get_vital_types_master_list(v_auth_uid);
END;
$$;

REVOKE ALL ON FUNCTION public.get_vital_types_master_list() FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.get_vital_types_master_list() TO authenticated;
