-- Drop prior signatures explicitly. CREATE OR REPLACE does not modify a function's
-- signature; it creates a second overload. Drop the old ones to avoid REVOKE/GRANT
-- mismatches and ambiguous PostgREST routing.
DROP FUNCTION IF EXISTS public.reset_staff_password(uuid, text);
DROP FUNCTION IF EXISTS private.reset_staff_password(uuid, uuid, text);

-- Private implementation
-- Resets the bcrypt password on auth.users for the given staff user.
-- Optionally emails the new credentials if p_send_credentials_email = true.
-- The new password is supplied by the caller (server action generates a strong
-- random value for the email-and-reset flow).
CREATE OR REPLACE FUNCTION private.reset_staff_password(
  p_caller_auth_uid uuid,
  p_staff_user_id uuid,
  p_new_password text,
  p_send_credentials_email boolean DEFAULT false,
  p_override_email text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_target_auth_uid uuid;
  v_is_manager boolean := false;
  v_email_result jsonb;
  v_email_sent boolean := false;
  v_email_error text;
BEGIN
  -- Get staff's org and auth_uid
  SELECT su.org_id, su.auth_uid INTO v_org_id, v_target_auth_uid
  FROM public.staff_users su
  WHERE su.id = p_staff_user_id AND su.is_deleted = false;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user not found');
  END IF;

  IF v_target_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user has no auth account');
  END IF;

  -- Authorization: owner or manager at a shared location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can reset anyone's password
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      JOIN public.staff_users su ON su.id = sr.staff_user_id
      WHERE su.auth_uid = p_caller_auth_uid
        AND sr.role = 'manager'
        AND su.is_active = true
        AND su.is_deleted = false
        AND sr.location_id IN (
          SELECT sr2.location_id FROM public.staff_roles sr2
          WHERE sr2.staff_user_id = p_staff_user_id
        )
    ) INTO v_is_manager;

    IF NOT v_is_manager THEN
      RETURN jsonb_build_object('success', false, 'error', 'Only owner or manager can reset passwords');
    END IF;
  END IF;

  -- Update password directly in auth.users
  UPDATE auth.users
  SET encrypted_password = extensions.crypt(p_new_password, extensions.gen_salt('bf')),
      updated_at = now()
  WHERE id = v_target_auth_uid;

  -- Optionally email the new credentials. If override email is provided, persist
  -- it on the staff record as the on-file notification_email for next time.
  IF p_send_credentials_email THEN
    IF p_override_email IS NOT NULL AND length(trim(p_override_email)) > 0 THEN
      UPDATE public.staff_users
      SET notification_email = NULLIF(lower(trim(p_override_email)), '')
      WHERE id = p_staff_user_id;
    END IF;

    v_email_result := private.email_staff_credentials(
      p_caller_auth_uid,
      p_staff_user_id,
      p_new_password,
      p_override_email
    );
    v_email_sent := COALESCE((v_email_result->>'success')::boolean, false);
    IF NOT v_email_sent THEN
      v_email_error := v_email_result->>'error';
    END IF;
  END IF;

  RETURN jsonb_build_object(
    'success', true,
    'email_sent', v_email_sent,
    'email_error', v_email_error
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.reset_staff_password(
  p_staff_user_id uuid,
  p_new_password text,
  p_send_credentials_email boolean DEFAULT false,
  p_override_email text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.reset_staff_password(
    v_auth_uid, p_staff_user_id, p_new_password,
    p_send_credentials_email, p_override_email
  );
END;
$$;

REVOKE EXECUTE ON FUNCTION public.reset_staff_password(uuid, text, boolean, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.reset_staff_password(uuid, text, boolean, text) TO authenticated;
