-- Private implementation
CREATE OR REPLACE FUNCTION private.reset_staff_password(
  p_caller_auth_uid uuid,
  p_staff_user_id uuid,
  p_new_password text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_target_auth_uid uuid;
  v_is_manager boolean := false;
BEGIN
  -- Get staff's org and auth_uid
  SELECT su.org_id, su.auth_uid INTO v_org_id, v_target_auth_uid
  FROM public.staff_users su
  WHERE su.id = p_staff_user_id AND su.is_deleted = false;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user not found');
  END IF;

  IF v_target_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff user has no auth account');
  END IF;

  -- Authorization: owner or manager at a shared location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can reset anyone's password
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      JOIN public.staff_users su ON su.id = sr.staff_user_id
      WHERE su.auth_uid = p_caller_auth_uid
        AND sr.role = 'manager'
        AND su.is_active = true
        AND su.is_deleted = false
        AND sr.location_id IN (
          SELECT sr2.location_id FROM public.staff_roles sr2
          WHERE sr2.staff_user_id = p_staff_user_id
        )
    ) INTO v_is_manager;

    IF NOT v_is_manager THEN
      RETURN jsonb_build_object('success', false, 'error', 'Only owner or manager can reset passwords');
    END IF;
  END IF;

  -- Update password directly in auth.users
  UPDATE auth.users
  SET encrypted_password = crypt(p_new_password, gen_salt('bf')),
      updated_at = now()
  WHERE id = v_target_auth_uid;

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.reset_staff_password(
  p_staff_user_id uuid,
  p_new_password text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.reset_staff_password(v_auth_uid, p_staff_user_id, p_new_password);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.reset_staff_password(uuid, text) FROM anon;
GRANT EXECUTE ON FUNCTION public.reset_staff_password(uuid, text) TO authenticated;
