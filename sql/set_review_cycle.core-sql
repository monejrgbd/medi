-- Private implementation
CREATE OR REPLACE FUNCTION private.set_review_cycle(
  p_caller_auth_uid uuid,
  p_location_id uuid,
  p_cycle_days int
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_location record;
  v_org record;
  v_caller_staff_id uuid;
  v_is_owner boolean := false;
  v_is_manager boolean := false;
  v_clamped int;
BEGIN
  -- Clamp cycle_days to 1-90
  v_clamped := GREATEST(1, LEAST(p_cycle_days, 90));

  -- Get location
  SELECT l.id, l.org_id INTO v_location
  FROM public.locations l WHERE l.id = p_location_id;

  IF v_location IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Get org
  SELECT o.id, o.owner_id INTO v_org
  FROM public.organizations o WHERE o.id = v_location.org_id;

  -- Check auth: owner or manager
  IF v_org.owner_id = p_caller_auth_uid THEN
    v_is_owner := true;
  ELSE
    SELECT su.id INTO v_caller_staff_id
    FROM public.staff_users su
    WHERE su.auth_uid = p_caller_auth_uid
      AND su.org_id = v_location.org_id
      AND su.is_active = true
      AND su.is_deleted = false;

    IF v_caller_staff_id IS NOT NULL THEN
      SELECT true INTO v_is_manager
      FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.location_id = p_location_id
        AND sr.role = 'manager';
    END IF;
  END IF;

  IF NOT v_is_owner AND NOT v_is_manager THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Update rotation cycle days
  UPDATE public.review_rotation
  SET cycle_days = v_clamped
  WHERE location_id = p_location_id;

  IF NOT FOUND THEN
    RETURN jsonb_build_object('success', false, 'error', 'No review rotation configured. Add platforms first.');
  END IF;

  RETURN jsonb_build_object('success', true, 'cycle_days', v_clamped);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.set_review_cycle(
  p_location_id uuid,
  p_cycle_days int
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.set_review_cycle(v_auth_uid, p_location_id, p_cycle_days);
END;
$$;

REVOKE ALL ON FUNCTION public.set_review_cycle(uuid, int) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.set_review_cycle(uuid, int) TO authenticated;
