-- Private implementation
CREATE OR REPLACE FUNCTION private.create_location(
  p_caller_auth_uid uuid,
  p_org_id uuid,
  p_name text,
  p_address text DEFAULT NULL,
  p_specialty text DEFAULT NULL,
  p_operating_hours jsonb DEFAULT NULL,
  p_nurse_enabled boolean DEFAULT false,
  p_vitals_enabled boolean DEFAULT true,
  p_vaccines_enabled boolean DEFAULT false,
  p_skip_ai boolean DEFAULT false,
  p_review_sms_enabled boolean DEFAULT true,
  p_diagnostic_enabled boolean DEFAULT true
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_location_id uuid;
  v_owner_id uuid;
BEGIN
  -- Verify caller is the org owner
  SELECT owner_id INTO v_owner_id
  FROM public.organizations
  WHERE id = p_org_id;

  IF v_owner_id IS NULL OR v_owner_id <> p_caller_auth_uid THEN
    RETURN jsonb_build_object('success', false, 'error', 'Only the organization owner can create locations');
  END IF;

  INSERT INTO public.locations (org_id, name, address, specialty, operating_hours, nurse_enabled, vitals_enabled, vaccines_enabled, skip_ai, review_sms_enabled, diagnostic_enabled)
  VALUES (p_org_id, p_name, p_address, p_specialty, p_operating_hours, p_nurse_enabled, p_vitals_enabled, p_vaccines_enabled, p_skip_ai, p_review_sms_enabled, p_diagnostic_enabled)
  RETURNING id INTO v_location_id;

  -- Auto-initialize org vitals if vitals enabled
  IF p_vitals_enabled = true THEN
    IF NOT EXISTS(SELECT 1 FROM public.org_vital_configs WHERE org_id = p_org_id) THEN
      PERFORM private.initialize_org_default_vitals(p_caller_auth_uid, p_org_id);
    END IF;
  END IF;

  -- Set qr_code_url
  UPDATE public.locations
  SET qr_code_url = '/checkin/' || v_location_id
  WHERE id = v_location_id;

  RETURN jsonb_build_object('success', true, 'location_id', v_location_id, 'qr_code_url', '/checkin/' || v_location_id);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.create_location(
  p_org_id uuid,
  p_name text,
  p_address text DEFAULT NULL,
  p_specialty text DEFAULT NULL,
  p_operating_hours jsonb DEFAULT NULL,
  p_nurse_enabled boolean DEFAULT false,
  p_vitals_enabled boolean DEFAULT true,
  p_vaccines_enabled boolean DEFAULT false,
  p_skip_ai boolean DEFAULT false,
  p_review_sms_enabled boolean DEFAULT true,
  p_diagnostic_enabled boolean DEFAULT true
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.create_location(v_auth_uid, p_org_id, p_name, p_address, p_specialty, p_operating_hours, p_nurse_enabled, p_vitals_enabled, p_vaccines_enabled, p_skip_ai, p_review_sms_enabled, p_diagnostic_enabled);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.create_location(uuid, text, text, text, jsonb) FROM anon;
REVOKE EXECUTE ON FUNCTION public.create_location(uuid, text, text, text, jsonb, boolean, boolean, boolean, boolean, boolean, boolean) FROM anon;
GRANT EXECUTE ON FUNCTION public.create_location(uuid, text, text, text, jsonb, boolean, boolean, boolean, boolean, boolean, boolean) TO authenticated;
