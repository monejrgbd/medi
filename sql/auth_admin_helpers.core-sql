-- ============================================================
-- Auth Admin Helpers
-- These functions use Vault (service role key) + HTTP extension
-- to manage auth users entirely from SQL. No server-side admin
-- client needed.
-- ============================================================

-- Prerequisites:
--   INSERT INTO vault.secrets (name, secret) VALUES ('service_role_key', 'your-key-here');
--   The project URL is read from vault secret 'project_url'.
--   INSERT INTO vault.secrets (name, secret) VALUES ('project_url', 'https://xxx.supabase.co');

-- Create an auth user via Supabase Auth Admin API
CREATE OR REPLACE FUNCTION private.create_auth_user(
  p_email text,
  p_password text,
  p_full_name text
)
RETURNS uuid
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_service_key text;
  v_project_url text;
  v_response extensions.http_response;
  v_body jsonb;
  v_auth_uid uuid;
BEGIN
  SELECT decrypted_secret INTO v_service_key
  FROM vault.decrypted_secrets WHERE name = 'service_role_key';

  SELECT decrypted_secret INTO v_project_url
  FROM vault.decrypted_secrets WHERE name = 'project_url';

  IF v_service_key IS NULL OR v_project_url IS NULL THEN
    RAISE EXCEPTION 'Vault secrets not configured (service_role_key, project_url)';
  END IF;

  SELECT * INTO v_response FROM extensions.http((
    'POST',
    v_project_url || '/auth/v1/admin/users',
    ARRAY[
      extensions.http_header('Authorization', 'Bearer ' || v_service_key),
      extensions.http_header('apikey', v_service_key)
    ],
    'application/json',
    jsonb_build_object(
      'email', p_email,
      'password', p_password,
      'email_confirm', true,
      'user_metadata', jsonb_build_object('full_name', p_full_name)
    )::text
  )::extensions.http_request);

  IF v_response.status NOT IN (200, 201) THEN
    v_body := v_response.content::jsonb;
    RAISE EXCEPTION 'Auth user creation failed: %', COALESCE(v_body->>'msg', v_body::text);
  END IF;

  v_body := v_response.content::jsonb;
  v_auth_uid := (v_body->>'id')::uuid;

  RETURN v_auth_uid;
END;
$$;

-- Ban an auth user (for deactivation/deletion)
CREATE OR REPLACE FUNCTION private.ban_auth_user(p_auth_uid uuid)
RETURNS void
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_service_key text;
  v_project_url text;
  v_response extensions.http_response;
BEGIN
  SELECT decrypted_secret INTO v_service_key
  FROM vault.decrypted_secrets WHERE name = 'service_role_key';

  SELECT decrypted_secret INTO v_project_url
  FROM vault.decrypted_secrets WHERE name = 'project_url';

  IF v_service_key IS NULL OR v_project_url IS NULL THEN
    RAISE EXCEPTION 'Vault secrets not configured (service_role_key, project_url)';
  END IF;

  SELECT * INTO v_response FROM extensions.http((
    'PUT',
    v_project_url || '/auth/v1/admin/users/' || p_auth_uid::text,
    ARRAY[
      extensions.http_header('Authorization', 'Bearer ' || v_service_key),
      extensions.http_header('apikey', v_service_key)
    ],
    'application/json',
    jsonb_build_object('ban_duration', '876600h')::text
  )::extensions.http_request);

  IF v_response.status NOT IN (200, 201) THEN
    RAISE EXCEPTION 'Auth user ban failed: %', v_response.content;
  END IF;
END;
$$;

-- Delete an auth user (for rollback on failed org creation)
CREATE OR REPLACE FUNCTION private.delete_auth_user(p_auth_uid uuid)
RETURNS void
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_service_key text;
  v_project_url text;
  v_response extensions.http_response;
BEGIN
  SELECT decrypted_secret INTO v_service_key
  FROM vault.decrypted_secrets WHERE name = 'service_role_key';

  SELECT decrypted_secret INTO v_project_url
  FROM vault.decrypted_secrets WHERE name = 'project_url';

  IF v_service_key IS NULL OR v_project_url IS NULL THEN
    RAISE EXCEPTION 'Vault secrets not configured (service_role_key, project_url)';
  END IF;

  SELECT * INTO v_response FROM extensions.http((
    'DELETE',
    v_project_url || '/auth/v1/admin/users/' || p_auth_uid::text,
    ARRAY[
      extensions.http_header('Authorization', 'Bearer ' || v_service_key),
      extensions.http_header('apikey', v_service_key)
    ],
    'application/json',
    '{}'
  )::extensions.http_request);
END;
$$;

-- Update an auth user's password
CREATE OR REPLACE FUNCTION private.update_auth_user_password(
  p_auth_uid uuid,
  p_new_password text
)
RETURNS void
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_service_key text;
  v_project_url text;
  v_response extensions.http_response;
BEGIN
  SELECT decrypted_secret INTO v_service_key
  FROM vault.decrypted_secrets WHERE name = 'service_role_key';

  SELECT decrypted_secret INTO v_project_url
  FROM vault.decrypted_secrets WHERE name = 'project_url';

  IF v_service_key IS NULL OR v_project_url IS NULL THEN
    RAISE EXCEPTION 'Vault secrets not configured (service_role_key, project_url)';
  END IF;

  SELECT * INTO v_response FROM extensions.http((
    'PUT',
    v_project_url || '/auth/v1/admin/users/' || p_auth_uid::text,
    ARRAY[
      extensions.http_header('Authorization', 'Bearer ' || v_service_key),
      extensions.http_header('apikey', v_service_key)
    ],
    'application/json',
    jsonb_build_object('password', p_new_password)::text
  )::extensions.http_request);

  IF v_response.status NOT IN (200, 201) THEN
    RAISE EXCEPTION 'Password update failed: %', v_response.content;
  END IF;
END;
$$;
