-- Private implementation
CREATE OR REPLACE FUNCTION private.record_vaccine(
  p_caller_auth_uid uuid,
  p_patient_id uuid,
  p_visit_id uuid,
  p_vaccine_id uuid,
  p_dose_number smallint DEFAULT 1,
  p_lot_number text DEFAULT NULL,
  p_manufacturer text DEFAULT NULL,
  p_site text DEFAULT NULL,
  p_refused boolean DEFAULT false,
  p_refusal_reason text DEFAULT NULL,
  p_notes text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_visit record;
  v_caller_staff_id uuid;
  v_owner_id uuid;
  v_nurse_enabled boolean;
  v_vaccines_enabled boolean;
  v_can_access boolean := false;
  v_new_id uuid;
BEGIN
  -- Get visit details
  SELECT v.id, v.org_id, v.location_id, v.patient_id
  INTO v_visit
  FROM public.visits v
  WHERE v.id = p_visit_id;

  IF v_visit IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Visit not found');
  END IF;

  -- Check vaccines_enabled on location
  SELECT l.vaccines_enabled, l.nurse_enabled
  INTO v_vaccines_enabled, v_nurse_enabled
  FROM public.locations l
  WHERE l.id = v_visit.location_id;

  IF v_vaccines_enabled IS NOT TRUE THEN
    RETURN jsonb_build_object('success', false, 'error', 'Vaccines are not enabled at this location');
  END IF;

  -- Get caller staff id
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.org_id = v_visit.org_id
    AND su.is_active = true
    AND su.is_deleted = false;

  IF v_caller_staff_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Staff account not found or inactive');
  END IF;

  -- Authorization: owner or doctor/nurse at visit location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_visit.org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL; -- Owner can record
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.location_id = v_visit.location_id
        AND (sr.role = 'doctor' OR (sr.role = 'nurse' AND v_nurse_enabled = true))
    ) INTO v_can_access;

    IF NOT v_can_access THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Validate vaccine_id exists
  IF NOT EXISTS(SELECT 1 FROM public.vaccines WHERE id = p_vaccine_id) THEN
    RETURN jsonb_build_object('success', false, 'error', 'Vaccine not found');
  END IF;

  -- Validate patient belongs to same org
  IF NOT EXISTS(
    SELECT 1 FROM public.patients p
    WHERE p.id = p_patient_id
      AND p.org_id = v_visit.org_id
  ) THEN
    RETURN jsonb_build_object('success', false, 'error', 'Patient not found in this organization');
  END IF;

  -- Insert vaccine record
  INSERT INTO public.patient_vaccines (
    patient_id, vaccine_id, visit_id, org_id, dose_number,
    lot_number, manufacturer, site, administered_by,
    refused, refusal_reason, notes
  )
  VALUES (
    p_patient_id, p_vaccine_id, p_visit_id, v_visit.org_id, p_dose_number,
    p_lot_number, p_manufacturer, p_site, v_caller_staff_id,
    p_refused, p_refusal_reason, p_notes
  )
  RETURNING id INTO v_new_id;

  -- Auto-complete matching vaccine schedule entry
  UPDATE public.vaccine_schedule
  SET completed_at = now(),
      completed_by = v_new_id
  WHERE patient_id = p_patient_id
    AND vaccine_id = p_vaccine_id
    AND dose_number = p_dose_number
    AND completed_at IS NULL
    AND skipped = false;

  RETURN jsonb_build_object('success', true, 'id', v_new_id);
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.record_vaccine(
  p_patient_id uuid,
  p_visit_id uuid,
  p_vaccine_id uuid,
  p_dose_number smallint DEFAULT 1,
  p_lot_number text DEFAULT NULL,
  p_manufacturer text DEFAULT NULL,
  p_site text DEFAULT NULL,
  p_refused boolean DEFAULT false,
  p_refusal_reason text DEFAULT NULL,
  p_notes text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  IF v_auth_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;
  RETURN private.record_vaccine(
    v_auth_uid, p_patient_id, p_visit_id, p_vaccine_id, p_dose_number,
    p_lot_number, p_manufacturer, p_site, p_refused, p_refusal_reason, p_notes
  );
END;
$$;

REVOKE ALL ON FUNCTION public.record_vaccine(uuid, uuid, uuid, smallint, text, text, text, boolean, text, text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.record_vaccine(uuid, uuid, uuid, smallint, text, text, text, boolean, text, text) TO authenticated;
