-- Private implementation
CREATE OR REPLACE FUNCTION private.deduct_credits(
  p_caller_role text,
  p_org_id uuid,
  p_visit_id uuid,
  p_ai_model text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org record;
  v_amount numeric;
  v_remaining numeric;
  v_rows_inserted int;
  v_from_regular numeric := 0;
  v_from_recharge numeric := 0;
  v_recharge_remaining numeric;
BEGIN
  -- Determine credit amount based on tier (bundled cost: intake + summary + diagnostic)
  -- standard = 1, advanced = 1.5, precision = 2.5, premium = 4
  IF p_ai_model = 'premium' THEN
    v_amount := 4;
  ELSIF p_ai_model = 'precision' THEN
    v_amount := 2.5;
  ELSIF p_ai_model = 'standard' THEN
    v_amount := 1;
  ELSE
    v_amount := 1.5;  -- advanced
  END IF;

  -- Lock org row FIRST to prevent race conditions
  SELECT credits_total, credits_used, recharge_limit, recharge_used, subscription_plan
  INTO v_org
  FROM public.organizations
  WHERE id = p_org_id
  FOR UPDATE;

  IF v_org IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Organization not found');
  END IF;

  -- After lock: check credits_log for existing entry (prevents double-deduction)
  IF EXISTS (SELECT 1 FROM public.credits_log WHERE visit_id = p_visit_id AND credit_type IN ('conversation', 'premium_ai')) THEN
    RETURN jsonb_build_object('success', true, 'already_deducted', true);
  END IF;

  -- Subscription plans (Business+Opus, Starter/Pro Premium AI taste): use per-feature budget
  IF v_org.subscription_plan IN ('starter', 'professional', 'business', 'enterprise') THEN
    DECLARE
      v_budget_result jsonb;
    BEGIN
      v_budget_result := private.check_and_deduct_feature_budget(
        p_org_id, 'premium_ai', v_amount,
        'AI conversation credit deduction', p_visit_id
      );
      IF NOT (v_budget_result->>'success')::boolean THEN
        RETURN jsonb_build_object('success', false, 'error', COALESCE(v_budget_result->>'error', 'no_credits'));
      END IF;

      -- Update visit with credit info
      UPDATE public.visits
      SET credits_charged = v_amount, ai_model_used = p_ai_model
      WHERE id = p_visit_id;

      RETURN jsonb_build_object('success', true, 'credits_deducted', v_amount, 'source', v_budget_result->>'source');
    END;
  END IF;

  -- PAyG / Trials: existing credits_total/credits_used system
  v_remaining := v_org.credits_total - v_org.credits_used;

  IF v_remaining >= v_amount THEN
    v_from_regular := v_amount;
  ELSIF v_org.recharge_limit IS NOT NULL THEN
    v_from_regular := GREATEST(v_remaining, 0);
    v_from_recharge := v_amount - v_from_regular;
    v_recharge_remaining := v_org.recharge_limit - v_org.recharge_used;

    IF v_from_recharge > v_recharge_remaining THEN
      RETURN jsonb_build_object('success', false, 'error', 'no_credits');
    END IF;
  ELSE
    RETURN jsonb_build_object('success', false, 'error', 'no_credits');
  END IF;

  -- Log the deduction with UNIQUE constraint as final guard
  INSERT INTO public.credits_log (org_id, visit_id, credits_amount, ai_model, description)
  VALUES (p_org_id, p_visit_id, -v_amount, p_ai_model, 'AI conversation credit deduction')
  ON CONFLICT (visit_id, credit_type) WHERE visit_id IS NOT NULL DO NOTHING;

  GET DIAGNOSTICS v_rows_inserted = ROW_COUNT;
  IF v_rows_inserted = 0 THEN
    RETURN jsonb_build_object('success', true, 'already_deducted', true);
  END IF;

  UPDATE public.organizations
  SET credits_used = credits_used + v_from_regular,
      recharge_used = recharge_used + v_from_recharge
  WHERE id = p_org_id;

  -- Update visit with credit info
  UPDATE public.visits
  SET credits_charged = v_amount,
      ai_model_used = p_ai_model
  WHERE id = p_visit_id;

  -- Check if credits are running low (>= 80% used) and alert owner
  DECLARE
    v_updated_used numeric;
    v_credits_total numeric;
    v_recharge_used_now numeric;
    v_recharge_limit_now int;
    v_effective_total numeric;
    v_effective_used numeric;
    v_usage_pct numeric;
    v_owner_email text;
    v_org_name text;
    v_last_alert timestamptz;
    v_billing_start timestamptz;
    v_unsub_token text;
    v_edge_url text;
  BEGIN
    SELECT credits_used, credits_total, recharge_used, recharge_limit,
           name, last_credit_alert_at, billing_cycle_start
    INTO v_updated_used, v_credits_total, v_recharge_used_now, v_recharge_limit_now,
         v_org_name, v_last_alert, v_billing_start
    FROM public.organizations WHERE id = p_org_id;

    -- Use effective capacity (regular + recharge) for alert calculation
    -- This ensures PAyG orgs (credits_total=0) still get alerts
    v_effective_total := v_credits_total + COALESCE(v_recharge_limit_now, 0);
    v_effective_used := v_updated_used + v_recharge_used_now;
    v_usage_pct := v_effective_used / NULLIF(v_effective_total, 0);

    IF v_usage_pct >= 0.80 THEN
      -- Onboarding first_credit_low email: one-time-ever conversion pitch for trial/PAYG orgs.
      -- Helper uses onboarding_email_log PK so duplicate calls are silently no-ops.
      BEGIN
        IF v_org.subscription_plan IN ('standard_trial', 'premium_trial', 'pay_as_you_go') THEN
          PERFORM private.send_onboarding_email(p_org_id, 'first_credit_low');
        END IF;
      EXCEPTION WHEN OTHERS THEN
        RAISE NOTICE 'first_credit_low email failed for org %: %', p_org_id, SQLERRM;
      END;

      -- Only alert once per billing cycle
      IF v_last_alert IS NULL OR v_last_alert < COALESCE(v_billing_start, now() - interval '30 days') THEN
        SELECT email INTO v_owner_email
        FROM auth.users
        WHERE id = (SELECT owner_id FROM public.organizations WHERE id = p_org_id);

        IF v_owner_email IS NOT NULL THEN
          v_unsub_token := private.generate_unsubscribe_token(v_owner_email, 'credit_alerts');
          SELECT decrypted_secret INTO v_edge_url
          FROM vault.decrypted_secrets WHERE name = 'edge_function_url';

          INSERT INTO public.pending_emails (to_email, subject, html_body, priority, metadata)
          VALUES (
            v_owner_email,
            'Credits Running Low, ' || v_org_name,
            '<h2>Credits Alert</h2><p>Your organization <strong>' || replace(replace(v_org_name, '&', '&amp;'), '<', '&lt;') ||
              '</strong> has used ' || round(v_usage_pct * 100) || '% of its available credits this cycle.</p>' ||
              '<p>Please review your usage in the billing dashboard to ensure uninterrupted AI pre-screening.</p>' ||
              CASE WHEN v_unsub_token IS NOT NULL AND v_edge_url IS NOT NULL
                THEN '<p style="color:#94a3b8;font-size:12px;margin-top:24px;"><a href="' || v_edge_url || '/unsubscribe?pref=' || v_unsub_token || '" style="color:#94a3b8;">Unsubscribe from credit alerts</a></p>'
                ELSE ''
              END,
            2,
            jsonb_build_object('type', 'credit_alert', 'pref_key', 'credit_alerts', 'org_id', p_org_id)
          );
        END IF;

        UPDATE public.organizations
        SET last_credit_alert_at = now()
        WHERE id = p_org_id;
      END IF;
    END IF;
  EXCEPTION WHEN undefined_column THEN
    NULL;
  END;

  RETURN jsonb_build_object('success', true, 'credits_deducted', v_amount,
    'recharge_charged', v_from_recharge);
END;
$$;

-- Public wrapper (service-role only)
CREATE OR REPLACE FUNCTION public.deduct_credits(
  p_org_id uuid,
  p_visit_id uuid,
  p_ai_model text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  IF auth.role() <> 'service_role' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  RETURN private.deduct_credits(auth.role(), p_org_id, p_visit_id, p_ai_model);
END;
$$;
