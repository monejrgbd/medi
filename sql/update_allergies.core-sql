-- Private implementation
CREATE OR REPLACE FUNCTION private.update_allergies(
  p_caller_role text,
  p_patient_id uuid,
  p_allergies text[]
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  -- Mark removed items inactive
  UPDATE public.patient_allergies
  SET active = false, updated_at = now()
  WHERE patient_id = p_patient_id AND active = true
    AND name NOT IN (SELECT unnest(p_allergies));

  -- Upsert new/existing
  INSERT INTO public.patient_allergies (patient_id, name, active, updated_at)
  SELECT p_patient_id, unnest(p_allergies), true, now()
  ON CONFLICT (patient_id, name) DO UPDATE
    SET active = true, updated_at = now();

  RETURN jsonb_build_object('success', true);
END;
$$;

-- Public wrapper (service-role only)
CREATE OR REPLACE FUNCTION public.update_allergies(
  p_patient_id uuid,
  p_allergies text[]
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
BEGIN
  IF auth.role() <> 'service_role' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  RETURN private.update_allergies(auth.role(), p_patient_id, p_allergies);
END;
$$;
