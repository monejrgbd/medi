-- Private implementation
CREATE OR REPLACE FUNCTION private.get_receptionist_counts(
  p_caller_auth_uid uuid,
  p_location_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org_id uuid;
  v_owner_id uuid;
  v_caller_staff_id uuid;
  v_is_receptionist boolean := false;
  v_awaiting bigint;
  v_with_ai bigint;
  v_in_queue bigint;
  v_with_doctor bigint;
  v_tablets_out bigint;
  v_doctors_checked_in bigint;
BEGIN
  -- Get location org
  SELECT l.org_id INTO v_org_id
  FROM public.locations l
  WHERE l.id = p_location_id;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Location not found');
  END IF;

  -- Get caller staff id
  SELECT su.id INTO v_caller_staff_id
  FROM public.staff_users su
  WHERE su.auth_uid = p_caller_auth_uid
    AND su.is_active = true
    AND su.is_deleted = false;

  -- Authorization: owner or receptionist at this location
  SELECT owner_id INTO v_owner_id FROM public.organizations WHERE id = v_org_id;

  IF v_owner_id = p_caller_auth_uid THEN
    NULL;
  ELSE
    SELECT EXISTS(
      SELECT 1 FROM public.staff_roles sr
      WHERE sr.staff_user_id = v_caller_staff_id
        AND sr.role = 'receptionist'
        AND sr.location_id = p_location_id
    ) INTO v_is_receptionist;

    IF NOT v_is_receptionist THEN
      RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
    END IF;
  END IF;

  -- Single query with count(*) FILTER for all visit counts
  SELECT
    count(*) FILTER (WHERE status = 'pending_approval'),
    count(*) FILTER (WHERE status = 'still_answering_ai'),
    count(*) FILTER (WHERE status = 'waiting_doctor_claim'),
    count(*) FILTER (WHERE status = 'claimed_by_doctor'),
    count(*) FILTER (WHERE gave_tablet = true AND status NOT IN ('completed', 'left'))
  INTO v_awaiting, v_with_ai, v_in_queue, v_with_doctor, v_tablets_out
  FROM public.visits
  WHERE location_id = p_location_id
    AND status NOT IN ('completed', 'left');

  -- Doctors checked in (separate table)
  SELECT count(*) INTO v_doctors_checked_in
  FROM public.staff_checkins sc
  WHERE sc.location_id = p_location_id
    AND sc.role = 'doctor'
    AND sc.checked_out_at IS NULL;

  RETURN jsonb_build_object(
    'success', true,
    'awaiting', v_awaiting,
    'with_ai', v_with_ai,
    'in_queue', v_in_queue,
    'with_doctor', v_with_doctor,
    'tablets_out', v_tablets_out,
    'doctors_checked_in', v_doctors_checked_in
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.get_receptionist_counts(
  p_location_id uuid
)
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_auth_uid uuid := auth.uid();
BEGIN
  RETURN private.get_receptionist_counts(v_auth_uid, p_location_id);
END;
$$;
