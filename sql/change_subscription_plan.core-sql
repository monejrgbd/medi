-- Private implementation
CREATE OR REPLACE FUNCTION private.change_subscription_plan(
  p_caller_auth_uid uuid,
  p_new_plan text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_org record;
  v_allocation int;
BEGIN
  -- Validate plan
  IF p_new_plan NOT IN ('starter', 'professional', 'business', 'pay_as_you_go') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid plan');
  END IF;

  -- Lock org and verify ownership
  SELECT id, subscription_plan, credits_total
  INTO v_org
  FROM public.organizations
  WHERE owner_id = p_caller_auth_uid
  FOR UPDATE;

  IF v_org IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authorized');
  END IF;

  -- Guard: blocked plans cannot change
  IF v_org.subscription_plan IN ('expired', 'suspended', 'read_only') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Cannot change plan while account is ' || v_org.subscription_plan || '. Please reactivate first.');
  END IF;

  -- Map plan to credit allocation
  CASE p_new_plan
    WHEN 'starter' THEN v_allocation := 0;
    WHEN 'professional' THEN v_allocation := 0;
    WHEN 'business' THEN v_allocation := 0;
    WHEN 'pay_as_you_go' THEN v_allocation := 0;
  END CASE;

  -- On upgrade: keep credits_used, increase total. On downgrade: cap and keep used.
  -- Prevents credit gaming via plan cycling.
  UPDATE public.organizations
  SET subscription_plan = p_new_plan,
      credits_total = v_allocation,
      recharge_used = 0
  WHERE id = v_org.id;

  -- Keep location ai_model consistent with plan branding.
  -- Business/Enterprise use 'precision' as included tier label, other plans use 'standard'.
  IF p_new_plan = 'business' THEN
    UPDATE public.locations
    SET ai_model = 'precision'
    WHERE org_id = v_org.id AND ai_model = 'standard';
  ELSIF v_org.subscription_plan = 'business' AND p_new_plan <> 'business' THEN
    UPDATE public.locations
    SET ai_model = 'standard'
    WHERE org_id = v_org.id AND ai_model = 'precision';
  END IF;

  -- If switching TO PAyG with existing recharge_limit, start a fresh cycle
  IF p_new_plan = 'pay_as_you_go' THEN
    UPDATE public.organizations
    SET billing_cycle_start = CASE
      WHEN recharge_limit IS NOT NULL THEN now()
      ELSE NULL
    END
    WHERE id = v_org.id;
  END IF;

  INSERT INTO public.audit_trail (org_id, actor_id, actor_type, action, entity_type, entity_id, details)
  VALUES (v_org.id, p_caller_auth_uid, 'owner', 'plan_changed', 'organization', v_org.id,
    jsonb_build_object('old_plan', v_org.subscription_plan, 'new_plan', p_new_plan, 'credits', v_allocation));

  RETURN jsonb_build_object(
    'success', true,
    'old_plan', v_org.subscription_plan,
    'new_plan', p_new_plan,
    'credits_total', v_allocation
  );
END;
$$;

-- Public wrapper
CREATE OR REPLACE FUNCTION public.change_subscription_plan(
  p_new_plan text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid uuid;
BEGIN
  v_uid := auth.uid();
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;

  RETURN private.change_subscription_plan(v_uid, p_new_plan);
END;
$$;

REVOKE EXECUTE ON FUNCTION public.change_subscription_plan(text) FROM anon;
REVOKE EXECUTE ON FUNCTION public.change_subscription_plan(text) FROM authenticated;
