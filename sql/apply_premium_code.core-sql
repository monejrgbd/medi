-- Applies a premium code to an existing org, upgrading standard_trial to premium_trial
CREATE OR REPLACE FUNCTION public.apply_premium_code(
  p_code text
)
RETURNS jsonb
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
SET search_path TO ''
AS $$
DECLARE
  v_uid uuid;
  v_org_id uuid;
  v_plan text;
  v_code_id uuid;
BEGIN
  v_uid := auth.uid();
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Not authenticated');
  END IF;

  -- Get caller's org
  SELECT id, subscription_plan INTO v_org_id, v_plan
  FROM public.organizations
  WHERE owner_id = v_uid
  FOR UPDATE;

  IF v_org_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Organization not found');
  END IF;

  -- Only allow on standard_trial
  IF v_plan <> 'standard_trial' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Premium code can only be applied during trial');
  END IF;

  -- Validate code
  SELECT id INTO v_code_id
  FROM public.approval_codes
  WHERE code = p_code
    AND used_by_org_id IS NULL
    AND (expires_at IS NULL OR expires_at > now());

  IF v_code_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Invalid or already used code');
  END IF;

  -- Upgrade to premium_trial
  UPDATE public.organizations
  SET subscription_plan = 'premium_trial',
      credits_total = 200
  WHERE id = v_org_id;

  -- Mark code as used
  UPDATE public.approval_codes
  SET used_by_org_id = v_org_id, used_at = now()
  WHERE id = v_code_id;

  RETURN jsonb_build_object('success', true, 'credits', 200);
END;
$$;

GRANT EXECUTE ON FUNCTION public.apply_premium_code(text) TO authenticated;
